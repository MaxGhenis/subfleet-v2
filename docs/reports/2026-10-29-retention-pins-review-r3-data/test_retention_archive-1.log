        before = snapshot(wt)
        links_before = inode_groups(wt)
        jobdir_before = snapshot(w.root / "jobs" / "job-rt")
        admin_before = snapshot(w.admin("job-rt"))
        result = run(w)
        assert result["pruned"] == ["job-rt"], result
        assert not wt.exists() and not (w.root / "jobs" / "job-rt").exists()
