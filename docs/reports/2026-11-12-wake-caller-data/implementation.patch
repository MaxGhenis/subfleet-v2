+def notice_decide(state: TurnState, *, limits: dict[str, float],
+                  active_at: float = 0, source: str | None = None,
+                  retired: dict | None = None, last_nudge: dict | None = None,
+                  wake_streak: int = 0, last_wake_at: float | None = None,
