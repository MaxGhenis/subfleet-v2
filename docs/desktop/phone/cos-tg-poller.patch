+def run_subfleet(*args):
+    """The existing owner-chat check authenticates this local CLI bridge."""
+    try:
+        r = subprocess.run([os.environ.get("SUBFLEET_BIN", "subfleet"), "phone", *args],
+                           capture_output=True, text=True, timeout=30)
+        return r.returncode, (r.stdout + r.stderr).strip()
+    except subprocess.TimeoutExpired:
+        return 69, "timed out; check the conversation before retrying"
+    except OSError as e:
+        return 69, str(e)
+
+
 def reply(text):
     return load_say().send_text(text, silent=True)
 
