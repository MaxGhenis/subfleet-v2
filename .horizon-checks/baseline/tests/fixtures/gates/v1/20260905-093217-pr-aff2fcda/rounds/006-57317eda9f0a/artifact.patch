@@ -0,0 +1,360 @@
+import { execFileSync, spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { load } from "js-yaml";
+import { beforeAll, describe, expect, it, vi } from "vitest";
+import { comparisonFailure, comparisonFailureStage, upsertComparisonFailure } from "../scripts/report-pe-comparison-failure.js";
+
+const runUrl = "https://github.com/TheAxiomFoundation/axiom-api/actions/runs/123";
+const context = { compared: "success", archived: "success", failedStep: "setup", runUrl };
+
+describe("PE comparison monitoring", () => {
+  it("distinguishes actual drift, incomplete measurements, archives and later reports", () => {
+    expect(comparisonFailure({ ...context, compared: "failure", report: { rows: [{ drift: "diff" }] } }))
+      .toMatchObject({ category: "drift", explanation: expect.stringContaining("1 pinned") });
+    for (const report of [undefined, null, {}, { rows: [] }, { rows: [null] }, { rows: "bad" }]) {
+      expect(comparisonFailure({ ...context, compared: "failure", report }).category)
+        .toBe("comparison-error");
+    }
+    expect(comparisonFailure({ ...context, archived: "failure" }).category).toBe("archive");
+    expect(comparisonFailure({ ...context, archivePrepared: "failure", archived: "skipped" }).category)
+      .toBe("archive");
+    expect(comparisonFailure(context).category).toBe("downstream");
+    expect(comparisonFailure({ ...context, compared: "skipped" }).category).toBe("setup");
+  });
+
+  it("identifies actual failed setup steps without treating skipped steps as failures", () => {
+    for (const [key, expected] of [
+      ["CHECKOUT", "checking out the repository"],
+      ["NODE_SETUP", "setting up Node.js"],
+      ["DEPENDENCIES", "installing dependencies"],
+      ["CONFIGURATION", "checking comparison configuration"],
+      ["COMPAT_KEY", "issuing the ephemeral compat key"],
+      ["ARCHIVE_PREPARED", "preparing the bundled snapshot"]
+    ]) {
+      const stage = comparisonFailureStage({ COMPAT_KEY: "skipped", COMPARED: "skipped", [key!]: "failure" });
+      expect(stage).toBe(expected);
+      const notice = comparisonFailure({ ...context, compared: "skipped", failedStep: stage });
+      expect(notice.explanation).toContain(`Failure stage: ${expected}`);
+    }
+    expect(comparisonFailureStage({ COMPAT_KEY: "skipped", COMPARED: "skipped" }))
+      .toBe("checkout or dependency installation");
+  });
+
+  it("creates one marked issue, then updates it across pages without losing investigation notes", () => {
+    const notice = comparisonFailure({ ...context, archived: "failure" });
+    const createGh = vi.fn().mockReturnValueOnce("[[]]").mockReturnValueOnce('{"number":42}');
+    expect(upsertComparisonFailure(notice, "owner/repo", createGh)).toBe(42);
+    const created = JSON.parse(createGh.mock.calls[1]![1] as string) as { body: string; labels: string[] };
+    expect(created.labels).toEqual(["monitoring"]);
+    expect(created.body).toContain("axiom-pe-comparison-monitor:v1:archive");
+
+    const oldBody = `Investigation notes\n${created.body}\nKeep this conclusion`;
+    const updateGh = vi.fn().mockReturnValueOnce(JSON.stringify([
+      [{ number: 9, body: created.body, pull_request: {} }, { number: 10, body: "unrelated" }],
+      [{ number: 42, body: oldBody }]
+    ])).mockReturnValueOnce("{}");
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", updateGh)).toBe(42);
+    expect(updateGh.mock.calls[0]![0]).toContain("--paginate");
+    expect(updateGh.mock.calls[1]![0]).toContain("PATCH");
+    const updated = JSON.parse(updateGh.mock.calls[1]![1] as string).body as string;
+    expect(updated).toBe(`Investigation notes\n${created.body.replace(runUrl, `${runUrl}4`)}\nKeep this conclusion`);
+
+    const retryGh = vi.fn().mockReturnValue(JSON.stringify([[{ number: 42, body: updated }]]));
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", retryGh)).toBe(42);
+    expect(retryGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps drift and archive failures in separate issues and refuses damaged owned sections", () => {
+    const archive = comparisonFailure({ ...context, archived: "failure" });
+    const otherCategory = "<!-- axiom-pe-comparison-monitor:v1:drift -->\nInvestigating";
+    const separateGh = vi.fn().mockReturnValueOnce(JSON.stringify([[{ number: 1, body: otherCategory }]]))
+      .mockReturnValueOnce('{"number":2}');
+    expect(upsertComparisonFailure(archive, "owner/repo", separateGh)).toBe(2);
+    expect(separateGh.mock.calls[1]![0]).toContain("POST");
+    const damagedGh = vi.fn().mockReturnValue(JSON.stringify([[{
+      number: 3, body: "<!-- axiom-pe-comparison-monitor:v1:archive -->\nInvestigation notes"
+    }]]));
+    expect(() => upsertComparisonFailure(archive, "owner/repo", damagedGh)).toThrow("incomplete owned section");
+    expect(damagedGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("allows the intended archive write only after a successful main comparison and serializes updates", () => {
+    const workflow = load(readFileSync(".github/workflows/pe-household-comparison.yml", "utf8")) as {
+      concurrency: { group: string; "cancel-in-progress": boolean };
+      jobs: { compare: { permissions: Record<string, string>; steps: Array<{
+        id?: string; name?: string; if?: string; run?: string; shell?: string; env?: Record<string, string>;
+        uses?: string; with?: Record<string, unknown>;
+      }> } };
+    };
+    expect(workflow.concurrency).toEqual({ group: "pe-household-comparison", "cancel-in-progress": false });
+    expect(workflow.jobs.compare.permissions).toMatchObject({ contents: "write", issues: "write" });
+    const steps = workflow.jobs.compare.steps;
+    const prepare = steps.find((step) => step.id === "archive_prepare")!;
+    expect(prepare.if).toBe("steps.compare.outcome == 'success' && github.ref == 'refs/heads/main'");
+    expect(prepare.run).toContain("npx tsx scripts/bundle-validation-run.ts");
+    expect(prepare.env).toBeUndefined();
+    const archive = workflow.jobs.compare.steps.find((step) => step.id === "archive")!;
+    expect(archive.if).toBe("steps.archive_prepare.outcome == 'success' && github.ref == 'refs/heads/main'");
+    expect(archive.run).toContain("git commit --only data/validation-runs/latest.json");
+    expect(archive.run).not.toMatch(/\b(npm|npx|node)\b/);
+    expect(archive.run).not.toContain("x-access-token:${GH_PUSH_TOKEN}@");
+    expect(archive.run).toContain('pull --rebase "https://github.com/${GITHUB_REPOSITORY}.git" main');
+    expect(archive.run).toContain('push "https://github.com/${GITHUB_REPOSITORY}.git" HEAD:main');
+    expect(archive.env).toMatchObject({ GH_PUSH_TOKEN: "${{ github.token }}", GIT_TERMINAL_PROMPT: "0" });
+    for (const step of steps) {
+      if (step.uses) expect(step.uses).toMatch(/@[0-9a-f]{40}$/);
+      if (step.uses?.startsWith("actions/checkout@")) expect(step.with?.["persist-credentials"]).toBe(false);
+      if (step.run?.match(/\b(npm|npx)\b/)) {
+        expect(JSON.stringify(step.env ?? {})).not.toContain("github.token");
+      }
+    }
+    const alarm = workflow.jobs.compare.steps.find((step) => step.name === "Report drift failure")!;
+    expect(alarm.if).toBe("failure()");
+    expect(alarm.shell).toBe("bash");
+    expect(alarm.env?.ARCHIVED).toBe("${{ steps.archive.outcome }}");
+    expect(alarm.env?.ARCHIVE_PREPARED).toBe("${{ steps.archive_prepare.outcome }}");
+    expect(alarm.env?.DEPENDENCIES).toBe("${{ steps.dependencies.outcome }}");
+    expect(alarm.env?.COMPAT_KEY).toBe("${{ steps.compatkey.outcome }}");
+    expect(alarm.run).toContain("node scripts/report-pe-comparison-failure.ts 2>&1)");
+    expect(alarm.run).toContain('category="comparison-error"');
+  });
+});
+
+
+type FallbackState = {
+  issues: Array<{ number: number; body: string; title?: string }>;
+  comments: Array<{ body: string; issue: number }>;
+  writes: string[];
+};
+
+function requireJq(path = process.env.PATH): void {
+  const result = spawnSync("jq", ["--version"], { env: { PATH: path }, encoding: "utf8" });
+  if (result.error || result.status !== 0) {
+    throw new Error("PE comparison shell tests require jq on PATH. Install it with 'brew install jq' on macOS or 'sudo apt-get install jq' on Ubuntu, then rerun npm test.");
+  }
+}
+
+it("explains the jq test dependency when it is unavailable", () => {
+  const directory = mkdtempSync(join(tmpdir(), "pe-monitor-no-jq-"));
+  try {
+    expect(() => requireJq(directory)).toThrow("brew install jq");
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+// Execute the workflow's real shell in an empty checkout, with a broken Node
+// command and a stateful fake GitHub CLI. Neither credentials nor network are used.
+function fallbackHarness(issues: FallbackState["issues"], checkedOut = false, runReporter = false) {
+  const directory = mkdtempSync(join(tmpdir(), "pe-monitor-fallback-"));
+  const bin = join(directory, "bin");
+  const statePath = join(directory, "state.json");
+  const nodeAttempt = join(directory, "node-attempt");
+  mkdirSync(bin);
+  writeFileSync(statePath, JSON.stringify({ issues, comments: [], writes: [] }));
+  const nodeCommand = runReporter
+    ? 'exec "$TEST_NODE_EXECUTABLE" --experimental-strip-types "$@"'
+    : 'printf "%s\\n" "$TEST_REPORTER_OUTPUT" >&2; exit 1';
+  writeFileSync(join(bin, "node"), `#!/bin/bash\nprintf attempted > "$NODE_ATTEMPT"\n${nodeCommand}\n`, { mode: 0o755 });
+  // An absolute shebang keeps this test double independent of the broken node
+  // command under test; the fallback itself can only use bash, jq and gh.
+  writeFileSync(join(bin, "gh"), `#!${process.execPath}
+const fs = require("node:fs");
+const state = JSON.parse(fs.readFileSync(process.env.TEST_MONITOR_STATE, "utf8"));
+const args = process.argv.slice(2);
+const endpoint = args.find(arg => arg.startsWith("repos/"));
+if (process.env.TEST_GH_READ_FAILURE && !args.includes("POST") && !args.includes("PATCH")) process.exit(1);
+let result;
+if (args.includes("POST") || args.includes("PATCH")) {
+  const payload = JSON.parse(fs.readFileSync(0, "utf8"));
+  if (args.includes("PATCH")) {
+    const index = state.issues.findIndex(issue => issue.number === Number(endpoint.split("/")[4]));
+    if (index < 0) throw new Error("Unknown issue: " + endpoint);
+    state.issues[index] = { ...state.issues[index], ...payload };
+    state.writes.push("patch");
+    result = state.issues[index];
+  } else if (endpoint.endsWith("/comments")) {
+    state.comments.push({ ...payload, issue: Number(endpoint.split("/")[4]) });
+    state.writes.push("comment");
+    result = payload;
+  } else if (endpoint.endsWith("/issues")) {
+    result = { number: 213, ...payload };
+    state.issues.push(result);
+    state.writes.push("issue");
+  } else throw new Error("Unexpected write: " + endpoint);
+  fs.writeFileSync(process.env.TEST_MONITOR_STATE, JSON.stringify(state));
+} else if (endpoint.includes("/comments?")) result = [[], state.comments.filter(comment => comment.issue === Number(endpoint.split("/")[4]))];
+else if (endpoint.includes("/issues?")) result = [[], state.issues];
+else throw new Error("Unexpected read: " + endpoint);
+process.stdout.write(JSON.stringify(result));
+`, { mode: 0o755 });
+  if (checkedOut) {
+    mkdirSync(join(directory, "scripts"));
+    writeFileSync(join(directory, "scripts/report-pe-comparison-failure.ts"), readFileSync("scripts/report-pe-comparison-failure.ts", "utf8"));
+  }
+  const workflow = load(readFileSync(".github/workflows/pe-household-comparison.yml", "utf8")) as {
+    jobs: { compare: { steps: Array<{ name: string; run: string }> } };
+  };
+  const shell = workflow.jobs.compare.steps.find(step => step.name === "Report drift failure")!.run;
+  return {
+    run(outcomes: Record<string, string>) {
+      execFileSync("/bin/bash", ["-eo", "pipefail", "-c", shell], {
+        cwd: directory,
+        env: {
+          PATH: `${bin}:${process.env.PATH}`,
+          TEST_MONITOR_STATE: statePath,
+          NODE_ATTEMPT: nodeAttempt,
+          TEST_NODE_EXECUTABLE: process.execPath,
+          GH_TOKEN: "inert-test-token",
+          GH_REPO: "TheAxiomFoundation/axiom-api",
+          RUN_URL: runUrl,
+          CHECKOUT: "success", NODE_SETUP: "success", DEPENDENCIES: "success",
+          CONFIGURATION: "success", COMPAT_KEY: "success", COMPARED: "skipped",
+          ARCHIVE_PREPARED: "skipped", ARCHIVED: "skipped", ...outcomes
+        },
+        stdio: "pipe"
+      });
+      return JSON.parse(readFileSync(statePath, "utf8")) as FallbackState;
+    },
+    writeReport: (contents: string) => writeFileSync(join(directory, "pe-comparison-report.json"), contents),
+    state: () => JSON.parse(readFileSync(statePath, "utf8")) as FallbackState,
+    nodeAttempted: () => existsSync(nodeAttempt),
+    dispose: () => rmSync(directory, { recursive: true, force: true })
+  };
+}
+
+describe("PE comparison shell fallback", () => {
+  beforeAll(() => requireJq());
+  const marker = "<!-- axiom-pe-comparison-monitor:v1:comparison-error -->";
+  // Intentionally incomplete generated section: a reporter error must not erase
+  // existing investigation notes or prevent the last-resort alert.
+  const body = `Preserve the original run links\n${marker}\nUnfinished investigation`;
+
+  it.each([
+    [false, { CHECKOUT: "failure", NODE_SETUP: "skipped", COMPAT_KEY: "skipped" }, "checking out the repository"],
+    [true, { NODE_SETUP: "failure", COMPAT_KEY: "skipped" }, "setting up Node.js"]
+  ] as const)("reports setup failure with checkedOut=%s and preserves canonical notes", (checkedOut, outcomes, stage) => {
+    const fallback = fallbackHarness([{ number: 213, body }], checkedOut);
+    try {
+      const state = fallback.run(outcomes);
+      expect(state.issues).toEqual([{ number: 213, body }]);
+      expect(state.writes).toEqual(["comment"]);
+      expect(state.comments[0]!.body).toContain(`failure at: ${stage}`);
+      expect(state.comments[0]!.body).toContain("Comparison step outcome: skipped");
+      expect(state.comments[0]!.body).toContain(runUrl);
+      expect(fallback.nodeAttempted()).toBe(checkedOut);
+      expect(fallback.run(outcomes)).toEqual(state);
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("catches primary reporter errors without denying a successful comparison", () => {
+    const fallback = fallbackHarness([{ number: 213, body }], true);
+    try {
+      const state = fallback.run({ COMPARED: "success", ARCHIVE_PREPARED: "success", ARCHIVED: "success", TEST_REPORTER_OUTPUT: "Sensitive upstream response: fixture-private-context" });
+      expect(state.issues[0]!.body).toBe(body);
+      expect(state.comments[0]!.body).toContain("failure at: the primary failure reporter");
+      expect(state.comments[0]!.body).toContain("Comparison step outcome: success");
+      expect(state.comments[0]!.body).toContain("Reporter failure alone does not establish calculation drift");
+      expect(state.comments[0]!.body).not.toContain("did not run");
+      expect(state.comments[0]!.body).not.toContain("fixture-private-context");
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("exits after a successful primary update without adding a fallback alert", () => {
+    const start = "<!-- axiom-pe-comparison-monitor:v1:drift -->";
+    const end = "<!-- /axiom-pe-comparison-monitor -->";
+    const driftBody = `Investigation notes\n${start}\nOld generated report\n${end}\nKeep this conclusion`;
+    const fallback = fallbackHarness([{ number: 42, body: driftBody }], true, true);
+    try {
+      fallback.writeReport(JSON.stringify({ rows: [{ drift: "diff" }, { drift: "diff" }] }));
+      const state = fallback.run({ COMPARED: "failure" });
+      expect(state.writes).toEqual(["patch"]);
+      expect(state.comments).toEqual([]);
+      expect(state.issues).toHaveLength(1);
+      expect(state.issues[0]!.number).toBe(42);
+      expect(state.issues[0]!.body).toContain(`Investigation notes\n${start}\n`);
+      expect(state.issues[0]!.body).toContain(`${end}\nKeep this conclusion`);
+      expect(state.issues[0]!.body).toContain("2 pinned expectation(s) did not hold");
+      expect(state.issues[0]!.body).toContain(runUrl);
+      expect(state.issues[0]!.body).not.toContain("Old generated report");
+      expect(state.issues[0]!.body).not.toContain("axiom-pe-comparison-fallback");
+      expect(fallback.run({ COMPARED: "failure" })).toEqual(state);
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("preserves measured drift and the damaged issue diagnosis without moving the alert", () => {
+    const driftBody = "Existing investigation\n<!-- axiom-pe-comparison-monitor:v1:drift -->\nKeep these notes";
+    const fallback = fallbackHarness([{ number: 213, body }, { number: 42, body: driftBody }], true, true);
+    try {
+      fallback.writeReport(JSON.stringify({ rows: [{ drift: "diff" }, { drift: "same" }, { drift: "diff" }] }));
+      const state = fallback.run({ COMPARED: "failure" });
+      expect(state.issues).toEqual([{ number: 213, body }, { number: 42, body: driftBody }]);
+      expect(state.writes).toEqual(["comment"]);
+      expect(state.comments[0]!.issue).toBe(42);
+      expect(state.comments[0]!.body).toContain("monitor issue #42 because its owned section is incomplete");
+      expect(state.comments[0]!.body).toContain("2 drifted pinned expectation(s)");
+      expect(fallback.run({ COMPARED: "failure" })).toEqual(state);
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("gives a new drift fallback a matching title and stable category marker", () => {
+    const fallback = fallbackHarness([]);
+    try {
+      fallback.writeReport(JSON.stringify({ rows: [{ drift: "diff" }] }));
+      const state = fallback.run({ COMPARED: "failure" });
+      expect(state.issues[0]!.title).toBe("PE household comparison: pinned Axiom outputs drifted");
+      expect(state.issues[0]!.body).toContain("<!-- axiom-pe-comparison-monitor:v1:drift -->");
+      expect(state.issues[0]!.body).toContain("1 drifted pinned expectation(s)");
+      expect(fallback.run({ COMPARED: "failure" })).toEqual(state);
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it.each(["not-json", '{"rows": "invalid"}', '{"rows": [{"drift":"diff"}]}\n{}'])("does not infer drift from malformed report %s", (report) => {
+    const fallback = fallbackHarness([{ number: 213, body }], true);
+    try {
+      fallback.writeReport(report);
+      const state = fallback.run({ COMPARED: "failure" });
+      expect(state.writes).toEqual(["comment"]);
+      expect(state.comments[0]!.issue).toBe(213);
+      expect(state.comments[0]!.body).toContain("Drift-row count unavailable");
+      expect(state.comments[0]!.body).not.toContain("drifted pinned expectation(s)");
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("does not create a duplicate issue when the canonical issue lookup fails", () => {
+    const fallback = fallbackHarness([{ number: 213, body }]);
+    try {
+      expect(() => fallback.run({ CHECKOUT: "failure", TEST_GH_READ_FAILURE: "1" })).toThrow();
+      expect(fallback.state().writes).toEqual([]);
+    } finally {
+      fallback.dispose();
+    }
+  });
+
+  it("creates one canonical comparison issue when absent and reuses it on retries", () => {
+    const fallback = fallbackHarness([]);
+    try {
+      const state = fallback.run({ CHECKOUT: "failure" });
+      expect(state.writes).toEqual(["issue"]);
+      expect(state.issues[0]!.body).toContain(marker);
+      expect(state.issues[0]!.body).toContain("<!-- /axiom-pe-comparison-monitor -->");
+      expect(fallback.run({ CHECKOUT: "failure" })).toEqual(state);
+    } finally {
+      fallback.dispose();
+    }
+  });
+});
