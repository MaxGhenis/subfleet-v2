@@ -0,0 +1,118 @@
+import { readFileSync } from "node:fs";
+import { load } from "js-yaml";
+import { describe, expect, it, vi } from "vitest";
+import { comparisonFailure, comparisonFailureStage, upsertComparisonFailure } from "../scripts/report-pe-comparison-failure.js";
+
+const runUrl = "https://github.com/TheAxiomFoundation/axiom-api/actions/runs/123";
+const context = { compared: "success", archived: "success", failedStep: "setup", runUrl };
+
+describe("PE comparison monitoring", () => {
+  it("distinguishes actual drift, incomplete measurements, archives and later reports", () => {
+    expect(comparisonFailure({ ...context, compared: "failure", report: { rows: [{ drift: "diff" }] } }))
+      .toMatchObject({ category: "drift", explanation: expect.stringContaining("1 pinned") });
+    for (const report of [undefined, null, {}, { rows: [] }, { rows: [null] }, { rows: "bad" }]) {
+      expect(comparisonFailure({ ...context, compared: "failure", report }).category)
+        .toBe("comparison-error");
+    }
+    expect(comparisonFailure({ ...context, archived: "failure" }).category).toBe("archive");
+    expect(comparisonFailure({ ...context, archivePrepared: "failure", archived: "skipped" }).category)
+      .toBe("archive");
+    expect(comparisonFailure(context).category).toBe("downstream");
+    expect(comparisonFailure({ ...context, compared: "skipped" }).category).toBe("setup");
+  });
+
+  it("identifies actual failed setup steps without treating skipped steps as failures", () => {
+    for (const [key, expected] of [
+      ["CHECKOUT", "checking out the repository"],
+      ["NODE_SETUP", "setting up Node.js"],
+      ["DEPENDENCIES", "installing dependencies"],
+      ["CONFIGURATION", "checking comparison configuration"],
+      ["COMPAT_KEY", "issuing the ephemeral compat key"],
+      ["ARCHIVE_PREPARED", "preparing the bundled snapshot"]
+    ]) {
+      const stage = comparisonFailureStage({ COMPAT_KEY: "skipped", COMPARED: "skipped", [key!]: "failure" });
+      expect(stage).toBe(expected);
+      const notice = comparisonFailure({ ...context, compared: "skipped", failedStep: stage });
+      expect(notice.explanation).toContain(`Failure stage: ${expected}`);
+    }
+    expect(comparisonFailureStage({ COMPAT_KEY: "skipped", COMPARED: "skipped" }))
+      .toBe("checkout or dependency installation");
+  });
+
+  it("creates one marked issue, then updates it across pages without losing investigation notes", () => {
+    const notice = comparisonFailure({ ...context, archived: "failure" });
+    const createGh = vi.fn().mockReturnValueOnce("[[]]").mockReturnValueOnce('{"number":42}');
+    expect(upsertComparisonFailure(notice, "owner/repo", createGh)).toBe(42);
+    const created = JSON.parse(createGh.mock.calls[1]![1] as string) as { body: string; labels: string[] };
+    expect(created.labels).toEqual(["monitoring"]);
+    expect(created.body).toContain("axiom-pe-comparison-monitor:v1:archive");
+
+    const oldBody = `Investigation notes\n${created.body}\nKeep this conclusion`;
+    const updateGh = vi.fn().mockReturnValueOnce(JSON.stringify([
+      [{ number: 9, body: created.body, pull_request: {} }, { number: 10, body: "unrelated" }],
+      [{ number: 42, body: oldBody }]
+    ])).mockReturnValueOnce("{}");
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", updateGh)).toBe(42);
+    expect(updateGh.mock.calls[0]![0]).toContain("--paginate");
+    expect(updateGh.mock.calls[1]![0]).toContain("PATCH");
+    const updated = JSON.parse(updateGh.mock.calls[1]![1] as string).body as string;
+    expect(updated).toBe(`Investigation notes\n${created.body.replace(runUrl, `${runUrl}4`)}\nKeep this conclusion`);
+
+    const retryGh = vi.fn().mockReturnValue(JSON.stringify([[{ number: 42, body: updated }]]));
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", retryGh)).toBe(42);
+    expect(retryGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps drift and archive failures in separate issues and refuses damaged owned sections", () => {
+    const archive = comparisonFailure({ ...context, archived: "failure" });
+    const otherCategory = "<!-- axiom-pe-comparison-monitor:v1:drift -->\nInvestigating";
+    const separateGh = vi.fn().mockReturnValueOnce(JSON.stringify([[{ number: 1, body: otherCategory }]]))
+      .mockReturnValueOnce('{"number":2}');
+    expect(upsertComparisonFailure(archive, "owner/repo", separateGh)).toBe(2);
+    expect(separateGh.mock.calls[1]![0]).toContain("POST");
+    const damagedGh = vi.fn().mockReturnValue(JSON.stringify([[{
+      number: 3, body: "<!-- axiom-pe-comparison-monitor:v1:archive -->\nInvestigation notes"
+    }]]));
+    expect(() => upsertComparisonFailure(archive, "owner/repo", damagedGh)).toThrow("incomplete owned section");
+    expect(damagedGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("allows the intended archive write only after a successful main comparison and serializes updates", () => {
+    const workflow = load(readFileSync(".github/workflows/pe-household-comparison.yml", "utf8")) as {
+      concurrency: { group: string; "cancel-in-progress": boolean };
+      jobs: { compare: { permissions: Record<string, string>; steps: Array<{
+        id?: string; name?: string; if?: string; run?: string; env?: Record<string, string>;
+        uses?: string; with?: Record<string, unknown>;
+      }> } };
+    };
+    expect(workflow.concurrency).toEqual({ group: "pe-household-comparison", "cancel-in-progress": false });
+    expect(workflow.jobs.compare.permissions).toMatchObject({ contents: "write", issues: "write" });
+    const steps = workflow.jobs.compare.steps;
+    const prepare = steps.find((step) => step.id === "archive_prepare")!;
+    expect(prepare.if).toBe("steps.compare.outcome == 'success' && github.ref == 'refs/heads/main'");
+    expect(prepare.run).toContain("npx tsx scripts/bundle-validation-run.ts");
+    expect(prepare.env).toBeUndefined();
+    const archive = workflow.jobs.compare.steps.find((step) => step.id === "archive")!;
+    expect(archive.if).toBe("steps.archive_prepare.outcome == 'success' && github.ref == 'refs/heads/main'");
+    expect(archive.run).toContain("git commit --only data/validation-runs/latest.json");
+    expect(archive.run).not.toMatch(/\b(npm|npx|node)\b/);
+    expect(archive.run).not.toContain("x-access-token:${GH_PUSH_TOKEN}@");
+    expect(archive.run).toContain('pull --rebase "https://github.com/${GITHUB_REPOSITORY}.git" main');
+    expect(archive.run).toContain('push "https://github.com/${GITHUB_REPOSITORY}.git" HEAD:main');
+    expect(archive.env).toMatchObject({ GH_PUSH_TOKEN: "${{ github.token }}", GIT_TERMINAL_PROMPT: "0" });
+    for (const step of steps) {
+      if (step.uses) expect(step.uses).toMatch(/@[0-9a-f]{40}$/);
+      if (step.uses?.startsWith("actions/checkout@")) expect(step.with?.["persist-credentials"]).toBe(false);
+      if (step.run?.match(/\b(npm|npx)\b/)) {
+        expect(JSON.stringify(step.env ?? {})).not.toContain("github.token");
+      }
+    }
+    const alarm = workflow.jobs.compare.steps.find((step) => step.name === "Report drift failure")!;
+    expect(alarm.if).toBe("failure()");
+    expect(alarm.env?.ARCHIVED).toBe("${{ steps.archive.outcome }}");
+    expect(alarm.env?.ARCHIVE_PREPARED).toBe("${{ steps.archive_prepare.outcome }}");
+    expect(alarm.env?.DEPENDENCIES).toBe("${{ steps.dependencies.outcome }}");
+    expect(alarm.env?.COMPAT_KEY).toBe("${{ steps.compatkey.outcome }}");
+    expect(alarm.run).toBe("node scripts/report-pe-comparison-failure.ts");
+  });
+});
