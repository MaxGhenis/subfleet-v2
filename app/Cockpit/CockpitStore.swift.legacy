// Recovered from the legacy Subfleet cockpit (native Swift, built 2026-08-30/31).
// Source: chief-of-staff feat/subfleet-traycer-port @ 8607b3c8 plus uncommitted working tree,
// subfleet/app/CockpitStore.swift, sha256 4a2609a88f8e2d38f626cbd8629b03383e22ae8c6cc5ae3c73041f8a1bf0bd66 (recovery package 20260924T121841Z).
// Imported verbatim; not compiled until ported to the v2 daemon (docs/desktop/design.md §12).

import Foundation

typealias JSONObject = [String: Any]

private enum CockpitDataError: LocalizedError {
    case invalidJSON(String)
    case missingField(String)

    var errorDescription: String? {
        switch self {
        case let .invalidJSON(message): return "Subfleet returned invalid JSON: \(message)"
        case let .missingField(field): return "Subfleet JSON did not contain \(field)."
        }
    }
}

private extension Dictionary where Key == String, Value == Any {
    func string(_ keys: String...) -> String? {
        for key in keys {
            if let value = self[key] as? String { return value }
            if let value = self[key] as? NSNumber { return value.stringValue }
        }
        return nil
    }

    func int(_ keys: String...) -> Int? {
        for key in keys {
            if let value = self[key] as? NSNumber { return value.intValue }
            if let value = self[key] as? String, let parsed = Int(value) { return parsed }
        }
        return nil
    }

    func double(_ keys: String...) -> Double? {
        for key in keys {
            if let value = self[key] as? NSNumber { return value.doubleValue }
            if let value = self[key] as? String, let parsed = Double(value) { return parsed }
        }
        return nil
    }

    func bool(_ keys: String...) -> Bool? {
        for key in keys {
            if let value = self[key] as? Bool { return value }
            if let value = self[key] as? NSNumber { return value.boolValue }
            if let value = self[key] as? String {
                if ["true", "yes", "1"].contains(value.lowercased()) { return true }
                if ["false", "no", "0"].contains(value.lowercased()) { return false }
            }
        }
        return nil
    }

    func object(_ keys: String...) -> JSONObject? {
        for key in keys {
            if let value = self[key] as? JSONObject { return value }
        }
        return nil
    }

    func array(_ keys: String...) -> [Any]? {
        for key in keys {
            if let value = self[key] as? [Any] { return value }
        }
        return nil
    }
}

private func parseJSON(_ text: String) throws -> Any {
    guard let data = text.data(using: .utf8), !data.isEmpty else {
        throw CockpitDataError.invalidJSON("empty standard output")
    }
    do {
        return try JSONSerialization.jsonObject(with: data)
    } catch {
        throw CockpitDataError.invalidJSON(error.localizedDescription)
    }
}

private func prettyJSON(_ value: Any) -> String {
    guard JSONSerialization.isValidJSONObject(value),
          let data = try? JSONSerialization.data(withJSONObject: value, options: [.prettyPrinted, .sortedKeys])
    else { return String(describing: value) }
    return String(decoding: data, as: UTF8.self)
}

private func envelopeObject(_ value: Any) -> JSONObject? {
    guard let root = value as? JSONObject else { return nil }
    return root.object("data", "result") ?? root
}

struct CapacityFamily: Identifiable, Hashable {
    let id: String
    let available: Bool
    let dispatchable: Int
    let accounts: Int
    let headroom: Double?
    let best: String?
    let confidence: String?

    var name: String { id.capitalized }

    static func decodeList(_ text: String) throws -> [CapacityFamily] {
        let value = try parseJSON(text)
        guard let root = envelopeObject(value) else {
            throw CockpitDataError.missingField("a capacity object")
        }
        let families = root.object("families") ?? root.object("capacity")?.object("families")
        if let families {
            let preferred = ["codex", "claude"]
            return families.compactMap { key, value -> CapacityFamily? in
                guard let object = value as? JSONObject else { return nil }
                return CapacityFamily(
                    id: key,
                    available: object.bool("available") ?? ((object.int("dispatchable") ?? 0) > 0),
                    dispatchable: object.int("dispatchable", "available_accounts") ?? 0,
                    accounts: object.int("accounts", "total") ?? 0,
                    headroom: object.double("headroom_score", "headroom"),
                    best: object.string("best_email", "best", "best_id"),
                    confidence: object.string("confidence")
                )
            }.sorted {
                (preferred.firstIndex(of: $0.id) ?? 99) < (preferred.firstIndex(of: $1.id) ?? 99)
            }
        }

        guard let accounts = root.array("accounts") else {
            throw CockpitDataError.missingField("families or accounts")
        }
        let grouped = Dictionary(grouping: accounts.compactMap { $0 as? JSONObject }) {
            $0.string("family") ?? "unknown"
        }
        return grouped.map { family, rows in
            let dispatchable = rows.filter { $0.bool("dispatchable") == true }
            return CapacityFamily(
                id: family,
                available: !dispatchable.isEmpty,
                dispatchable: dispatchable.count,
                accounts: rows.count,
                headroom: dispatchable.compactMap { $0.double("headroom_score") }.max(),
                best: dispatchable.max {
                    ($0.double("dispatch_score") ?? -.infinity) < ($1.double("dispatch_score") ?? -.infinity)
                }?.string("email", "id"),
                confidence: nil
            )
        }.sorted { $0.id < $1.id }
    }
}

struct CapacityUsageWindow: Hashable {
    let usedPercent: Double?
    let resetAt: String?
    let confidence: String?
    let tokens: Double?
    let capacity: Double?

    var hasEvidence: Bool {
        usedPercent != nil || resetAt != nil || tokens != nil || capacity != nil
    }

    fileprivate static func decode(_ object: JSONObject?) -> CapacityUsageWindow {
        CapacityUsageWindow(
            usedPercent: object?.double("used_percent", "percent"),
            resetAt: object?.string("reset_at", "resets_at"),
            confidence: object?.string("confidence", "source"),
            tokens: object?.double("tokens", "used_tokens"),
            capacity: object?.double("capacity", "token_capacity")
        )
    }
}

struct CapacityScopedLimit: Hashable {
    let kind: String?
    let group: String?
    let percent: Double?
    let severity: String?
    let resetAt: String?
    let isActive: Bool
    let scopeModel: String?
    let scopeSurface: String?

    fileprivate static func decodeList(_ values: [Any]?) -> [CapacityScopedLimit] {
        (values ?? []).compactMap { value in
            guard let object = value as? JSONObject else { return nil }
            return CapacityScopedLimit(
                kind: object.string("kind"),
                group: object.string("group"),
                percent: object.double("percent", "used_percent"),
                severity: object.string("severity"),
                resetAt: object.string("resets_at", "reset_at"),
                isActive: object.bool("is_active", "active") ?? false,
                scopeModel: object.string("scope_model", "model"),
                scopeSurface: object.string("scope_surface", "surface")
            )
        }
    }
}

struct CapacityAccount: Identifiable, Hashable {
    let id: String
    let family: String
    let accountKey: String
    let email: String
    let home: String?
    let status: String
    let dispatchable: Bool
    let headroom: Double?
    let fiveHour: CapacityUsageWindow
    let weekly: CapacityUsageWindow
    let modelWindows: [String: CapacityUsageWindow]
    let scopedLimits: [CapacityScopedLimit]
    let limitedUntil: String?
    let shortWindowUntil: String?
    let confidence: String?
    let probeStatus: String?
    let active: Bool?
    let enrolled: Bool?
    let isPrimaryHome: Bool
    let isShadowedByApp: Bool
    let inFlight: Int

    var name: String { email.isEmpty ? accountKey : email }

    static func decodeList(_ text: String) throws -> [CapacityAccount] {
        let value = try parseJSON(text)
        guard let root = envelopeObject(value) else {
            throw CockpitDataError.missingField("a capacity object")
        }
        let values = root.array("accounts") ?? root.object("capacity")?.array("accounts") ?? []
        return values.compactMap { value in
            guard let object = value as? JSONObject else { return nil }
            let family = object.string("family") ?? "unknown"
            guard let key = object.string("id", "account_id", "email", "home") else { return nil }
            let modelWindows = (object.object("model_windows") ?? [:]).reduce(
                into: [String: CapacityUsageWindow]()
            ) { result, entry in
                guard let window = entry.value as? JSONObject else { return }
                result[entry.key] = .decode(window)
            }
            return CapacityAccount(
                id: "\(family):\(key)",
                family: family,
                accountKey: key,
                email: object.string("email") ?? key,
                home: object.string("home"),
                status: object.string("status", "base_status") ?? "unknown",
                dispatchable: object.bool("dispatchable") ?? false,
                headroom: object.double("headroom_score", "headroom"),
                fiveHour: .decode(object.object("five_hour", "primary")),
                weekly: .decode(object.object("weekly", "seven_day", "secondary")),
                modelWindows: modelWindows,
                scopedLimits: CapacityScopedLimit.decodeList(
                    object.array("scoped_limits", "limits")
                ),
                limitedUntil: object.string("limited_until"),
                shortWindowUntil: object.string("short_window_until"),
                confidence: object.string("confidence"),
                probeStatus: object.string("probe_status"),
                active: object.bool("active"),
                enrolled: object.bool("enrolled"),
                isPrimaryHome: object.bool("is_primary_home") ?? false,
                isShadowedByApp: object.bool("is_shadowed_by_app", "shadowed_by_app") ?? false,
                inFlight: object.int("in_flight") ?? 0
            )
        }
    }
}

private struct CapacityFreshness {
    let ageSeconds: Double?
    let ttlSeconds: Double?
    let fresh: Bool?
    let generatedAt: String?
    let probedAt: String?
    let cacheHit: Bool?

    static func decode(_ text: String) throws -> CapacityFreshness {
        let value = try parseJSON(text)
        guard let root = envelopeObject(value) else {
            throw CockpitDataError.missingField("a capacity object")
        }
        let cache = root.object("cache")
        let age = cache?.double("age_seconds", "age")
        let ttl = cache?.double("ttl_seconds", "ttl")
        return CapacityFreshness(
            ageSeconds: age,
            ttlSeconds: ttl,
            fresh: cache?.bool("fresh") ?? {
                guard let age, let ttl else { return nil }
                return age <= ttl
            }(),
            generatedAt: root.string("generated_at", "as_of"),
            probedAt: cache?.string("probed_at", "checked_at"),
            cacheHit: cache?.bool("hit", "cache_hit")
        )
    }
}

struct RouteSelection: Hashable {
    let family: String
    let model: String
    let alias: String?
    let lane: String
}

struct RoutePreview: Hashable {
    let ok: Bool
    let allowed: Bool
    let reason: String
    let selection: RouteSelection?
    let errorMessage: String?
    let fallbackCount: Int
    let rejectedCount: Int
    let cacheAge: Double?
    let rawJSON: String

    static func decode(_ text: String) throws -> RoutePreview {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject else {
            throw CockpitDataError.missingField("a route-preview object")
        }
        guard root.int("schema_version") == 1,
              root.string("kind") == "subfleet.route-preview"
        else {
            throw CockpitDataError.invalidJSON("unsupported route-preview schema")
        }
        guard let ok = root.bool("ok"), let allowed = root.bool("allowed") else {
            throw CockpitDataError.invalidJSON("route preview is missing ok or allowed")
        }
        let selected: RouteSelection?
        if let object = root.object("selected") {
            guard let family = object.string("family"), !family.isEmpty,
                  let model = object.string("model"), !model.isEmpty,
                  let lane = object.string("lane"), !lane.isEmpty
            else {
                throw CockpitDataError.invalidJSON("route preview has an incomplete selection")
            }
            selected = RouteSelection(
                family: family,
                model: model,
                alias: object.string("model_alias", "alias"),
                lane: lane
            )
        } else {
            selected = nil
        }
        guard !allowed || (ok && selected != nil),
              allowed || selected == nil
        else {
            throw CockpitDataError.invalidJSON("route preview has inconsistent routing fields")
        }
        let error = root.object("error")?.string("message", "detail")
        return RoutePreview(
            ok: ok,
            allowed: allowed,
            reason: root.string("reason", "message") ?? error ?? "No routing reason was returned.",
            selection: selected,
            errorMessage: error,
            fallbackCount: root.array("fallbacks")?.count ?? 0,
            rejectedCount: root.array("rejected")?.count ?? 0,
            cacheAge: root.object("capacity_freshness", "cache")?.double("age_seconds", "age"),
            rawJSON: prettyJSON(value)
        )
    }
}

struct RunRecord: Identifiable, Hashable, Sendable {
    let id: String
    let family: String
    let model: String
    let lane: String?
    let status: String
    let resultCode: Int?
    let startedAt: String?
    let finishedAt: String?
    let duration: Double?
    let workdir: String?
    let outputPath: String?
    let outputBytes: Int?
    let pid: Int?

    var isRunning: Bool {
        ["RUNNING", "QUEUED", "STARTING", "DISPATCHING"].contains(status.uppercased())
    }

    var isOrphaned: Bool { status.uppercased() == "ORPHANED" }

    var completedSuccessfully: Bool {
        status.uppercased() == "FINISHED" && resultCode == 0
    }

    static func decode(_ object: JSONObject) -> RunRecord? {
        guard let id = object.string("id", "run_id") else { return nil }
        return RunRecord(
            id: id,
            family: object.string("family", "provider") ?? "unknown",
            model: object.string("model", "model_id") ?? "unknown",
            lane: object.string("lane", "account", "home"),
            status: object.string("status", "state") ?? "UNKNOWN",
            resultCode: object.int("rc", "result_code", "exit_code"),
            startedAt: object.string("started_at", "created_at"),
            finishedAt: object.string("finished_at", "completed_at"),
            duration: object.double("duration_s", "duration"),
            workdir: object.string("workdir", "cwd"),
            outputPath: object.string("out_path", "output_path"),
            outputBytes: object.int("out_bytes", "output_bytes"),
            pid: object.int("pid")
        )
    }

    static func decodeList(_ text: String) throws -> [RunRecord] {
        let value = try parseJSON(text)
        let values: [Any]
        if let array = value as? [Any] {
            values = array
        } else if let root = value as? JSONObject,
                  let array = root.array("runs", "items", "data", "results")
        {
            values = array
        } else {
            throw CockpitDataError.missingField("a runs array")
        }
        return values.compactMap { ($0 as? JSONObject).flatMap(RunRecord.decode) }
    }
}

struct RunDetail: Hashable, Sendable {
    let run: RunRecord
    let prompt: String?
    let output: String?
    let errorOutput: String?
    let laneLog: String?
    let truncatedArtifacts: Set<String>
    let artifactPaths: [String: String]
    let rawJSON: String

    static func decode(_ text: String, fallback: RunRecord) throws -> RunDetail {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject else {
            throw CockpitDataError.missingField("a run-detail object")
        }
        guard root.int("schema_version") == 1,
              root.string("kind") == "subfleet.run-detail"
        else {
            throw CockpitDataError.invalidJSON("unsupported run-detail schema")
        }
        if root.bool("ok") == false {
            let message = root.object("error")?.string("message", "detail")
                ?? root.string("message")
                ?? "run detail was unavailable"
            throw CockpitDataError.invalidJSON(message)
        }
        guard root.bool("ok") == true else {
            throw CockpitDataError.invalidJSON("run detail is missing an affirmative ok field")
        }
        guard root.string("id") == fallback.id else {
            throw CockpitDataError.invalidJSON("run detail does not match the selected run")
        }
        let body = root.object("data", "result") ?? root
        guard let runObject = body.object("metadata"),
              let run = RunRecord.decode(runObject),
              run.id == fallback.id
        else {
            throw CockpitDataError.invalidJSON("run detail has invalid metadata")
        }
        let content = body.object("content", "saved")
        guard let artifacts = body.object("artifacts") else {
            throw CockpitDataError.invalidJSON("run detail is missing artifact descriptors")
        }
        let artifactKeys = ["prompt", "output", "error", "lane_log"]
        for key in artifactKeys {
            guard let descriptor = artifacts.object(key),
                  let path = descriptor.string("path"), !path.isEmpty,
                  descriptor.bool("exists") != nil,
                  descriptor.int("bytes") != nil,
                  descriptor.int("content_bytes") != nil,
                  descriptor.bool("truncated") != nil,
                  descriptor["content"] is String || descriptor["content"] is NSNull
            else {
                throw CockpitDataError.invalidJSON("run detail has an invalid \(key) artifact")
            }
        }
        let artifactPaths: [String: String] = Dictionary(
            uniqueKeysWithValues: artifactKeys.compactMap { key -> (String, String)? in
                guard let path = artifacts.object(key)?.string("path"), !path.isEmpty else {
                    return nil
                }
                return (key, path)
            }
        )

        // The receipt tab carries metadata and descriptors, not another copy
        // of every potentially large artifact body.
        var receipt = root
        if var receiptArtifacts = receipt["artifacts"] as? JSONObject {
            for key in artifactKeys {
                guard var descriptor = receiptArtifacts[key] as? JSONObject else { continue }
                descriptor.removeValue(forKey: "content")
                receiptArtifacts[key] = descriptor
            }
            receipt["artifacts"] = receiptArtifacts
        }
        return RunDetail(
            run: run,
            prompt: artifacts.object("prompt")?.string("content")
                ?? body.string("prompt", "input")
                ?? content?.string("prompt", "input"),
            output: artifacts.object("output")?.string("content")
                ?? body.string("output", "stdout", "out")
                ?? content?.string("output", "stdout", "out"),
            errorOutput: artifacts.object("error")?.string("content")
                ?? body.string("stderr", "error_output", "err")
                ?? content?.string("stderr", "error_output", "err"),
            laneLog: artifacts.object("lane_log")?.string("content"),
            truncatedArtifacts: Set(
                artifactKeys.filter {
                    artifacts.object($0)?.bool("truncated") == true
                }
            ),
            artifactPaths: artifactPaths,
            rawJSON: prettyJSON(receipt)
        )
    }
}

private struct RouteFingerprint: Hashable {
    let task: String
    let tier: String
    let workdir: String
}

private struct KillReceipt {
    let ok: Bool
    let message: String

    static func decode(_ text: String, expectedRunID: String) throws -> KillReceipt {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject,
              root.int("schema_version") == 1,
              root.string("kind") == "subfleet.kill-results",
              let ok = root.bool("ok"),
              let errorCount = root.int("error_count"),
              let values = root.array("results"),
              values.count == 1,
              let row = values.first as? JSONObject,
              row.string("run_id") == expectedRunID,
              let rowOK = row.bool("ok"),
              let status = row.string("status")
        else {
            throw CockpitDataError.invalidJSON("unsupported or incomplete kill-results schema")
        }
        guard ok == rowOK, errorCount == (ok ? 0 : 1) else {
            throw CockpitDataError.invalidJSON("kill-results fields are inconsistent")
        }
        let error = row.object("error")?.string("message", "detail")
        if !ok && error == nil {
            throw CockpitDataError.invalidJSON("failed kill result is missing an error message")
        }
        return KillReceipt(
            ok: ok,
            message: error ?? "Run \(expectedRunID) \(status)."
        )
    }
}

struct SessionRecord: Identifiable, Hashable, Sendable {
    let id: String
    let provider: String
    let nativeID: String
    let displayName: String
    let displayNameSource: String
    let cwd: String?
    let profileHomeRef: String
    let profileHomePath: String?
    let account: String?
    let createdAtMilliseconds: Double?
    let updatedAtMilliseconds: Double?
    let archived: Bool
    let starred: Bool
    let live: Bool
    let connected: Bool
    let resumeCapable: Bool
    let continuationBlocker: String?
    let pid: Int?
    let model: String?
    let reasoningEffort: String?
    let permissionMode: String?
    let sandboxMode: String?
    let sourceKind: String?

    var accountLabel: String {
        if provider == "codex" {
            return account.map { "Current app account · \($0)" } ?? "Current app profile · \(profileHomeRef)"
        }
        if live || connected {
            return account ?? "current live Claude app account"
        }
        return account ?? "best available subscription"
    }

    var stateLabel: String {
        if connected { return "LIVE" }
        if live { return "OPEN" }
        if resumeCapable { return "SAVED" }
        return "UNAVAILABLE"
    }

    static func decode(_ object: JSONObject) -> SessionRecord? {
        guard let id = object.string("id"), !id.isEmpty,
              let provider = object.string("provider"), ["claude", "codex"].contains(provider),
              let nativeID = object.string("native_id"), !nativeID.isEmpty,
              let displayName = object.string("display_name"), !displayName.isEmpty,
              let profile = object.object("profile"),
              let homeRef = profile.string("home_ref"), !homeRef.isEmpty
        else { return nil }
        return SessionRecord(
            id: id,
            provider: provider,
            nativeID: nativeID,
            displayName: displayName,
            displayNameSource: object.string("display_name_source") ?? "unknown",
            cwd: object.string("cwd"),
            profileHomeRef: homeRef,
            profileHomePath: profile.string("home_path"),
            account: profile.string("account"),
            createdAtMilliseconds: object.double("created_at_ms"),
            updatedAtMilliseconds: object.double("updated_at_ms"),
            archived: object.bool("archived") ?? false,
            starred: object.bool("starred") ?? false,
            live: object.bool("live") ?? false,
            connected: object.bool("connected") ?? false,
            resumeCapable: object.bool("resume_capable") ?? false,
            continuationBlocker: object.string("continuation_blocker"),
            pid: object.int("pid"),
            model: object.string("model"),
            reasoningEffort: object.string("reasoning_effort"),
            permissionMode: object.string("permission_mode"),
            sandboxMode: object.string("sandbox_mode"),
            sourceKind: object.string("source_kind")
        )
    }

    static func decodeList(_ text: String) throws -> [SessionRecord] {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject,
              root.int("schema_version") == 1,
              root.string("kind") == "subfleet.sessions"
        else {
            throw CockpitDataError.invalidJSON("unsupported sessions schema")
        }
        if root.bool("ok") == false {
            throw CockpitDataError.invalidJSON(
                root.object("error")?.string("message") ?? "session catalog was unavailable"
            )
        }
        guard root.bool("ok") == true, let values = root.array("items") else {
            throw CockpitDataError.missingField("an affirmative sessions envelope with items")
        }
        let decoded = values.compactMap { ($0 as? JSONObject).flatMap(SessionRecord.decode) }
        guard decoded.count == values.count else {
            throw CockpitDataError.invalidJSON("one or more session rows were incomplete")
        }
        return decoded
    }
}

struct SessionMessage: Identifiable, Hashable, Sendable {
    let id: String
    let role: String
    let text: String
    let phase: String?
    let createdAt: String?
}

struct SessionDetail: Hashable, Sendable {
    let session: SessionRecord
    let messages: [SessionMessage]
    let truncated: Bool
    let contentPolicy: String
    let omittedEventCount: Int

    static func decode(_ text: String, expectedID: String) throws -> SessionDetail {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject,
              root.int("schema_version") == 1,
              root.string("kind") == "subfleet.session-detail"
        else {
            throw CockpitDataError.invalidJSON("unsupported session-detail schema")
        }
        if root.bool("ok") == false {
            throw CockpitDataError.invalidJSON(
                root.object("error")?.string("message") ?? "session transcript was unavailable"
            )
        }
        guard root.bool("ok") == true,
              let sessionObject = root.object("session"),
              let session = SessionRecord.decode(sessionObject),
              session.id == expectedID,
              let values = root.array("messages")
        else {
            throw CockpitDataError.invalidJSON("session detail is incomplete or mismatched")
        }
        var messages: [SessionMessage] = []
        for (index, value) in values.enumerated() {
            guard let object = value as? JSONObject,
                  let role = object.string("role"), ["user", "assistant"].contains(role),
                  let body = object.string("text"), !body.isEmpty
            else {
                throw CockpitDataError.invalidJSON("session detail contains an invalid message")
            }
            messages.append(SessionMessage(
                id: "\(index)-\(object.string("id") ?? role)",
                role: role,
                text: body,
                phase: object.string("phase"),
                createdAt: object.string("created_at")
            ))
        }
        return SessionDetail(
            session: session,
            messages: messages,
            truncated: root.bool("truncated") ?? false,
            contentPolicy: root.string("content_policy") ?? "visible-user-assistant-text",
            omittedEventCount: root.int("omitted_event_count") ?? 0
        )
    }
}

struct SessionActivityEvent: Hashable, Sendable, Identifiable {
    var id: Int { sequence }
    let sequence: Int
    let kind: String
    let label: String
    let occurredAt: String?

    static func decode(_ object: JSONObject) -> SessionActivityEvent? {
        guard let sequence = object.int("sequence"),
              let kind = object.string("kind"), !kind.isEmpty,
              let label = object.string("label"), !label.isEmpty
        else { return nil }
        return SessionActivityEvent(
            sequence: sequence,
            kind: kind,
            label: label,
            occurredAt: object.string("occurred_at")
        )
    }
}

struct SessionActivity: Hashable, Sendable {
    let revision: Int
    let current: SessionActivityEvent
    let events: [SessionActivityEvent]

    static func decode(_ object: JSONObject?) -> SessionActivity? {
        guard let object,
              object.int("schema_version") == 1,
              let revision = object.int("revision"),
              let currentObject = object.object("current"),
              let current = SessionActivityEvent.decode(currentObject)
        else { return nil }
        let events = (object.array("events") ?? []).compactMap {
            ($0 as? JSONObject).flatMap(SessionActivityEvent.decode)
        }
        return SessionActivity(revision: revision, current: current, events: events)
    }
}

struct SessionContinuationReceipt: Hashable, Sendable, Identifiable {
    var id: String { messageID }
    let messageID: String
    let sessionID: String
    let provider: String
    let status: String
    let runID: String?
    let message: String
    let prompt: String
    let createdAt: String?
    let updatedAt: String?
    let attachmentCount: Int
    let errorCode: String?
    let nativeMessageID: String?
    let resolution: String?
    let activity: SessionActivity?

    var isActive: Bool {
        ["queued", "starting", "dispatched", "delivered-live", "failover-dispatched", "running"].contains(status)
    }

    var statusLabel: String {
        if resolution == "handled" { return "Marked handled" }
        switch status {
        case "queued": return "Queued locally"
        case "starting": return "Starting provider"
        case "dispatched", "failover-dispatched", "running": return "Running"
        case "delivered-live": return "Delivered to live session"
        case "finished": return "Finished"
        case "cancelled": return "Cancelled"
        case "delivery-unknown": return "Delivery unconfirmed"
        default: return "Needs attention"
        }
    }

    static func decode(_ text: String, expectedID: String) throws -> SessionContinuationReceipt {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject,
              root.int("schema_version") == 1,
              root.string("kind") == "subfleet.session-continuation"
        else {
            throw CockpitDataError.invalidJSON("unsupported session-continuation schema")
        }
        return try decode(root, expectedID: expectedID)
    }

    static func decode(_ root: JSONObject, expectedID: String? = nil) throws -> SessionContinuationReceipt {
        guard root.int("schema_version") == 1,
              root.string("kind") == "subfleet.session-continuation" else {
            throw CockpitDataError.invalidJSON("unsupported session-continuation schema")
        }
        if root.bool("accepted") != true {
            throw CockpitDataError.invalidJSON(
                root.object("error")?.string("message") ?? root.string("message", "error") ?? "continuation was rejected"
            )
        }
        guard let sessionID = root.string("session_id"),
              expectedID == nil || sessionID == expectedID,
              let messageID = root.string("message_id"),
              let provider = root.string("provider"),
              let status = root.string("status")
        else {
            throw CockpitDataError.invalidJSON("continuation receipt is incomplete or mismatched")
        }
        return SessionContinuationReceipt(
            messageID: messageID,
            sessionID: sessionID,
            provider: provider,
            status: status,
            runID: root.string("run_id"),
            message: root.object("error")?.string("message") ?? root.string("message", "error") ?? status,
            prompt: root.string("prompt") ?? "",
            createdAt: root.string("created_at"),
            updatedAt: root.string("updated_at"),
            attachmentCount: root.int("attachment_count") ?? root.array("image_paths")?.count ?? 0,
            errorCode: root.object("error")?.string("code") ?? root.string("code"),
            nativeMessageID: root.string("native_message_id"),
            resolution: root.string("resolution"),
            activity: SessionActivity.decode(root.object("activity"))
        )
    }

    static func decodeList(_ text: String) throws -> [SessionContinuationReceipt] {
        guard let root = try parseJSON(text) as? JSONObject,
              root.int("schema_version") == 1,
              root.string("kind") == "subfleet.outbox",
              root.bool("ok") == true,
              let values = root.array("messages")
        else { throw CockpitDataError.invalidJSON("unsupported outbox schema") }
        return try values.map {
            guard let object = $0 as? JSONObject else {
                throw CockpitDataError.invalidJSON("invalid outbox message")
            }
            return try decode(object)
        }
    }
}

private struct PendingBrokerSubmission: Codable, Sendable {
    let request: BrokerRequest
    let sourceImagePaths: [String]
}

struct DispatchReceipt: Hashable {
    let ok: Bool
    let runID: String?
    let status: String?
    let message: String
    let rawJSON: String

    static func decode(_ text: String) throws -> DispatchReceipt {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject else {
            throw CockpitDataError.missingField("a dispatch receipt")
        }
        guard root.int("schema_version") == 1,
              root.string("kind") == "subfleet.run",
              let ok = root.bool("ok"),
              let status = root.string("status")
        else {
            throw CockpitDataError.invalidJSON("unsupported or incomplete dispatch schema")
        }
        let body = root
        let run = body.object("run", "receipt")
        let error = body.object("error")?.string("message", "detail")
        let id = body.string("run_id", "id") ?? run?.string("run_id", "id")
        if ok && status != "dispatched" {
            throw CockpitDataError.invalidJSON(
                "successful dispatch has unexpected status \(status)"
            )
        }
        if ok && (body.bool("detached") != true || id?.isEmpty != false) {
            throw CockpitDataError.invalidJSON(
                "successful dispatch is missing a detached durable run_id"
            )
        }
        if !ok && error == nil {
            throw CockpitDataError.invalidJSON("failed dispatch is missing an error message")
        }
        let message = error
            ?? body.string("message")
            ?? (id.map { "Dispatched \($0)" })
            ?? body.string("reason")
            ?? "Dispatch accepted."
        return DispatchReceipt(
            ok: ok,
            runID: id,
            status: status,
            message: message,
            rawJSON: prettyJSON(value)
        )
    }
}

enum CodexServiceTierOverride: String, CaseIterable, Identifiable, Sendable {
    case inherit
    case fast
    case standard

    var id: Self { self }

    var displayName: String {
        switch self {
        case .inherit: return "Inherit"
        case .fast: return "Fast"
        case .standard: return "Standard"
        }
    }

    var routeLabel: String {
        switch self {
        case .inherit: return "Lane default"
        case .fast: return "Fast override · 2.5× credits"
        case .standard: return "Standard override"
        }
    }

    var cliArgument: String? {
        self == .inherit ? nil : "--\(rawValue)"
    }
}

struct HistoryTask: Identifiable, Hashable {
    let id: String
    let providers: [String]
    let runCount: Int
    let attemptCount: Int
    let handoffCount: Int
    let firstAt: String?
    let lastAt: String?
    let outcome: String?
    let exitCode: Int?

    static func decodeList(_ text: String) throws -> [HistoryTask] {
        let value = try parseJSON(text)
        guard let root = value as? JSONObject,
              let values = root.array("tasks", "items", "data")
        else {
            throw CockpitDataError.missingField("a Logpile tasks array")
        }
        return values.compactMap { value in
            guard let object = value as? JSONObject,
                  let id = object.string("task_id", "id")
            else { return nil }
            return HistoryTask(
                id: id,
                providers: object.array("providers")?.compactMap { $0 as? String } ?? [],
                runCount: object.int("run_count", "runs") ?? 0,
                attemptCount: object.int("attempt_count", "attempts") ?? 0,
                handoffCount: object.int("handoff_count", "handoffs") ?? 0,
                firstAt: object.string("first_occurred_at", "created_at"),
                lastAt: object.string("last_occurred_at", "updated_at"),
                outcome: object.string("last_outcome_status", "outcome", "status"),
                exitCode: object.int("last_outcome_exit_code", "exit_code")
            )
        }
    }
}

@MainActor
final class CockpitStore: ObservableObject {
    static let shared = CockpitStore()

    @Published var capacity: [CapacityFamily] = []
    @Published var capacityAccounts: [CapacityAccount] = []
    @Published var runs: [RunRecord] = []
    @Published var sessions: [SessionRecord] = []
    @Published var historyTasks: [HistoryTask] = []
    @Published var selectedRunID: String?
    @Published var runDetail: RunDetail?
    @Published var selectedSessionID: String?
    @Published var sessionDetail: SessionDetail?
    @Published var sessionOutbox: [String: [SessionContinuationReceipt]] = [:]
    @Published var sendingSessionIDs: Set<String> = []
    @Published var uncertainSessionIDs: Set<String> = []
    @Published var routePreview: RoutePreview?
    @Published var dispatchReceipt: DispatchReceipt?
    @Published var issues: [String: String] = [:]
    @Published var loadingCapacity = false
    @Published var loadingRuns = false
    @Published var loadingSessions = false
    @Published var loadingSessionDetail = false
    @Published var loadingHistory = false
    @Published var loadingRoute = false
    @Published var dispatching = false
    @Published var killingRun = false
    @Published var loadingRunDetail = false
    @Published var capacityAgeSeconds: Double?
    @Published var capacityFresh: Bool?
    @Published var capacityGeneratedAt: String?
    @Published var capacityProbedAt: String?
    @Published var capacityCacheHit: Bool?

    private let cli = SubfleetCLI()
    private let broker = SubfleetBrokerClient()
    private let logpile = LogpileCLI()
    private var routeGeneration = 0
    private var routeFingerprint: RouteFingerprint?
    private var detailGeneration = 0
    private var sessionDetailGeneration = 0
    private var capacityExpiresAt: Date?
    private var refreshingOutbox = false
    private var pendingSubmissions: [String: PendingBrokerSubmission] = [:]

    init() {
        if let data = try? Data(contentsOf: Self.pendingSubmissionsURL),
           let pending = try? JSONDecoder().decode([String: PendingBrokerSubmission].self, from: data) {
            pendingSubmissions = pending
            uncertainSessionIDs = Set(pending.keys)
        }
    }

    private static var pendingSubmissionsURL: URL {
        SubfleetBrokerClient.stateDirectory.appendingPathComponent("cockpit-client", isDirectory: true)
            .appendingPathComponent("pending-messages.json")
    }

    private func savePendingSubmissions() throws {
        let url = Self.pendingSubmissionsURL
        try FileManager.default.createDirectory(
            at: url.deletingLastPathComponent(), withIntermediateDirectories: true,
            attributes: [.posixPermissions: 0o700]
        )
        let directory = url.deletingLastPathComponent()
        let attributes = try FileManager.default.attributesOfItem(atPath: directory.path)
        guard attributes[.type] as? FileAttributeType == .typeDirectory else {
            throw CocoaError(.fileWriteNoPermission)
        }
        try FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: directory.path)
        // Atomic replacement prevents a partial client journal on app shutdown.
        try JSONEncoder().encode(pendingSubmissions).write(to: url, options: .atomic)
        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: url.path)
        let journal = try FileHandle(forWritingTo: url)
        defer { try? journal.close() }
        try journal.synchronize()
    }

    private func preparePendingSubmission(
        sessionID: String, prompt: String, imageURLs: [URL], serviceTier: CodexServiceTierOverride
    ) async throws -> PendingBrokerSubmission {
        let messageID = UUID().uuidString.lowercased()
        let clientDirectory = Self.pendingSubmissionsURL.deletingLastPathComponent()
        let request = try await Task.detached(priority: .userInitiated) {
            let directory = clientDirectory.appendingPathComponent("images-" + messageID, isDirectory: true)
            var snapshotPaths: [String] = []
            do {
                if !imageURLs.isEmpty {
                    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true,
                                                            attributes: [.posixPermissions: 0o700])
                    for (index, source) in imageURLs.enumerated() {
                        let values = try source.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
                        guard values.isRegularFile == true, values.isSymbolicLink != true else {
                            throw CocoaError(.fileReadNoPermission)
                        }
                        let destination = directory.appendingPathComponent("\(index)." + source.pathExtension)
                        try FileManager.default.copyItem(at: source, to: destination)
                        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: destination.path)
                        let image = try FileHandle(forWritingTo: destination)
                        do { try image.synchronize(); try image.close() }
                        catch { try? image.close(); throw error }
                        snapshotPaths.append(destination.path)
                    }
                }
                return BrokerRequest(
                    op: "enqueue", messageID: messageID, sessionID: sessionID, prompt: prompt,
                    imagePaths: snapshotPaths, serviceTier: serviceTier == .inherit ? nil : serviceTier.rawValue
                )
            } catch {
                // This is a newly created, exact per-message client directory,
                // never a user attachment or the shared state directory.
                if !imageURLs.isEmpty { try? FileManager.default.removeItem(at: directory) }
                throw error
            }
        }.value
        return PendingBrokerSubmission(request: request, sourceImagePaths: imageURLs.map(\.path))
    }

    private func forgetPendingSubmission(sessionID: String) {
        guard let pending = pendingSubmissions.removeValue(forKey: sessionID) else { return }
        // Release only our UUID-named private copies after durable acceptance
        // or a definitive rejection. Ambiguous attempts retain them for retry.
        if let id = pending.request.messageID, UUID(uuidString: id) != nil,
           id == id.lowercased(), !(pending.request.imagePaths ?? []).isEmpty {
            let directory = Self.pendingSubmissionsURL.deletingLastPathComponent()
                .appendingPathComponent("images-" + id, isDirectory: true)
            try? FileManager.default.removeItem(at: directory)
        }
        uncertainSessionIDs.remove(sessionID)
        try? savePendingSubmissions()
    }

    var sessionContinuation: SessionContinuationReceipt? {
        guard let id = selectedSessionID, let messages = sessionOutbox[id], !messages.isEmpty else {
            return nil
        }
        // Keep the provider turn in the status rail even when the user has
        // already queued a follow-up. A queued receipt has no live activity
        // of its own and must not hide the run that is actually working.
        for receipt in messages.reversed() where receipt.isActive && receipt.status != "queued" {
            if let runID = receipt.runID,
               let run = runs.first(where: { $0.id == runID })
            {
                if run.isRunning { return receipt }
                continue
            }
            return receipt
        }
        return messages.last
    }
    var sendingSessionMessage: Bool {
        selectedSessionID.map { sendingSessionIDs.contains($0) } ?? false
    }

    func unconfirmedMessage(sessionID: String) -> SessionMessage? {
        guard uncertainSessionIDs.contains(sessionID), let pending = pendingSubmissions[sessionID]?.request,
              !(sessionOutbox[sessionID] ?? []).contains(where: { $0.messageID == pending.messageID })
        else { return nil }
        return SessionMessage(id: pending.messageID ?? sessionID, role: "user",
                              text: pending.prompt?.isEmpty == false ? pending.prompt! : "Image attachment",
                              phase: nil, createdAt: nil)
    }

    var resolvedCLIPath: String? { cli.resolvedPath }
    var resolvedLogpilePath: String? { logpile.resolvedPath }
    var selectedRun: RunRecord? { runs.first { $0.id == selectedRunID } }
    var selectedSession: SessionRecord? { sessions.first { $0.id == selectedSessionID } }
    var selectedContinuationRun: RunRecord? {
        guard let receipt = sessionContinuation,
              receipt.sessionID == selectedSessionID,
              let runID = receipt.runID
        else { return nil }
        return runs.first { $0.id == runID }
    }
    var sessionContinuationInFlight: Bool {
        guard let id = selectedSessionID else { return false }
        return sessionOutbox[id]?.contains(where: \.isActive) ?? false
    }

    func clearRoute() {
        routeGeneration += 1
        routeFingerprint = nil
        routePreview = nil
        dispatchReceipt = nil
        setIssue("route", nil)
        setIssue("dispatch", nil)
    }

    func routeMatches(task: String, tier: String, workdir: String) -> Bool {
        routePreview != nil && routeFingerprint == fingerprint(
            task: task,
            tier: tier,
            workdir: workdir
        )
    }

    var capacityIsStale: Bool {
        capacityFresh != true || capacityExpiresAt.map { $0 <= Date() } == true
    }

    func refreshCapacity(force: Bool = false) async {
        guard !loadingCapacity else { return }
        loadingCapacity = true
        defer { loadingCapacity = false }
        do {
            let result = try await cli.call([
                "capacity", force ? "--refresh" : "--cached", "--json",
            ])
            guard result.succeeded else {
                setIssue("capacity", result.diagnostic)
                return
            }
            let families = try CapacityFamily.decodeList(result.stdout)
            let accounts = try CapacityAccount.decodeList(result.stdout)
            let freshness = try CapacityFreshness.decode(result.stdout)
            // Publish one coherent observation. A decoding failure must not pair
            // new family summaries with account rows from the previous refresh.
            capacity = families
            capacityAccounts = accounts
            capacityAgeSeconds = freshness.ageSeconds
            capacityFresh = force ? true : freshness.fresh
            capacityGeneratedAt = freshness.generatedAt
            capacityProbedAt = freshness.probedAt
            capacityCacheHit = freshness.cacheHit
            if let ttl = freshness.ttlSeconds, let age = freshness.ageSeconds {
                capacityExpiresAt = Date().addingTimeInterval(max(0, ttl - age))
            } else {
                capacityExpiresAt = nil
            }
            // A route preview is a gate over one exact capacity observation.
            // Any successful refresh makes that decision stale, even if the
            // task/tier/workdir fields did not change.
            clearRoute()
            setIssue("capacity", warning(from: result))
        } catch {
            setIssue("capacity", error.localizedDescription)
        }
    }

    func refreshRuns() async {
        guard !loadingRuns else { return }
        loadingRuns = true
        defer { loadingRuns = false }
        do {
            let result = try await cli.call(["runs", "--last", "100", "--json"])
            guard result.succeeded else {
                setIssue("runs", result.diagnostic)
                return
            }
            runs = try RunRecord.decodeList(result.stdout)
            if selectedRunID == nil { selectedRunID = runs.first?.id }
            if let selectedRunID, !runs.contains(where: { $0.id == selectedRunID }) {
                self.selectedRunID = runs.first?.id
                runDetail = nil
            }
            setIssue("runs", warning(from: result))
        } catch {
            setIssue("runs", error.localizedDescription)
        }
    }

    func refreshSessions() async {
        guard !loadingSessions else { return }
        loadingSessions = true
        defer { loadingSessions = false }
        do {
            let result = try await cli.call(["sessions", "--json"])
            guard result.succeeded else {
                setIssue("sessions", result.diagnostic)
                return
            }
            sessions = try SessionRecord.decodeList(result.stdout)
            if selectedSessionID == nil { selectedSessionID = sessions.first?.id }
            if let selectedSessionID,
               !sessions.contains(where: { $0.id == selectedSessionID })
            {
                self.selectedSessionID = sessions.first?.id
                sessionDetail = nil
            }
            setIssue("sessions", warning(from: result))
        } catch {
            setIssue("sessions", error.localizedDescription)
        }
    }

    func loadSelectedSession() async {
        guard let session = selectedSession else {
            sessionDetailGeneration += 1
            sessionDetail = nil
            loadingSessionDetail = false
            return
        }
        let requestedID = session.id
        sessionDetailGeneration += 1
        let generation = sessionDetailGeneration
        if sessionDetail?.session.id != requestedID {
            sessionDetail = nil
        }
        loadingSessionDetail = true
        defer {
            if sessionDetailGeneration == generation {
                loadingSessionDetail = false
            }
        }
        do {
            let result = try await cli.call(["sessions", "show", requestedID, "--json"])
            guard sessionDetailGeneration == generation,
                  selectedSessionID == requestedID
            else { return }
            guard result.succeeded else {
                sessionDetail = nil
                setIssue("session detail", result.diagnostic)
                return
            }
            let output = result.stdout
            let detail = try await Task.detached(priority: .utility) {
                try SessionDetail.decode(output, expectedID: requestedID)
            }.value
            guard sessionDetailGeneration == generation,
                  selectedSessionID == requestedID
            else { return }
            sessionDetail = detail
            setIssue("session detail", warning(from: result))
        } catch {
            guard sessionDetailGeneration == generation,
                  selectedSessionID == requestedID
            else { return }
            sessionDetail = nil
            setIssue("session detail", error.localizedDescription)
        }
    }

    @discardableResult
    func continueSelectedSession(
        session: SessionRecord,
        prompt: String,
        imageURLs: [URL] = [],
        serviceTier: CodexServiceTierOverride = .inherit
    ) async -> Bool {
        let requestedID = session.id
        guard !sendingSessionIDs.contains(requestedID) else { return false }
        if serviceTier != .inherit, session.provider != "codex" {
            setIssue(
                "session continuation",
                "\(serviceTier.displayName) service is available only for Codex continuations."
            )
            return false
        }
        sendingSessionIDs.insert(requestedID)
        defer { sendingSessionIDs.remove(requestedID) }
        do {
            if let pending = pendingSubmissions[requestedID] {
                // Resolve a lost acknowledgement before doing anything new.
                // If the original send exists, its original ID remains the
                // authoritative result even after an app restart.
                if let resolved = try await resolvePending(pending.request) {
                    let sameDraft = pending.request.prompt == prompt
                        && pending.sourceImagePaths == imageURLs.map(\.path)
                        && pending.request.serviceTier == (serviceTier == .inherit ? nil : serviceTier.rawValue)
                    accept(resolved)
                    if sameDraft { return true }
                } else {
                    setIssue("session continuation", "An earlier message has no confirmed acknowledgement. Use Retry saved message to retry that exact message ID; your current draft stays editable.")
                    return false
                }
            }
            let pending = try await preparePendingSubmission(
                sessionID: requestedID, prompt: prompt, imageURLs: imageURLs, serviceTier: serviceTier
            )
            let request = pending.request
            pendingSubmissions[requestedID] = pending
            do { try savePendingSubmissions() }
            catch {
                forgetPendingSubmission(sessionID: requestedID)
                throw error
            }
            let text = try await broker.request(request)
            guard let root = try parseJSON(text) as? JSONObject else {
                throw CockpitDataError.invalidJSON("invalid broker acknowledgement")
            }
            guard root.bool("accepted") == true else {
                forgetPendingSubmission(sessionID: requestedID)
                setIssue("session continuation", root.object("error")?.string("message") ?? root.string("message", "error") ?? "The message was not accepted. Your draft has been kept.")
                return false
            }
            let receipt = try SessionContinuationReceipt.decode(root, expectedID: requestedID)
            guard receipt.messageID == request.messageID else {
                throw CockpitDataError.invalidJSON("broker acknowledged a different message ID")
            }
            accept(receipt)
            // The durable local acknowledgement ends Send. Provider start,
            // transcript reads, and catalog refreshes are independent work.
            return true
        } catch {
            if pendingSubmissions[requestedID] != nil { uncertainSessionIDs.insert(requestedID) }
            setIssue("session continuation", "\(error.localizedDescription) Your draft and original message ID are preserved.")
            return false
        }
    }

    private func accept(_ receipt: SessionContinuationReceipt, clearPending: Bool = true) {
        let messages = Self.mergeOutbox(sessionOutbox[receipt.sessionID] ?? [], incoming: [receipt])
        if sessionOutbox[receipt.sessionID] != messages { sessionOutbox[receipt.sessionID] = messages }
        if pendingSubmissions[receipt.sessionID]?.request.messageID == receipt.messageID {
            if clearPending {
                forgetPendingSubmission(sessionID: receipt.sessionID)
            } else if uncertainSessionIDs.contains(receipt.sessionID) {
                uncertainSessionIDs.remove(receipt.sessionID)
            }
        }
        setIssue("session continuation", nil)
    }

    private static func mergeOutbox(
        _ existing: [SessionContinuationReceipt], incoming: [SessionContinuationReceipt]
    ) -> [SessionContinuationReceipt] {
        var messages = existing
        for receipt in incoming {
            if let index = messages.firstIndex(where: { $0.messageID == receipt.messageID }) {
                if let currentDate = messageDate(messages[index].updatedAt),
                   let incomingDate = messageDate(receipt.updatedAt), currentDate > incomingDate { continue }
                if messages[index].updatedAt == receipt.updatedAt,
                   (messages[index].activity?.revision ?? 0) > (receipt.activity?.revision ?? 0)
                {
                    continue
                }
                messages[index] = receipt
            } else { messages.append(receipt) }
        }
        messages.sort { ($0.createdAt ?? "") < ($1.createdAt ?? "") }
        return Array(messages.suffix(100))
    }

    private func resolvePending(_ pending: BrokerRequest) async throws -> SessionContinuationReceipt? {
        let text = try await broker.request(BrokerRequest(op: "get", messageID: pending.messageID))
        guard let root = try parseJSON(text) as? JSONObject else {
            throw CockpitDataError.invalidJSON("invalid broker message lookup")
        }
        if (root.object("error")?.string("code") ?? root.string("code")) == "message-not-found" { return nil }
        let receipt = try SessionContinuationReceipt.decode(root, expectedID: pending.sessionID)
        guard receipt.messageID == pending.messageID else {
            throw CockpitDataError.invalidJSON("broker lookup returned a different message ID")
        }
        return receipt
    }

    func retryPendingMessage(sessionID: String) async {
        guard let pending = pendingSubmissions[sessionID]?.request, !sendingSessionIDs.contains(sessionID) else { return }
        sendingSessionIDs.insert(sessionID)
        defer { sendingSessionIDs.remove(sessionID) }
        do {
            if let receipt = try await resolvePending(pending) { accept(receipt, clearPending: false); return }
            // Retrying the same persisted ID is safe even if the first enqueue
            // completed after the lookup: the broker deduplicates it.
            let text = try await broker.request(pending)
            let receipt = try SessionContinuationReceipt.decode(text, expectedID: sessionID)
            guard receipt.messageID == pending.messageID else {
                throw CockpitDataError.invalidJSON("broker acknowledged a different message ID")
            }
            accept(receipt, clearPending: false)
        } catch { setIssue("session continuation", error.localizedDescription) }
    }

    func warmSession(_ sessionID: String?) async {
        guard let sessionID else { return }
        _ = try? await broker.request(BrokerRequest(op: "prepare", sessionID: sessionID))
    }

    func refreshOutbox(allSessions: Bool = false) async {
        guard !refreshingOutbox else { return }
        refreshingOutbox = true
        defer { refreshingOutbox = false }
        let sessionID = allSessions ? nil : selectedSessionID
        do {
            let text = try await broker.request(BrokerRequest(op: "list", sessionID: sessionID))
            let messages = try await Task.detached(priority: .utility) {
                try SessionContinuationReceipt.decodeList(text)
            }.value
            if let sessionID {
                let selectedMessages = Self.mergeOutbox(
                    sessionOutbox[sessionID] ?? [], incoming: messages.filter { $0.sessionID == sessionID }
                )
                if sessionOutbox[sessionID] != selectedMessages { sessionOutbox[sessionID] = selectedMessages }
            } else {
                for (id, incoming) in Dictionary(grouping: messages, by: \.sessionID) {
                    let merged = Self.mergeOutbox(sessionOutbox[id] ?? [], incoming: incoming)
                    if sessionOutbox[id] != merged { sessionOutbox[id] = merged }
                }
            }
            for receipt in messages where pendingSubmissions[receipt.sessionID]?.request.messageID == receipt.messageID {
                accept(receipt, clearPending: false)
            }
            setIssue("outbox", nil)
        } catch { setIssue("outbox", error.localizedDescription) }
    }

    func cancelQueuedMessage(_ receipt: SessionContinuationReceipt) async {
        guard receipt.status == "queued" else { return }
        do {
            let text = try await broker.request(BrokerRequest(op: "cancel", messageID: receipt.messageID))
            accept(try SessionContinuationReceipt.decode(text, expectedID: receipt.sessionID))
        } catch { setIssue("outbox", error.localizedDescription) }
    }

    func markUnconfirmedMessageHandled(_ receipt: SessionContinuationReceipt) async {
        guard receipt.status == "delivery-unknown" else { return }
        do {
            let text = try await broker.request(BrokerRequest(
                op: "resolve", messageID: receipt.messageID, resolution: "handled", confirm: true
            ))
            accept(try SessionContinuationReceipt.decode(text, expectedID: receipt.sessionID))
        } catch { setIssue("outbox", error.localizedDescription) }
    }

    /// Hide a local bubble only after this exact prompt appears as a new user
    /// turn. A matching old turn is not evidence of delivery of this message.
    func visibleOutboxMessages(sessionID: String, transcript: [SessionMessage]) -> [SessionContinuationReceipt] {
        let matches = outboxTranscriptMatches(sessionID: sessionID, transcript: transcript)
        let earliestTranscriptDate = transcript.compactMap { Self.messageDate($0.createdAt) }.min()
        return (sessionOutbox[sessionID] ?? []).filter { receipt in
            if receipt.status == "finished", let created = Self.messageDate(receipt.createdAt),
               let earliestTranscriptDate, earliestTranscriptDate > created { return false }
            return matches[receipt.messageID] == nil || ["error", "cancelled", "delivery-unknown"].contains(receipt.status)
        }
    }

    func outboxPromptIsInTranscript(_ receipt: SessionContinuationReceipt, transcript: [SessionMessage]) -> Bool {
        outboxTranscriptMatches(sessionID: receipt.sessionID, transcript: transcript)[receipt.messageID] != nil
    }

    private func outboxTranscriptMatches(sessionID: String, transcript: [SessionMessage]) -> [String: String] {
        var matchedTranscriptIDs: Set<String> = []
        var matches: [String: String] = [:]
        for receipt in sessionOutbox[sessionID] ?? [] {
            if let nativeID = receipt.nativeMessageID,
               let match = transcript.first(where: {
                   $0.role == "user" && ($0.id == nativeID || $0.id.hasSuffix("-" + nativeID))
                       && !matchedTranscriptIDs.contains($0.id)
               }) {
                matchedTranscriptIDs.insert(match.id)
                matches[receipt.messageID] = match.id
                continue
            }
            guard !["queued", "starting", "cancelled"].contains(receipt.status),
                  !receipt.prompt.isEmpty,
                  let created = Self.messageDate(receipt.createdAt)
            else { continue }
            if let match = transcript.first(where: {
                $0.role == "user" && $0.text.trimmingCharacters(in: .whitespacesAndNewlines)
                    == receipt.prompt.trimmingCharacters(in: .whitespacesAndNewlines)
                    && !matchedTranscriptIDs.contains($0.id)
                    && Self.messageDate($0.createdAt).map { $0 >= created.addingTimeInterval(-1) } == true
            }) {
                matchedTranscriptIDs.insert(match.id)
                matches[receipt.messageID] = match.id
            }
        }
        return matches
    }

    private static func messageDate(_ value: String?) -> Date? {
        guard let value else { return nil }
        if let seconds = Double(value) { return Date(timeIntervalSince1970: seconds) }
        let fractional = ISO8601DateFormatter()
        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
        return fractional.date(from: value) ?? ISO8601DateFormatter().date(from: value)
    }

    func refreshHistory() async {
        guard !loadingHistory else { return }
        loadingHistory = true
        defer { loadingHistory = false }
        do {
            let result = try await logpile.taskList()
            guard result.succeeded else {
                setIssue("history", result.diagnostic)
                return
            }
            historyTasks = try HistoryTask.decodeList(result.stdout)
            setIssue("history", warning(from: result))
        } catch {
            setIssue("history", error.localizedDescription)
        }
    }

    func previewRoute(task: String, tier: String, workdir: String) async {
        guard !loadingRoute else { return }
        loadingRoute = true
        dispatchReceipt = nil
        defer { loadingRoute = false }
        let admissionGeneration = routeGeneration
        var generation = admissionGeneration
        do {
            if capacityIsStale {
                await refreshCapacity(force: true)
                guard !capacityIsStale else {
                    setIssue(
                        "route",
                        "Capacity could not be refreshed, so Subfleet did not approve a route."
                    )
                    return
                }
                // A successful refresh invalidates exactly one route generation.
                // Any additional invalidation means the user changed task, tier,
                // or working directory while the refresh was in flight.
                guard routeGeneration == admissionGeneration + 1 else { return }
            }
            routeGeneration += 1
            generation = routeGeneration
            let requestedFingerprint = fingerprint(task: task, tier: tier, workdir: workdir)
            let result = try await cli.call([
                "route", "--task", task, "--tier", tier,
                "-C", normalizedWorkdir(workdir), "--json",
            ])
            let preview = try RoutePreview.decode(result.stdout)
            guard routeGeneration == generation else { return }
            routePreview = preview
            routeFingerprint = requestedFingerprint
            if preview.ok && preview.allowed {
                setIssue("route", warning(from: result))
            } else {
                setIssue("route", preview.errorMessage ?? preview.reason)
            }
        } catch {
            guard routeGeneration == generation else { return }
            routePreview = nil
            routeFingerprint = nil
            setIssue("route", error.localizedDescription)
        }
    }

    /// One user action with two internal safety gates: resolve a fresh exact
    /// route when needed, then dispatch only through the existing guarded path.
    /// The prompt is never submitted when capacity refresh or route validation
    /// fails, and a field change while either await is in flight invalidates it.
    @discardableResult
    func routeAndDispatch(
        task: String,
        tier: String,
        workdir: String,
        prompt: String,
        serviceTier: CodexServiceTierOverride = .inherit
    ) async -> Bool {
        guard !prompt.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            setIssue("dispatch", "Write an assignment before dispatching.")
            return false
        }
        guard !dispatching, !loadingRoute, !loadingCapacity else { return false }

        let exactAllowedRoute = routeMatches(task: task, tier: tier, workdir: workdir)
            && routePreview?.ok == true
            && routePreview?.allowed == true
            && !capacityIsStale
        if !exactAllowedRoute {
            await previewRoute(task: task, tier: tier, workdir: workdir)
        }

        return await dispatch(
            task: task,
            tier: tier,
            workdir: workdir,
            prompt: prompt,
            serviceTier: serviceTier
        )
    }

    @discardableResult
    func dispatch(
        task: String,
        tier: String,
        workdir: String,
        prompt: String,
        serviceTier: CodexServiceTierOverride = .inherit
    ) async -> Bool {
        guard !dispatching else { return false }
        guard routePreview?.ok == true,
              routePreview?.allowed == true,
              !loadingCapacity,
              !loadingRoute,
              !capacityIsStale,
              routeFingerprint == fingerprint(task: task, tier: tier, workdir: workdir)
        else {
            setIssue(
                "dispatch",
                "Wait for capacity and routing to settle, then preview this exact task, capability, and working directory before dispatching."
            )
            return false
        }
        if serviceTier != .inherit,
           routePreview?.selection?.family.lowercased() != "codex"
        {
            setIssue(
                "dispatch",
                "\(serviceTier.displayName) service is available only for Codex routes. It does not change the selected model or reasoning effort."
            )
            return false
        }
        dispatching = true
        dispatchReceipt = nil
        defer { dispatching = false }
        do {
            var arguments = [
                "run", "--task", task, "--tier", tier,
                "-C", normalizedWorkdir(workdir),
            ]
            if let serviceTierArgument = serviceTier.cliArgument {
                arguments.append(serviceTierArgument)
            }
            arguments += ["-d", "--stdin", "--json"]
            let result = try await cli.call(arguments, standardInput: prompt)
            let receipt = try DispatchReceipt.decode(result.stdout)
            dispatchReceipt = receipt
            guard result.succeeded && receipt.ok else {
                setIssue("dispatch", receipt.message.isEmpty ? result.diagnostic : receipt.message)
                return false
            }
            setIssue("dispatch", warning(from: result))
            await refreshRuns()
            if let id = receipt.runID { selectedRunID = id }
            return true
        } catch {
            setIssue("dispatch", error.localizedDescription)
            return false
        }
    }

    func loadSelectedRun() async {
        guard let run = selectedRun else {
            detailGeneration += 1
            runDetail = nil
            loadingRunDetail = false
            return
        }
        let requestedID = run.id
        detailGeneration += 1
        let generation = detailGeneration
        if runDetail?.run.id != requestedID {
            runDetail = nil
        }
        loadingRunDetail = true
        defer {
            if detailGeneration == generation {
                loadingRunDetail = false
            }
        }
        do {
            let result = try await cli.call(["runs", "show", requestedID, "--json"])
            guard detailGeneration == generation, selectedRunID == requestedID else { return }
            guard result.succeeded else {
                runDetail = nil
                setIssue("run detail", result.diagnostic)
                return
            }
            let output = result.stdout
            let detail = try await Task.detached(priority: .utility) {
                try RunDetail.decode(output, fallback: run)
            }.value
            guard detailGeneration == generation, selectedRunID == requestedID else { return }
            runDetail = detail
            setIssue("run detail", warning(from: result))
        } catch {
            guard detailGeneration == generation, selectedRunID == requestedID else { return }
            runDetail = nil
            setIssue("run detail", error.localizedDescription)
        }
    }

    func killSelectedRun(expectedID: String? = nil) async {
        guard let run = selectedRun,
              expectedID == nil || run.id == expectedID,
              run.isRunning,
              !killingRun
        else { return }
        killingRun = true
        defer { killingRun = false }
        do {
            let result = try await cli.call(["kill", run.id, "--json"])
            let receipt = try KillReceipt.decode(result.stdout, expectedRunID: run.id)
            guard result.succeeded && receipt.ok else {
                setIssue("kill", receipt.message)
                return
            }
            setIssue("kill", warning(from: result))
            await refreshRuns()
            await loadSelectedRun()
        } catch {
            setIssue("kill", error.localizedDescription)
        }
    }

    func dismissIssues() {
        issues.removeAll()
    }

    private func warning(from result: CLIInvocationResult) -> String? {
        let value = result.stderr.trimmingCharacters(in: .whitespacesAndNewlines)
        return value.isEmpty ? nil : value
    }

    private func normalizedWorkdir(_ value: String) -> String {
        (value as NSString).expandingTildeInPath
    }

    private func fingerprint(task: String, tier: String, workdir: String) -> RouteFingerprint {
        RouteFingerprint(task: task, tier: tier, workdir: normalizedWorkdir(workdir))
    }

    private func setIssue(_ source: String, _ message: String?) {
        let clean = message?.trimmingCharacters(in: .whitespacesAndNewlines)
        if let clean, !clean.isEmpty {
            if issues[source] != clean { issues[source] = clean }
        } else if issues[source] != nil {
            issues.removeValue(forKey: source)
        }
    }
}
