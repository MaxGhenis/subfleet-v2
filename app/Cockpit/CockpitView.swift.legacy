// Recovered from the legacy Subfleet cockpit (native Swift, built 2026-08-30/31).
// Source: chief-of-staff feat/subfleet-traycer-port @ 8607b3c8 plus uncommitted working tree,
// subfleet/app/CockpitView.swift, sha256 b8d06bec3e33cfd8efb5d79898d04b1cdb3306c82f2df18e22e8cdd90d06f675 (recovery package 20260924T121841Z).
// Imported verbatim; not compiled until ported to the v2 daemon (docs/desktop/design.md §12).

import AppKit
import SwiftUI
import UniformTypeIdentifiers

private enum OpsPalette {
    static let background = Color(red: 0.070, green: 0.082, blue: 0.096)
    static let raised = Color(red: 0.095, green: 0.110, blue: 0.128)
    static let hairline = Color.white.opacity(0.10)
    static let accent = Color(red: 0.32, green: 0.72, blue: 0.93)
    static let quiet = Color.white.opacity(0.56)
}

enum CockpitSection: String, CaseIterable, Identifiable {
    case compose
    case runs
    case sessions
    case history

    var id: Self { self }
    var title: String {
        switch self {
        case .compose: return "Compose"
        case .runs: return "Agent runs"
        case .sessions: return "Conversations"
        case .history: return "Task lineage"
        }
    }
    var symbol: String {
        switch self {
        case .compose: return "square.and.pencil"
        case .runs: return "bolt.horizontal.circle"
        case .sessions: return "point.3.connected.trianglepath.dotted"
        case .history: return "clock.arrow.trianglehead.counterclockwise.rotate.90"
        }
    }
}

struct CockpitView: View {
    @ObservedObject var store: CockpitStore
    @State private var section: CockpitSection = .compose
    @StateObject private var conversationDrafts = ConversationDrafts()
    private let runTimer = Timer.publish(every: 5, on: .main, in: .common).autoconnect()
    private let outboxTimer = Timer.publish(every: 1, on: .main, in: .common).autoconnect()

    var body: some View {
        NavigationSplitView {
            CockpitSidebar(store: store, selection: $section)
                .navigationSplitViewColumnWidth(min: 215, ideal: 238, max: 280)
        } detail: {
            VStack(spacing: 0) {
                if !store.issues.isEmpty {
                    IssueStrip(store: store)
                    Divider().overlay(OpsPalette.hairline)
                }
                switch section {
                case .compose:
                    ComposeView(store: store) { section = .runs }
                case .runs:
                    RunsView(store: store)
                case .sessions:
                    SessionsView(store: store, composerState: conversationDrafts) { section = .runs }
                case .history:
                    HistoryView(store: store)
                }
            }
            .background(OpsPalette.background)
        }
        .frame(minWidth: 920, minHeight: 610)
        .preferredColorScheme(.dark)
        .tint(OpsPalette.accent)
        .task { await store.refreshOutbox(allSessions: true) }
        .task { await store.refreshCapacity() }
        .task {
            // Paint the durable account ledger immediately. A live provider
            // probe can be comparatively slow and should not hold the rest of
            // the cockpit (especially conversation continuation) behind it.
            async let runs: Void = store.refreshRuns()
            async let sessions: Void = store.refreshSessions()
            async let history: Void = store.refreshHistory()
            _ = await (runs, sessions, history)
            await store.loadSelectedSession()
        }
        .onReceive(runTimer) { _ in
            Task {
                if section == .runs {
                    await store.refreshRuns()
                    if store.selectedRun?.isRunning == true { await store.loadSelectedRun() }
                } else if section == .sessions {
                    if store.sessionContinuation?.runID != nil {
                        await store.refreshRuns()
                    }
                    await store.refreshSessions()
                    await store.loadSelectedSession()
                }
            }
        }
        .onReceive(outboxTimer) { _ in
            Task { await store.refreshOutbox() }
        }
    }
}

private struct CockpitSidebar: View {
    @ObservedObject var store: CockpitStore
    @Binding var selection: CockpitSection
    @AppStorage(SubfleetCLI.overrideKey) private var cliOverride = ""
    @AppStorage(LogpileCLI.overrideKey) private var logpileOverride = ""
    @AppStorage("subfleet.cockpit.codex-accounts-expanded") private var codexAccountsExpanded = true
    @AppStorage("subfleet.cockpit.claude-accounts-expanded") private var claudeAccountsExpanded = false

    var body: some View {
        List(selection: $selection) {
            Section("WORKSPACE") {
                ForEach(CockpitSection.allCases) { destination in
                    Label {
                        HStack {
                            Text(destination.title)
                            Spacer()
                            if destination == .runs {
                                if store.runs.contains(where: \.isRunning) {
                                    Text("\(store.runs.filter(\.isRunning).count) active")
                                    .font(.system(.caption2, design: .monospaced))
                                    .foregroundStyle(OpsPalette.accent)
                                }
                            } else if destination == .sessions {
                                Text("\(store.sessions.count)")
                                    .font(.system(.caption2, design: .monospaced))
                                    .foregroundStyle(.secondary)
                            } else if destination == .history, !store.historyTasks.isEmpty {
                                Text("\(store.historyTasks.count)")
                                    .font(.system(.caption2, design: .monospaced))
                                    .foregroundStyle(.secondary)
                            }
                        }
                    } icon: {
                        Image(systemName: destination.symbol)
                    }
                    .tag(destination)
                }
            }

            Section("FLEET") {
                if store.capacityIsStale {
                    HStack(spacing: 7) {
                        Image(systemName: "clock.badge.exclamationmark")
                            .foregroundStyle(.orange)
                        Text(store.capacityAgeSeconds.map { "Stale · \(Int($0))s old" } ?? "Stale")
                            .font(.caption)
                            .foregroundStyle(.orange)
                        Spacer()
                        Button("Refresh") {
                            Task { await store.refreshCapacity(force: true) }
                        }
                        .buttonStyle(.plain)
                        .font(.caption.weight(.medium))
                    }
                }
                if store.capacity.isEmpty {
                    HStack(spacing: 8) {
                        ProgressView().controlSize(.small).opacity(store.loadingCapacity ? 1 : 0)
                        Text(store.loadingCapacity ? "Reading capacity…" : "Capacity unavailable")
                            .foregroundStyle(.secondary)
                    }
                } else {
                    ForEach(store.capacity) { family in
                        DisclosureGroup(
                            isExpanded: family.id.lowercased() == "codex"
                                ? $codexAccountsExpanded
                                : $claudeAccountsExpanded
                        ) {
                            let accounts = store.capacityAccounts.filter { $0.family == family.id }
                            if accounts.isEmpty {
                                Text("Account details unavailable")
                                    .font(.caption2)
                                    .foregroundStyle(.secondary)
                                    .padding(.vertical, 3)
                            } else {
                                VStack(spacing: 0) {
                                    ForEach(Array(accounts.enumerated()), id: \.element.id) { index, account in
                                        CapacityAccountSidebarRow(
                                            account: account,
                                            family: family,
                                            stale: store.capacityIsStale
                                        )
                                        if index < accounts.count - 1 {
                                            Divider().overlay(OpsPalette.hairline)
                                        }
                                    }
                                }
                                .padding(.leading, 2)
                            }
                        } label: {
                            CapacitySidebarRow(family: family, stale: store.capacityIsStale)
                        }
                    }
                }
            }

            Section("RUNTIME") {
                VStack(alignment: .leading, spacing: 5) {
                    Text("SUBFLEET")
                        .font(.system(size: 9, weight: .semibold, design: .rounded))
                        .tracking(0.8)
                        .foregroundStyle(.tertiary)
                    TextField("CLI path override", text: $cliOverride)
                        .textFieldStyle(.plain)
                        .font(.system(.caption, design: .monospaced))
                        .onSubmit { Task { await store.refreshCapacity(force: true) } }
                    Text(cliOverride.isEmpty
                         ? (store.resolvedCLIPath.map(shortPath) ?? "subfleet not found")
                         : "Custom path")
                        .font(.caption2)
                        .foregroundStyle(.tertiary)
                        .lineLimit(1)
                        .help(store.resolvedCLIPath ?? "No executable resolved")
                    Divider().padding(.vertical, 2)
                    Text("LOGPILE · READ ONLY")
                        .font(.system(size: 9, weight: .semibold, design: .rounded))
                        .tracking(0.8)
                        .foregroundStyle(.tertiary)
                    TextField("Logpile path override", text: $logpileOverride)
                        .textFieldStyle(.plain)
                        .font(.system(.caption, design: .monospaced))
                        .onSubmit { Task { await store.refreshHistory() } }
                    Text(logpileOverride.isEmpty
                         ? (store.resolvedLogpilePath.map(shortPath) ?? "logpile not found")
                         : "Custom path")
                        .font(.caption2)
                        .foregroundStyle(.tertiary)
                        .lineLimit(1)
                        .help(store.resolvedLogpilePath ?? "No executable resolved")
                }
            }
        }
        .listStyle(.sidebar)
        .safeAreaInset(edge: .bottom) {
            HStack {
                Text("SUBFLEET")
                    .font(.system(size: 10, weight: .semibold, design: .rounded))
                    .tracking(1.4)
                    .foregroundStyle(.tertiary)
                Spacer()
                Button {
                    Task {
                        await store.refreshRuns()
                        await store.refreshSessions()
                        await store.refreshHistory()
                        await store.refreshCapacity(force: true)
                    }
                } label: {
                    if store.loadingCapacity || store.loadingRuns || store.loadingSessions {
                        ProgressView().controlSize(.small)
                    } else {
                        Image(systemName: "arrow.clockwise")
                    }
                }
                .buttonStyle(.plain)
                .help("Refresh fleet, runs, and sessions")
            }
            .padding(.horizontal, 12)
            .padding(.vertical, 9)
            .background(.bar)
        }
    }
}

private struct CapacitySidebarRow: View {
    let family: CapacityFamily
    let stale: Bool

    var body: some View {
        VStack(alignment: .leading, spacing: 5) {
            HStack(spacing: 7) {
                Circle()
                    .fill(stale ? Color.orange : (family.available ? Color.green : Color.orange))
                    .frame(width: 7, height: 7)
                Text(family.name).font(.callout.weight(.medium))
                Spacer()
                Text("\(family.dispatchable)/\(family.accounts)")
                    .font(.system(.caption, design: .monospaced))
                    .foregroundStyle(.secondary)
            }
            GeometryReader { proxy in
                ZStack(alignment: .leading) {
                    Capsule().fill(Color.white.opacity(0.08))
                    if let headroom = family.headroom {
                        Capsule()
                            .fill(stale ? Color.orange : (family.available ? OpsPalette.accent.opacity(0.75) : Color.orange))
                            .frame(width: proxy.size.width * min(max(headroom, 0), 100) / 100)
                    }
                }
            }
            .frame(height: 3)
            if let best = family.best {
                Text(best)
                    .font(.caption2)
                    .foregroundStyle(.tertiary)
                    .lineLimit(1)
            }
        }
        .padding(.vertical, 3)
    }
}

private struct CapacityAccountSidebarRow: View {
    let account: CapacityAccount
    let family: CapacityFamily
    let stale: Bool

    private var isClaude: Bool { account.family.lowercased() == "claude" }

    private var isNext: Bool {
        let candidates = [account.email, account.accountKey, account.home].compactMap { $0 }
        return family.best.map { best in candidates.contains(best) } ?? false
    }

    private var activeScopedLimit: CapacityScopedLimit? {
        account.scopedLimits.first { $0.isActive }
    }

    private var isUnverifiedClaudeLane: Bool {
        isClaude
            && account.dispatchable
            && account.headroom == nil
            && activeScopedLimit == nil
    }

    private var availabilityText: String {
        if let limit = activeScopedLimit {
            return limit.scopeModel.map { "\($0) at limit" } ?? "Scoped limit active"
        }
        if isUnverifiedClaudeLane { return "Probe on use" }
        if account.dispatchable { return "Ready" }
        switch account.status.lowercased() {
        case "limited", "exhausted": return "At limit"
        case "cooled": return "Cooled"
        case "not-enrolled": return "Not enrolled"
        case "auth-revoked", "no-auth", "auth-suspect": return "Auth required"
        default: return account.status.replacingOccurrences(of: "-", with: " ").capitalized
        }
    }

    private var roleText: String? {
        let roles = [
            account.isShadowedByApp ? "Current app" : nil,
            isNext ? "Next" : nil,
        ].compactMap { $0 }
        return roles.isEmpty ? nil : roles.joined(separator: " · ")
    }

    private var stateColor: Color {
        if activeScopedLimit != nil { return .orange }
        if isUnverifiedClaudeLane { return .gray }
        if !account.dispatchable {
            switch account.status.lowercased() {
            case "auth-revoked", "no-auth", "auth-suspect": return .red
            case "not-enrolled", "unknown": return .gray
            default: return .orange
            }
        }
        if isNext { return OpsPalette.accent }
        return .green
    }

    private var usageText: String {
        var pieces: [String] = []
        if let used = account.fiveHour.usedPercent {
            pieces.append("5h \(capacityPercent(used))")
        }
        if let used = account.weekly.usedPercent {
            pieces.append("overall \(capacityPercent(used))")
        }
        pieces.append(contentsOf: modelUsagePieces)
        return pieces.isEmpty ? "usage —" : pieces.joined(separator: " · ") + " used"
    }

    private var modelUsagePieces: [String] {
        var seen = Set<String>()
        var pieces: [(String, Double)] = []
        for limit in account.scopedLimits {
            guard let model = limit.scopeModel?.trimmingCharacters(in: .whitespacesAndNewlines),
                  !model.isEmpty,
                  let percent = limit.percent
            else { continue }
            let key = model.lowercased()
            guard seen.insert(key).inserted else { continue }
            pieces.append((model, percent))
        }
        for (key, window) in account.modelWindows.sorted(by: { $0.key < $1.key }) {
            guard let percent = window.usedPercent else { continue }
            let label = key.replacingOccurrences(of: "_", with: " ").capitalized
            guard seen.insert(label.lowercased()).inserted else { continue }
            pieces.append((label, percent))
        }
        return pieces
            .sorted { lhs, rhs in
                if lhs.1 == rhs.1 { return lhs.0 < rhs.0 }
                return lhs.1 > rhs.1
            }
            .map { "\($0.0) \(capacityPercent($0.1))" }
    }

    private var resetAt: String? {
        if !account.dispatchable, let limitedUntil = account.limitedUntil { return limitedUntil }
        let candidates = [
            account.shortWindowUntil,
            account.fiveHour.resetAt,
            account.weekly.resetAt,
        ].compactMap { value -> (String, Date)? in
            guard let value, let date = capacityDate(value), date > Date() else { return nil }
            return (value, date)
        }
        return candidates.min { $0.1 < $1.1 }?.0
    }

    private var resetText: String {
        if account.family.lowercased() == "claude" {
            let pieces = claudeResetPieces
            if !pieces.isEmpty {
                return (stale ? "last known · " : "") + pieces.joined(separator: " · ")
            }
        }
        guard let resetAt else { return "reset not reported" }
        let label = capacityResetLabel(resetAt)
        if stale { return "last-known reset \(label)" }
        return account.dispatchable ? "next reset \(label)" : "available \(label)"
    }

    private var claudeResetPieces: [String] {
        var pieces: [String] = []
        if let reset = account.fiveHour.resetAt {
            pieces.append("5h → \(capacityResetLabel(reset))")
        }
        if let reset = account.weekly.resetAt {
            pieces.append("overall → \(capacityResetLabel(reset))")
        }
        var seen = Set<String>()
        for limit in account.scopedLimits {
            guard let model = limit.scopeModel?.trimmingCharacters(in: .whitespacesAndNewlines),
                  !model.isEmpty,
                  let reset = limit.resetAt,
                  seen.insert(model.lowercased()).inserted
            else { continue }
            pieces.append("\(model) → \(capacityResetLabel(reset))")
        }
        for (key, window) in account.modelWindows.sorted(by: { $0.key < $1.key }) {
            let label = key.replacingOccurrences(of: "_", with: " ").capitalized
            guard let reset = window.resetAt,
                  seen.insert(label.lowercased()).inserted
            else { continue }
            pieces.append("\(label) → \(capacityResetLabel(reset))")
        }
        return pieces
    }

    private var detailText: String {
        var pieces = [roleText, availabilityText, resetText].compactMap { $0 }
        if account.inFlight > 0 { pieces.append("\(account.inFlight) active") }
        return pieces.joined(separator: " · ")
    }

    private var accessibilitySummary: String {
        let provider = account.family.capitalized
        let staleText = stale ? ", stale reading" : ""
        let role = roleText.map { ", \($0)" } ?? ""
        return "\(account.email), \(provider)\(role), \(availabilityText), \(usageText), \(resetText)\(staleText)"
    }

    var body: some View {
        HStack(alignment: .top, spacing: 7) {
            Circle()
                .fill(stateColor)
                .frame(width: 6, height: 6)
                .padding(.top, 5)
                .accessibilityHidden(true)
            VStack(alignment: .leading, spacing: 2) {
                if isClaude {
                    HStack(spacing: 6) {
                        Text(account.name)
                            .font(.system(size: 10.5, weight: .medium))
                            .lineLimit(1)
                            .truncationMode(.middle)
                        Spacer(minLength: 3)
                        Text(roleText ?? availabilityText)
                            .font(.system(size: 9, weight: .medium))
                            .foregroundStyle(stateColor)
                            .lineLimit(1)
                    }
                    Text(usageText)
                        .font(.system(size: 9, design: .monospaced).monospacedDigit())
                        .foregroundStyle(stale ? .tertiary : .secondary)
                        .lineLimit(1)
                        .truncationMode(.tail)
                    Text(detailText)
                        .font(.system(size: 9.5))
                        .foregroundStyle(stale ? .tertiary : .secondary)
                        .lineLimit(2)
                        .truncationMode(.tail)
                } else {
                    HStack(spacing: 6) {
                        Text(account.name)
                            .font(.system(size: 10.5, weight: .medium))
                            .lineLimit(1)
                            .truncationMode(.middle)
                        Spacer(minLength: 3)
                        Text(usageText)
                            .font(.system(size: 9, design: .monospaced).monospacedDigit())
                            .foregroundStyle(stale ? .tertiary : .secondary)
                            .lineLimit(1)
                            .fixedSize(horizontal: true, vertical: false)
                    }
                    Text(detailText)
                        .font(.system(size: 9.5))
                        .foregroundStyle(stale ? .tertiary : .secondary)
                        .lineLimit(1)
                        .truncationMode(.tail)
                }
            }
        }
        .padding(.vertical, 5)
        .opacity(stale ? 0.72 : 1)
        .help(capacityAccountHelp(account, resetAt: resetAt, stale: stale))
        .accessibilityElement(children: .ignore)
        .accessibilityLabel(accessibilitySummary)
    }
}

private struct IssueStrip: View {
    @ObservedObject var store: CockpitStore

    private var summary: String {
        store.issues.sorted { $0.key < $1.key }
            .map { "\($0.key): \($0.value)" }
            .joined(separator: "  ·  ")
    }

    var body: some View {
        HStack(spacing: 9) {
            Image(systemName: "exclamationmark.triangle.fill")
                .foregroundStyle(.orange)
            Text(summary)
                .font(.caption)
                .lineLimit(2)
                .textSelection(.enabled)
                .help(summary)
            Spacer(minLength: 12)
            Button("Dismiss") { store.dismissIssues() }
                .buttonStyle(.plain)
                .font(.caption)
                .foregroundStyle(.secondary)
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 8)
        .background(Color.orange.opacity(0.075))
    }
}

private struct ComposeView: View {
    @ObservedObject var store: CockpitStore
    let showRuns: () -> Void

    @State private var task = "build"
    @State private var tier = "standard"
    @State private var workdir = FileManager.default.homeDirectoryForCurrentUser.path
    @State private var prompt = ""
    @State private var serviceTier: CodexServiceTierOverride = .inherit

    private let tasks = ["lookup", "research", "sweep", "review", "build", "authored-prose", "strategy", "adjudication"]
    private let tiers = ["trivial", "easy", "standard", "hard"]

    private var currentPreview: RoutePreview? {
        store.routeMatches(task: task, tier: tier, workdir: workdir)
            ? store.routePreview
            : nil
    }

    private var serviceTierAvailable: Bool {
        currentPreview?.selection?.family.lowercased() == "codex"
    }

    private var canSubmit: Bool {
        !prompt.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
            && !store.loadingRoute
            && !store.loadingCapacity
            && !store.dispatching
    }

    var body: some View {
        VStack(spacing: 0) {
            HStack(alignment: .firstTextBaseline) {
                VStack(alignment: .leading, spacing: 3) {
                    Text("Compose")
                        .font(.system(size: 24, weight: .semibold, design: .rounded))
                    Text("Specify intent once. Subfleet chooses the model and account.")
                        .font(.callout)
                        .foregroundStyle(.secondary)
                }
                Spacer()
                if let receipt = store.dispatchReceipt, receipt.ok {
                    Label(receipt.runID ?? "Accepted", systemImage: "checkmark.circle.fill")
                        .font(.callout.weight(.medium))
                        .foregroundStyle(.green)
                        .transition(.opacity.combined(with: .move(edge: .trailing)))
                }
            }
            .padding(.horizontal, 24)
            .padding(.vertical, 19)

            Divider().overlay(OpsPalette.hairline)

            HStack(spacing: 14) {
                Picker("Task", selection: $task) {
                    ForEach(tasks, id: \.self) { Text($0).tag($0) }
                }
                .frame(width: 205)

                Picker("Capability", selection: $tier) {
                    ForEach(tiers, id: \.self) { Text($0.capitalized).tag($0) }
                }
                .pickerStyle(.segmented)
                .frame(maxWidth: 390)

            }
            .controlSize(.small)
            .padding(.horizontal, 24)
            .padding(.top, 15)

            HStack(spacing: 8) {
                Image(systemName: "folder")
                    .foregroundStyle(.secondary)
                TextField("Working directory", text: $workdir)
                    .textFieldStyle(.plain)
                    .font(.system(.callout, design: .monospaced))
                Button("Choose…") { chooseWorkdir() }
                    .controlSize(.small)
                Divider()
                    .frame(height: 20)
                    .padding(.horizontal, 4)
                Picker("Service", selection: $serviceTier) {
                    ForEach(CodexServiceTierOverride.allCases) { value in
                        Text(value.displayName).tag(value)
                    }
                }
                .pickerStyle(.menu)
                .frame(width: 175)
                .disabled(
                    !serviceTierAvailable
                    || store.loadingRoute
                    || store.loadingCapacity
                    || store.dispatching
                )
                .help(serviceTierHelp)
                .accessibilityLabel("Codex service tier")
            }
            .padding(.horizontal, 24)
            .padding(.vertical, 12)

            Divider().overlay(OpsPalette.hairline)

            HStack(spacing: 0) {
                VStack(alignment: .leading, spacing: 0) {
                    HStack {
                        Text("ASSIGNMENT")
                            .font(.system(size: 10, weight: .semibold, design: .rounded))
                            .tracking(1.2)
                            .foregroundStyle(.secondary)
                        Spacer()
                        Text("\(prompt.count) chars")
                            .font(.system(.caption2, design: .monospaced))
                            .foregroundStyle(.tertiary)
                    }
                    .padding(.horizontal, 24)
                    .padding(.vertical, 11)

                    ZStack(alignment: .topLeading) {
                        if prompt.isEmpty {
                            Text("Describe the concrete task, relevant context, expected artifact, and verification criteria…")
                                .foregroundStyle(.tertiary)
                                .padding(.horizontal, 28)
                                .padding(.vertical, 17)
                                .allowsHitTesting(false)
                        }
                        ComposerTextEditor(
                            text: $prompt,
                            isEditable: true,
                            canSubmit: canSubmit,
                            accessibilityLabel: "Assignment",
                            accessibilityHelp: "Press Return to route and dispatch. Press Shift-Return or Option-Return for a new line.",
                            onSubmit: submit,
                            onPasteImages: { _ in false }
                        )
                        .padding(.horizontal, 11)
                        .padding(.vertical, 5)
                    }
                    .background(OpsPalette.background)

                    Divider().overlay(OpsPalette.hairline)
                    HStack {
                        Button {
                            Task { await store.previewRoute(task: task, tier: tier, workdir: workdir) }
                        } label: {
                            if store.loadingRoute {
                                Label("Routing…", systemImage: "ellipsis")
                            } else {
                                Label("Preview route", systemImage: "arrow.triangle.branch")
                            }
                        }
                        .disabled(store.loadingRoute || store.loadingCapacity || store.dispatching)

                        Spacer()

                        if currentPreview == nil || store.capacityIsStale {
                            Text("Route and capacity are verified before sending")
                                .font(.caption)
                                .foregroundStyle(.tertiary)
                        }
                        Button(action: submit) {
                            if store.dispatching {
                                Label("Dispatching…", systemImage: "arrow.up.forward")
                            } else if store.loadingRoute || store.loadingCapacity {
                                Label("Routing…", systemImage: "arrow.triangle.branch")
                            } else {
                                Label("Route & dispatch", systemImage: "paperplane.fill")
                            }
                        }
                        .buttonStyle(.borderedProminent)
                        .disabled(!canSubmit)
                    }
                    .controlSize(.regular)
                    .padding(.horizontal, 24)
                    .padding(.vertical, 13)
                    .background(OpsPalette.raised)
                }

                Divider().overlay(OpsPalette.hairline)

                RouteInspector(
                    preview: currentPreview,
                    receipt: store.dispatchReceipt,
                    serviceTier: serviceTier
                )
                    .frame(minWidth: 270, idealWidth: 315, maxWidth: 350)
            }
        }
        .onChange(of: task) { _, _ in store.clearRoute() }
        .onChange(of: tier) { _, _ in store.clearRoute() }
        .onChange(of: workdir) { _, _ in store.clearRoute() }
        .onChange(of: serviceTierAvailable) { _, available in
            if !available { serviceTier = .inherit }
        }
        .onAppear { store.clearRoute() }
    }

    private func chooseWorkdir() {
        let panel = NSOpenPanel()
        panel.canChooseFiles = false
        panel.canChooseDirectories = true
        panel.allowsMultipleSelection = false
        panel.directoryURL = URL(fileURLWithPath: (workdir as NSString).expandingTildeInPath)
        if panel.runModal() == .OK, let url = panel.url {
            workdir = url.path
        }
    }

    private func submit() {
        guard canSubmit else { return }
        Task {
            let accepted = await store.routeAndDispatch(
                task: task,
                tier: tier,
                workdir: workdir,
                prompt: prompt,
                serviceTier: serviceTier
            )
            if accepted {
                withAnimation(.easeOut(duration: 0.18)) { showRuns() }
            }
        }
    }

    private var serviceTierHelp: String {
        guard serviceTierAvailable else {
            return "Service-tier overrides become available when the previewed route selects Codex."
        }
        switch serviceTier {
        case .inherit:
            return "Use the selected account's configured service tier. Model and reasoning stay unchanged."
        case .fast:
            return "Force Codex Fast for this run. GPT-5.6 uses 2.5× credits; model and reasoning stay unchanged."
        case .standard:
            return "Force Codex Standard for this run, even when the selected account defaults to Fast. Model and reasoning stay unchanged."
        }
    }
}

private struct RouteInspector: View {
    let preview: RoutePreview?
    let receipt: DispatchReceipt?
    let serviceTier: CodexServiceTierOverride
    @State private var showRaw = false

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            Text("ROUTE")
                .font(.system(size: 10, weight: .semibold, design: .rounded))
                .tracking(1.2)
                .foregroundStyle(.secondary)
                .padding(.horizontal, 20)
                .padding(.vertical, 12)
            Divider().overlay(OpsPalette.hairline)

            ScrollView {
                VStack(alignment: .leading, spacing: 15) {
                    if let preview {
                        HStack(spacing: 8) {
                            Circle()
                                .fill(preview.allowed ? Color.green : Color.orange)
                                .frame(width: 8, height: 8)
                            Text(preview.allowed ? "Dispatchable" : "Unavailable")
                                .font(.headline)
                        }

                        if let selection = preview.selection {
                            VStack(alignment: .leading, spacing: 9) {
                                inspectorLine("Provider", value: selection.family.capitalized)
                                inspectorLine("Model", value: selection.alias ?? selection.model)
                                inspectorLine("Lane", value: shortPath(selection.lane))
                                if selection.family.lowercased() == "codex" {
                                    inspectorLine("Service", value: serviceTier.routeLabel)
                                }
                            }
                        }

                        Text(preview.reason)
                            .font(.callout)
                            .foregroundStyle(.secondary)
                            .fixedSize(horizontal: false, vertical: true)

                        HStack(spacing: 12) {
                            if preview.fallbackCount > 0 {
                                Label("\(preview.fallbackCount) fallback", systemImage: "arrow.turn.down.right")
                            }
                            if preview.rejectedCount > 0 {
                                Label("\(preview.rejectedCount) rejected", systemImage: "nosign")
                            }
                            if let age = preview.cacheAge {
                                Label("\(Int(age))s old", systemImage: "clock")
                            }
                        }
                        .font(.caption2)
                        .foregroundStyle(.tertiary)

                        DisclosureGroup("Raw receipt", isExpanded: $showRaw) {
                            Text(preview.rawJSON)
                                .font(.system(size: 10.5, design: .monospaced))
                                .foregroundStyle(.secondary)
                                .textSelection(.enabled)
                                .padding(.top, 8)
                        }
                        .font(.caption)
                    } else {
                        Image(systemName: "arrow.triangle.branch")
                            .font(.system(size: 27, weight: .light))
                            .foregroundStyle(OpsPalette.accent)
                        Text("Routing stays read-only until you dispatch.")
                            .font(.headline)
                        Text("Preview checks cached capacity and shows the exact provider, model, and account Subfleet would use.")
                            .font(.callout)
                            .foregroundStyle(.secondary)
                            .fixedSize(horizontal: false, vertical: true)
                    }

                    if let receipt {
                        Divider().overlay(OpsPalette.hairline)
                        Label(receipt.message, systemImage: receipt.ok ? "checkmark.circle" : "xmark.circle")
                            .font(.callout)
                            .foregroundStyle(receipt.ok ? .green : .orange)
                            .textSelection(.enabled)
                    }
                }
                .padding(20)
                .frame(maxWidth: .infinity, alignment: .leading)
            }
        }
        .background(OpsPalette.raised.opacity(0.62))
    }

    @ViewBuilder
    private func inspectorLine(_ label: String, value: String) -> some View {
        VStack(alignment: .leading, spacing: 2) {
            Text(label.uppercased())
                .font(.system(size: 9, weight: .semibold, design: .rounded))
                .tracking(0.8)
                .foregroundStyle(.tertiary)
            Text(value)
                .font(.system(.callout, design: label == "Lane" ? .monospaced : .default))
                .textSelection(.enabled)
                .lineLimit(2)
        }
    }
}

private struct RunsView: View {
    @ObservedObject var store: CockpitStore
    @State private var confirmKill = false

    private var activeRunCount: Int { store.runs.filter(\.isRunning).count }

    var body: some View {
        HStack(spacing: 0) {
            VStack(spacing: 0) {
                HStack {
                    VStack(alignment: .leading, spacing: 2) {
                        Text("Agent runs")
                            .font(.system(size: 22, weight: .semibold, design: .rounded))
                        Text("\(store.runs.count) recent dispatches · \(activeRunCount) active")
                            .font(.caption)
                            .foregroundStyle(.secondary)
                    }
                    Spacer()
                    Button {
                        Task { await store.refreshRuns() }
                    } label: {
                        if store.loadingRuns { ProgressView().controlSize(.small) }
                        else { Image(systemName: "arrow.clockwise") }
                    }
                    .buttonStyle(.plain)
                    .help("Refresh runs")
                }
                .padding(.horizontal, 18)
                .padding(.vertical, 15)
                Divider().overlay(OpsPalette.hairline)

                if store.runs.isEmpty && !store.loadingRuns {
                    ContentUnavailableView(
                        "No runs",
                        systemImage: "bolt.horizontal.circle",
                        description: Text("Dispatch an assignment from Compose.")
                    )
                } else {
                    List(store.runs, selection: $store.selectedRunID) { run in
                        RunRow(run: run).tag(run.id)
                    }
                    .listStyle(.plain)
                    .scrollContentBackground(.hidden)
                }
            }
            .frame(minWidth: 335, idealWidth: 380, maxWidth: 440)
            .background(OpsPalette.raised.opacity(0.42))

            Divider().overlay(OpsPalette.hairline)

            RunDetailView(store: store, confirmKill: $confirmKill)
        }
        .onChange(of: store.selectedRunID) { _, _ in
            Task { await store.loadSelectedRun() }
        }
        .task {
            if store.selectedRunID != nil { await store.loadSelectedRun() }
        }
        .confirmationDialog(
            "Stop this run?",
            isPresented: $confirmKill,
            titleVisibility: .visible
        ) {
            Button("Stop run", role: .destructive) {
                Task { await store.killSelectedRun() }
            }
        } message: {
            Text("Subfleet will send SIGTERM and salvage any output written so far.")
        }
    }
}

private struct RunRow: View {
    let run: RunRecord

    var body: some View {
        HStack(alignment: .top, spacing: 10) {
            Circle()
                .fill(runStatusColor(run))
                .frame(width: 7, height: 7)
                .padding(.top, 5)
                .shadow(color: run.isRunning ? OpsPalette.accent.opacity(0.75) : .clear, radius: 4)
            VStack(alignment: .leading, spacing: 4) {
                Text(run.id)
                    .font(.system(size: 11.5, weight: .medium, design: .monospaced))
                    .lineLimit(1)
                HStack(spacing: 6) {
                    Text(run.model)
                    if let workdir = run.workdir { Text("· \(shortPath(workdir))") }
                }
                .font(.caption2)
                .foregroundStyle(.secondary)
                .lineLimit(1)
            }
            Spacer(minLength: 8)
            VStack(alignment: .trailing, spacing: 4) {
                Text(run.status.lowercased())
                    .font(.system(size: 10, weight: .semibold, design: .rounded))
                    .foregroundStyle(runStatusColor(run))
                Text(run.duration.map(durationText) ?? relativeTimestamp(run.startedAt))
                    .font(.system(.caption2, design: .monospaced))
                    .foregroundStyle(.tertiary)
            }
        }
        .padding(.vertical, 5)
    }
}

private enum ArtifactChoice: String, CaseIterable, Identifiable {
    case output
    case prompt
    case error
    case laneLog = "lane log"
    case receipt
    var id: Self { self }
}

private struct RunDetailView: View {
    @ObservedObject var store: CockpitStore
    @Binding var confirmKill: Bool
    @State private var artifact: ArtifactChoice = .output

    var body: some View {
        if let run = store.selectedRun {
            VStack(spacing: 0) {
                HStack(alignment: .center) {
                    VStack(alignment: .leading, spacing: 4) {
                        HStack(spacing: 8) {
                            Circle().fill(runStatusColor(run)).frame(width: 8, height: 8)
                            Text(run.status)
                                .font(.system(size: 11, weight: .semibold, design: .rounded))
                                .foregroundStyle(runStatusColor(run))
                        }
                        Text(run.id)
                            .font(.system(size: 15, weight: .semibold, design: .monospaced))
                            .textSelection(.enabled)
                    }
                    Spacer()
                    if let path = artifactPath {
                        Button("Reveal \(artifact.rawValue)") { reveal(path) }
                    }
                    if run.isRunning {
                        Button(role: .destructive) { confirmKill = true } label: {
                            if store.killingRun { ProgressView().controlSize(.small) }
                            else { Label("Stop", systemImage: "stop.fill") }
                        }
                        .disabled(store.killingRun)
                    }
                }
                .controlSize(.small)
                .padding(.horizontal, 22)
                .padding(.vertical, 15)

                Divider().overlay(OpsPalette.hairline)

                HStack(spacing: 22) {
                    metadata("Provider", run.family.capitalized)
                    metadata("Model", run.model)
                    if let lane = run.lane { metadata("Lane", shortPath(lane)) }
                    if let duration = run.duration { metadata("Elapsed", durationText(duration)) }
                    if let code = run.resultCode { metadata("Exit", "\(code)") }
                    Spacer()
                }
                .padding(.horizontal, 22)
                .padding(.vertical, 12)
                .background(OpsPalette.raised.opacity(0.52))

                Divider().overlay(OpsPalette.hairline)

                Picker("Artifact", selection: $artifact) {
                    ForEach(ArtifactChoice.allCases) { choice in
                        Text(choice.rawValue.capitalized).tag(choice)
                    }
                }
                .pickerStyle(.segmented)
                .labelsHidden()
                .controlSize(.small)
                .frame(maxWidth: 360)
                .padding(.vertical, 10)

                Divider().overlay(OpsPalette.hairline)

                if store.loadingRunDetail && store.runDetail == nil {
                    VStack {
                        Spacer()
                        ProgressView("Reading run artifacts…")
                        Spacer()
                    }
                } else if store.runDetail != nil {
                    ScrollView {
                        Text(artifactText)
                            .font(.system(size: 12.5, design: .monospaced))
                            .foregroundStyle(.primary.opacity(0.88))
                            .textSelection(.enabled)
                            .frame(maxWidth: .infinity, alignment: .topLeading)
                            .padding(22)
                    }
                    .background(OpsPalette.background)
                } else {
                    ContentUnavailableView(
                        "Artifacts unavailable",
                        systemImage: "doc.questionmark",
                        description: Text(
                            store.issues["run detail"]
                                ?? "Refresh the run to try reading its saved artifacts again."
                        )
                    )
                }
            }
        } else {
            ContentUnavailableView(
                "Select a run",
                systemImage: "bolt.horizontal.circle",
                description: Text("Inspect saved output and stop active work from here.")
            )
        }
    }

    private var artifactText: String {
        guard let detail = store.runDetail else { return "" }
        let value: String?
        switch artifact {
        case .output:
            value = detail.output
        case .prompt:
            value = detail.prompt
        case .error:
            value = detail.errorOutput
        case .laneLog:
            value = detail.laneLog
        case .receipt:
            value = detail.rawJSON
        }
        let text = value?.isEmpty == false
            ? value!
            : "No \(artifact.rawValue) content was saved."
        guard detail.truncatedArtifacts.contains(artifactKey) else { return text }
        return text + "\n\n… Cockpit preview truncated at 2 MiB. Reveal the saved artifact to inspect the rest."
    }

    private var artifactKey: String {
        switch artifact {
        case .output: return "output"
        case .prompt: return "prompt"
        case .error: return "error"
        case .laneLog: return "lane_log"
        case .receipt: return "receipt"
        }
    }

    private var artifactPath: String? {
        guard artifact != .receipt else { return nil }
        if let path = store.runDetail?.artifactPaths[artifactKey] {
            return path
        }
        return artifact == .output ? store.selectedRun?.outputPath : nil
    }

    @ViewBuilder
    private func metadata(_ label: String, _ value: String) -> some View {
        VStack(alignment: .leading, spacing: 2) {
            Text(label.uppercased())
                .font(.system(size: 9, weight: .semibold, design: .rounded))
                .tracking(0.8)
                .foregroundStyle(.tertiary)
            Text(value)
                .font(.system(.caption, design: .monospaced))
                .lineLimit(1)
                .help(value)
        }
    }

    private func reveal(_ path: String) {
        NSWorkspace.shared.activateFileViewerSelecting([URL(fileURLWithPath: path)])
    }
}

private enum ConversationProviderFilter: String, CaseIterable, Identifiable {
    case all = "All"
    case claude = "Claude"
    case codex = "Codex"

    var id: Self { self }
}

private struct ComposerAttachment: Identifiable {
    let id = UUID()
    let url: URL
    let displayName: String

    var preview: NSImage? { NSImage(contentsOf: url) }
}

@MainActor
private final class ConversationDrafts: ObservableObject {
    @Published var text: [String: String] = [:]
    @Published var attachments: [String: [ComposerAttachment]] = [:]
    @Published var serviceTiers: [String: CodexServiceTierOverride] = [:]
}

@MainActor
private enum ComposerAttachmentStore {
    private static let maximumCount = 8
    private static let maximumBytes = 20 * 1024 * 1024
    private static var activeUseCounts: [String: Int] = [:]
    private static var pendingRemovalPaths: Set<String> = []

    private static var root: URL {
        FileManager.default.homeDirectoryForCurrentUser
            .appendingPathComponent("chief-of-staff/state/subfleet/composer-attachments", isDirectory: true)
    }

    static func containsImage(_ pasteboard: NSPasteboard) -> Bool {
        if let values = pasteboard.readObjects(
            forClasses: [NSURL.self],
            options: [.urlReadingFileURLsOnly: true]
        ) as? [URL], values.contains(where: { NSImage(contentsOf: $0) != nil }) {
            return true
        }
        return pasteboard.canReadObject(forClasses: [NSImage.self], options: nil)
    }

    static func importFromPasteboard(_ pasteboard: NSPasteboard) throws -> [ComposerAttachment] {
        if let values = pasteboard.readObjects(
            forClasses: [NSURL.self],
            options: [.urlReadingFileURLsOnly: true]
        ) as? [URL] {
            let files = values.filter { NSImage(contentsOf: $0) != nil }
            if !files.isEmpty { return try importURLs(files) }
        }

        let pasted = pasteboard.readObjects(
            forClasses: [NSImage.self],
            options: nil
        ) as? [NSImage] ?? []
        let images = pasted.enumerated().map { index, image in
            (image, pasted.count == 1 ? "Pasted image" : "Pasted image \(index + 1)")
        }
        return try snapshotImages(Array(images.prefix(maximumCount)))
    }

    static func importURLs(_ urls: [URL]) throws -> [ComposerAttachment] {
        var images: [(NSImage, String)] = []
        for url in urls.prefix(maximumCount) {
            guard let image = NSImage(contentsOf: url) else {
                throw CocoaError(.fileReadCorruptFile)
            }
            images.append((image, url.lastPathComponent))
        }
        return try snapshotImages(images)
    }

    static func remove(_ attachment: ComposerAttachment) {
        let path = attachment.url.standardizedFileURL.path
        guard activeUseCounts[path] == nil else {
            pendingRemovalPaths.insert(path)
            return
        }
        try? FileManager.default.removeItem(at: attachment.url)
    }

    static func remove(_ attachments: [ComposerAttachment]) {
        attachments.forEach(remove)
    }

    static func beginUsing(_ attachments: [ComposerAttachment]) {
        for attachment in attachments {
            let path = attachment.url.standardizedFileURL.path
            activeUseCounts[path, default: 0] += 1
        }
    }

    static func finishUsing(
        _ attachments: [ComposerAttachment],
        removingFiles: Bool
    ) {
        for attachment in attachments {
            let path = attachment.url.standardizedFileURL.path
            let remainingUses = max(0, (activeUseCounts[path] ?? 1) - 1)
            if remainingUses > 0 {
                activeUseCounts[path] = remainingUses
                if removingFiles { pendingRemovalPaths.insert(path) }
                continue
            }
            activeUseCounts.removeValue(forKey: path)
            let removalWasPending = pendingRemovalPaths.remove(path) != nil
            if removingFiles || removalWasPending {
                try? FileManager.default.removeItem(at: attachment.url)
            }
        }
    }

    static func pruneAbandoned(protecting attachments: [ComposerAttachment]) {
        do {
            try prepareRoot()
            let protectedPaths = Set(attachments.map { $0.url.standardizedFileURL.path })
                .union(activeUseCounts.keys)
            let cutoff = Date().addingTimeInterval(-7 * 24 * 3600)
            let keys: Set<URLResourceKey> = [
                .contentModificationDateKey,
                .isRegularFileKey,
                .isSymbolicLinkKey,
            ]
            for file in try FileManager.default.contentsOfDirectory(
                at: root,
                includingPropertiesForKeys: Array(keys),
                options: [.skipsHiddenFiles]
            ) {
                let values = try? file.resourceValues(forKeys: keys)
                guard values?.isRegularFile == true,
                      values?.isSymbolicLink != true,
                      !protectedPaths.contains(file.standardizedFileURL.path),
                      (values?.contentModificationDate ?? .distantFuture) < cutoff
                else { continue }
                try? FileManager.default.removeItem(at: file)
            }
        } catch {
            // Attachment import still reports actionable filesystem failures.
            // Best-effort crash cleanup must never make the composer unusable.
        }
    }

    private static func snapshotImages(
        _ images: [(image: NSImage, name: String)]
    ) throws -> [ComposerAttachment] {
        var imported: [ComposerAttachment] = []
        do {
            for image in images {
                imported.append(try snapshot(image.image, name: image.name))
            }
            return imported
        } catch {
            remove(imported)
            throw error
        }
    }

    private static func snapshot(_ image: NSImage, name: String) throws -> ComposerAttachment {
        try prepareRoot()
        guard let tiff = image.tiffRepresentation,
              let bitmap = NSBitmapImageRep(data: tiff),
              let data = bitmap.representation(using: .png, properties: [:]),
              !data.isEmpty,
              data.count <= maximumBytes
        else { throw CocoaError(.fileWriteInapplicableStringEncoding) }
        let destination = root.appendingPathComponent("\(UUID().uuidString.lowercased()).png")
        do {
            // Foundation treats `.atomic` and `.withoutOverwriting` as an
            // invalid combination on current macOS and traps instead of
            // throwing. The private directory plus a fresh UUID make an
            // accidental collision impractical; atomic replacement keeps a
            // partially written image from entering a queued message.
            try data.write(to: destination, options: [.atomic])
            try FileManager.default.setAttributes(
                [.posixPermissions: 0o600],
                ofItemAtPath: destination.path
            )
            return ComposerAttachment(url: destination, displayName: name)
        } catch {
            try? FileManager.default.removeItem(at: destination)
            throw error
        }
    }

    private static func prepareRoot() throws {
        try FileManager.default.createDirectory(
            at: root,
            withIntermediateDirectories: true,
            attributes: [.posixPermissions: 0o700]
        )
        try FileManager.default.setAttributes(
            [.posixPermissions: 0o700],
            ofItemAtPath: root.path
        )
    }
}

private final class ComposerNSTextView: NSTextView {
    var pasteImages: ((NSPasteboard) -> Bool)?
    var imagePasteboard: () -> NSPasteboard = { .general }

    private func handleImagePaste() -> Bool {
        pasteImages?(imagePasteboard()) == true
    }

    override func paste(_ sender: Any?) {
        if handleImagePaste() { return }
        super.paste(sender)
    }

    override func pasteAsPlainText(_ sender: Any?) {
        if handleImagePaste() { return }
        super.pasteAsPlainText(sender)
    }

    override func pasteAsRichText(_ sender: Any?) {
        if handleImagePaste() { return }
        super.pasteAsRichText(sender)
    }

    override func performKeyEquivalent(with event: NSEvent) -> Bool {
        let modifiers = event.modifierFlags.intersection([.command, .shift, .option, .control])
        if event.type == .keyDown,
           modifiers == .command,
           event.charactersIgnoringModifiers?.lowercased() == "v",
           handleImagePaste() {
            return true
        }
        return super.performKeyEquivalent(with: event)
    }
}

private struct ComposerTextEditor: NSViewRepresentable {
    @Binding var text: String
    let isEditable: Bool
    let canSubmit: Bool
    let accessibilityLabel: String
    let accessibilityHelp: String
    let onSubmit: () -> Void
    let onPasteImages: (NSPasteboard) -> Bool

    func makeCoordinator() -> Coordinator { Coordinator(parent: self) }

    func makeNSView(context: Context) -> NSScrollView {
        let scrollView = NSScrollView()
        scrollView.drawsBackground = false
        scrollView.borderType = .noBorder
        scrollView.hasVerticalScroller = true
        scrollView.autohidesScrollers = true

        let textView = ComposerNSTextView(frame: .zero)
        textView.delegate = context.coordinator
        textView.isRichText = false
        textView.allowsUndo = true
        textView.drawsBackground = false
        textView.font = .systemFont(ofSize: 13.5)
        textView.textColor = .labelColor
        textView.insertionPointColor = .controlAccentColor
        textView.textContainerInset = NSSize(width: 13, height: 10)
        textView.isVerticallyResizable = true
        textView.isHorizontallyResizable = false
        textView.autoresizingMask = [.width]
        textView.textContainer?.widthTracksTextView = true
        textView.string = text
        textView.setAccessibilityLabel(accessibilityLabel)
        textView.setAccessibilityHelp(accessibilityHelp)
        textView.pasteImages = onPasteImages
        scrollView.documentView = textView
        return scrollView
    }

    func updateNSView(_ scrollView: NSScrollView, context: Context) {
        context.coordinator.parent = self
        guard let textView = scrollView.documentView as? ComposerNSTextView else { return }
        if textView.string != text {
            let selection = textView.selectedRange()
            textView.string = text
            textView.setSelectedRange(NSRange(location: min(selection.location, text.utf16.count), length: 0))
        }
        textView.isEditable = isEditable
        textView.pasteImages = onPasteImages
        textView.setAccessibilityLabel(accessibilityLabel)
        textView.setAccessibilityHelp(accessibilityHelp)
    }

    final class Coordinator: NSObject, NSTextViewDelegate {
        var parent: ComposerTextEditor

        init(parent: ComposerTextEditor) { self.parent = parent }

        func textDidChange(_ notification: Notification) {
            guard let textView = notification.object as? NSTextView else { return }
            parent.text = textView.string
        }

        func textView(_ textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
            guard commandSelector == #selector(NSResponder.insertNewline(_:)),
                  let event = NSApp.currentEvent,
                  event.type == .keyDown,
                  [36, 76].contains(Int(event.keyCode))
            else { return false }
            let modifiers = event.modifierFlags.intersection([.shift, .command, .option, .control])
            guard modifiers.isEmpty, !textView.hasMarkedText() else { return false }
            guard parent.canSubmit else { return true }
            DispatchQueue.main.async { self.parent.onSubmit() }
            return true
        }
    }
}

private struct SessionsView: View {
    @ObservedObject var store: CockpitStore
    @ObservedObject var composerState: ConversationDrafts
    let onOpenRun: () -> Void
    @State private var query = ""
    @State private var providerFilter = ConversationProviderFilter.all
    @State private var liveOnly = false

    private var filteredSessions: [SessionRecord] {
        store.sessions.filter { session in
            let providerMatches = providerFilter == .all
                || session.provider == providerFilter.rawValue.lowercased()
            let liveMatches = !liveOnly || session.live
            let needle = query.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
            let searchMatches = needle.isEmpty || [
                session.displayName,
                session.cwd ?? "",
                session.accountLabel,
            ].contains { $0.lowercased().contains(needle) }
            return providerMatches && liveMatches && searchMatches
        }
    }

    var body: some View {
        HStack(spacing: 0) {
            VStack(spacing: 0) {
                conversationListHeader
                Divider().overlay(OpsPalette.hairline)
                if store.sessions.isEmpty && !store.loadingSessions {
                    ContentUnavailableView(
                        "No conversations",
                        systemImage: "bubble.left.and.bubble.right",
                        description: Text("Native Claude and Codex sessions appear here when they have a local transcript.")
                    )
                } else if filteredSessions.isEmpty {
                    ContentUnavailableView.search(text: query)
                } else {
                    List(filteredSessions, selection: $store.selectedSessionID) { session in
                        ConversationSessionRow(session: session)
                            .tag(session.id)
                            .contextMenu {
                                Button("Copy session ID") { copyToPasteboard(session.nativeID) }
                                Button("Copy Subfleet ID") { copyToPasteboard(session.id) }
                                if let cwd = session.cwd {
                                    Button("Reveal working directory") {
                                        NSWorkspace.shared.activateFileViewerSelecting([
                                            URL(fileURLWithPath: cwd)
                                        ])
                                    }
                                }
                            }
                    }
                    .listStyle(.plain)
                    .scrollContentBackground(.hidden)
                    .background(OpsPalette.raised.opacity(0.35))
                }
            }
            .frame(minWidth: 300, idealWidth: 355, maxWidth: 420, maxHeight: .infinity)
            .background(OpsPalette.raised.opacity(0.35))

            Divider().overlay(OpsPalette.hairline)

            ConversationDetailView(
                store: store,
                draft: selectedDraftBinding,
                attachments: selectedAttachmentsBinding,
                serviceTier: selectedServiceTierBinding,
                onOpenRun: onOpenRun
            )
            .frame(maxWidth: .infinity, maxHeight: .infinity)
        }
        .onAppear {
            ComposerAttachmentStore.pruneAbandoned(
                protecting: composerState.attachments.values.flatMap { $0 }
            )
        }
        .onChange(of: store.selectedSessionID) { _, _ in
            Task { await store.loadSelectedSession() }
            Task { await store.refreshOutbox() }
            Task { await store.warmSession(store.selectedSessionID) }
        }
        .task { await store.warmSession(store.selectedSessionID) }
    }

    private var conversationListHeader: some View {
        VStack(alignment: .leading, spacing: 12) {
            HStack(alignment: .firstTextBaseline) {
                VStack(alignment: .leading, spacing: 3) {
                    Text("Conversations")
                        .font(.system(size: 21, weight: .semibold, design: .rounded))
                    Text("\(store.sessions.count) native · \(store.sessions.filter(\.live).count) open")
                        .font(.system(.caption, design: .monospaced))
                        .foregroundStyle(.secondary)
                }
                Spacer()
                Button {
                    Task {
                        await store.refreshSessions()
                        await store.loadSelectedSession()
                    }
                } label: {
                    if store.loadingSessions { ProgressView().controlSize(.small) }
                    else { Image(systemName: "arrow.clockwise") }
                }
                .buttonStyle(.plain)
                .help("Refresh native conversations")
                .keyboardShortcut("r", modifiers: .command)
            }
            HStack(spacing: 8) {
                HStack(spacing: 7) {
                    Image(systemName: "magnifyingglass")
                        .font(.caption)
                        .foregroundStyle(.tertiary)
                    TextField("Search name, account, or path", text: $query)
                        .textFieldStyle(.plain)
                        .font(.caption)
                }
                .padding(.horizontal, 9)
                .frame(height: 28)
                .background(OpsPalette.background, in: RoundedRectangle(cornerRadius: 7))
                Toggle("Live", isOn: $liveOnly)
                    .toggleStyle(.button)
                    .controlSize(.small)
            }
            Picker("Provider", selection: $providerFilter) {
                ForEach(ConversationProviderFilter.allCases) { provider in
                    Text(provider.rawValue).tag(provider)
                }
            }
            .labelsHidden()
            .pickerStyle(.segmented)
            .controlSize(.small)
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 15)
    }

    private var selectedDraftBinding: Binding<String> {
        let id = store.selectedSessionID ?? ""
        return Binding(
            get: { composerState.text[id] ?? "" },
            set: { composerState.text[id] = $0 }
        )
    }

    private var selectedAttachmentsBinding: Binding<[ComposerAttachment]> {
        let id = store.selectedSessionID ?? ""
        return Binding(
            get: { composerState.attachments[id] ?? [] },
            set: { composerState.attachments[id] = $0 }
        )
    }

    private var selectedServiceTierBinding: Binding<CodexServiceTierOverride> {
        let id = store.selectedSessionID ?? ""
        return Binding(
            get: { composerState.serviceTiers[id] ?? .inherit },
            set: { composerState.serviceTiers[id] = $0 }
        )
    }
}

private struct ConversationSessionRow: View {
    let session: SessionRecord

    private var providerColor: Color {
        session.provider == "claude"
            ? OpsPalette.accent
            : Color(red: 0.86, green: 0.63, blue: 0.38)
    }

    var body: some View {
        HStack(alignment: .top, spacing: 11) {
            ZStack {
                Circle().fill(providerColor.opacity(session.connected ? 0.20 : 0.10))
                    .frame(width: 29, height: 29)
                Text(session.provider == "claude" ? "C" : "O")
                    .font(.system(size: 10, weight: .bold, design: .rounded))
                    .foregroundStyle(providerColor)
            }
            VStack(alignment: .leading, spacing: 5) {
                HStack(spacing: 7) {
                    Text(session.displayName)
                        .font(.callout.weight(.medium))
                        .lineLimit(1)
                    Spacer(minLength: 4)
                    Text(session.stateLabel)
                        .font(.system(size: 8, weight: .bold, design: .rounded))
                        .tracking(0.55)
                        .foregroundStyle(session.connected ? providerColor : OpsPalette.quiet)
                }
                Text(session.accountLabel)
                    .font(.caption)
                    .foregroundStyle(.secondary)
                    .lineLimit(1)
                    .help(session.accountLabel)
                HStack(spacing: 6) {
                    Text(session.cwd.map(shortPath) ?? "Workspace unavailable")
                        .lineLimit(1)
                        .help(session.cwd ?? "")
                    Spacer(minLength: 3)
                    Text(sessionAge(session.updatedAtMilliseconds))
                        .fixedSize()
                }
                .font(.system(.caption2, design: .monospaced))
                .foregroundStyle(.tertiary)
            }
        }
        .padding(.vertical, 7)
        .accessibilityElement(children: .combine)
        .accessibilityLabel(
            "\(session.displayName), \(session.provider), \(session.accountLabel), "
            + "\(session.connected ? "connected" : "saved"), "
            + sessionAge(session.updatedAtMilliseconds)
        )
    }
}

private struct ConversationDetailView: View {
    @ObservedObject var store: CockpitStore
    @Binding var draft: String
    @Binding var attachments: [ComposerAttachment]
    @Binding var serviceTier: CodexServiceTierOverride
    let onOpenRun: () -> Void

    var body: some View {
        guard let session = store.selectedSession else {
            return AnyView(ContentUnavailableView(
                "Select a conversation",
                systemImage: "bubble.left.and.bubble.right",
                description: Text("Read and continue Claude or Codex without switching apps.")
            ))
        }
        return AnyView(VStack(spacing: 0) {
            SessionBindingHeader(session: session)
            Divider().overlay(OpsPalette.hairline)
            transcript(for: session)
            Divider().overlay(OpsPalette.hairline)
            ConversationComposer(
                store: store,
                session: session,
                draft: $draft,
                attachments: $attachments,
                serviceTier: $serviceTier,
                onOpenRun: onOpenRun
            )
        })
    }

    @ViewBuilder
    private func transcript(for session: SessionRecord) -> some View {
        let detail = store.sessionDetail?.session.id == session.id ? store.sessionDetail : nil
        let messages = detail?.messages ?? []
        let localMessages = store.visibleOutboxMessages(sessionID: session.id, transcript: messages)
        let unconfirmedMessage = store.unconfirmedMessage(sessionID: session.id)
        let lastID = unconfirmedMessage?.id ?? localMessages.last?.id ?? messages.last?.id
            ScrollViewReader { proxy in
                ScrollView {
                    LazyVStack(spacing: 0) {
                        if detail == nil {
                            if store.loadingSessionDetail {
                                ProgressView("Reading transcript…").padding(24)
                            } else {
                                Text("Transcript unavailable. Locally accepted messages remain below.")
                                    .font(.caption).foregroundStyle(.secondary).padding(24)
                            }
                        }
                        if let detail, detail.omittedEventCount > 0 {
                            Label(
                                "\(detail.omittedEventCount) internal transcript events omitted",
                                systemImage: "chevron.down"
                            )
                            .font(.caption2)
                            .foregroundStyle(.tertiary)
                            .padding(.horizontal, 24)
                            .padding(.vertical, 10)
                            .help("Activity shows provider commentary and safe action summaries, not hidden reasoning or raw tool data.")
                        }
                        ForEach(messages) { message in
                            TranscriptTurn(message: message, provider: session.provider)
                                .id(message.id)
                            Divider().overlay(OpsPalette.hairline).padding(.leading, 24)
                        }
                        if detail?.truncated == true {
                            Text("Showing the newest readable transcript window.")
                                .font(.caption2)
                                .foregroundStyle(.tertiary)
                                .padding(14)
                        }
                        ForEach(localMessages) { receipt in
                            LocalOutboxTurn(store: store, receipt: receipt,
                                            showPrompt: !store.outboxPromptIsInTranscript(receipt, transcript: messages))
                                .id(receipt.id)
                            Divider().overlay(OpsPalette.hairline).padding(.leading, 24)
                        }
                        if let unconfirmedMessage {
                            TranscriptTurn(message: unconfirmedMessage, provider: session.provider)
                            Label("Saved on this Mac; broker acknowledgement is unconfirmed. It will not be replayed with a new ID.", systemImage: "exclamationmark.triangle")
                                .font(.caption).foregroundStyle(.orange)
                                .padding(.horizontal, 37).padding(.bottom, 14)
                                .id(unconfirmedMessage.id)
                        }
                    }
                    .textSelection(.enabled)
                }
                .onAppear {
                    if let lastID { proxy.scrollTo(lastID, anchor: .bottom) }
                }
                .onChange(of: lastID) { _, _ in
                    if let lastID {
                        withAnimation(.easeOut(duration: 0.18)) {
                            proxy.scrollTo(lastID, anchor: .bottom)
                        }
                    }
                }
            }
    }
}

private struct LocalOutboxTurn: View {
    @ObservedObject var store: CockpitStore
    let receipt: SessionContinuationReceipt
    let showPrompt: Bool
    @State private var confirmingHandled = false

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            if showPrompt {
                TranscriptTurn(message: SessionMessage(
                    id: receipt.id, role: "user", text: receipt.prompt.isEmpty ? "Image attachment" : receipt.prompt,
                    phase: nil, createdAt: receipt.createdAt
                ), provider: receipt.provider)
            }
            HStack(alignment: .top, spacing: 8) {
                Image(systemName: receipt.isActive ? "clock" : "info.circle")
                VStack(alignment: .leading, spacing: 3) {
                    Text(receipt.statusLabel).fontWeight(.medium)
                    Text(receipt.message).foregroundStyle(.secondary)
                    if receipt.attachmentCount > 0 {
                        Text("\(receipt.attachmentCount) image\(receipt.attachmentCount == 1 ? "" : "s") attached")
                            .foregroundStyle(.secondary)
                    }
                }
                Spacer()
                if receipt.status == "queued" {
                    Button("Cancel queued") { Task { await store.cancelQueuedMessage(receipt) } }
                        .buttonStyle(.plain)
                }
                if ["error", "cancelled", "delivery-unknown"].contains(receipt.status) {
                    Button("Copy message") { copyToPasteboard(receipt.prompt) }
                        .buttonStyle(.plain)
                }
                if receipt.status == "delivery-unknown" {
                    Button("Mark handled…") { confirmingHandled = true }
                        .buttonStyle(.plain)
                }
            }
            .font(.caption)
            .foregroundStyle(["error", "delivery-unknown"].contains(receipt.status) ? Color.orange : OpsPalette.accent)
            .padding(.horizontal, 37)
            .padding(.top, showPrompt ? 0 : 14)
            .padding(.bottom, 14)
        }
        .background(OpsPalette.accent.opacity(0.035))
        .confirmationDialog("Have you checked the native conversation?", isPresented: $confirmingHandled, titleVisibility: .visible) {
            Button("Mark handled without resending") {
                Task { await store.markUnconfirmedMessageHandled(receipt) }
            }
        } message: {
            Text("Only continue after inspecting the provider transcript and checking whether this message ran. This removes the queue barrier; it does not replay the message or undo any provider work.")
        }
    }
}

private struct SessionBindingHeader: View {
    let session: SessionRecord
    @State private var showingInfo = false

    var body: some View {
        HStack(alignment: .center, spacing: 13) {
            VStack(alignment: .leading, spacing: 4) {
                HStack(spacing: 8) {
                    Text(session.provider.uppercased())
                        .font(.system(size: 9, weight: .bold, design: .rounded))
                        .tracking(0.8)
                        .foregroundStyle(OpsPalette.accent)
                    Text(session.displayName)
                        .font(.headline)
                        .lineLimit(1)
                    if session.starred {
                        Image(systemName: "star.fill").font(.caption2).foregroundStyle(.yellow)
                    }
                }
                HStack(spacing: 7) {
                    Label(session.accountLabel, systemImage: "person.crop.circle")
                    Text("·")
                    Text(session.cwd.map(shortPath) ?? "workspace unavailable")
                }
                .font(.system(.caption, design: .monospaced))
                .foregroundStyle(.secondary)
                .lineLimit(1)
            }
            Spacer()
            Text(session.stateLabel)
                .font(.system(size: 9, weight: .bold, design: .rounded))
                .tracking(0.65)
                .foregroundStyle(session.connected ? OpsPalette.accent : .secondary)
            Button {
                showingInfo.toggle()
            } label: {
                Image(systemName: "info.circle")
            }
            .buttonStyle(.plain)
            .popover(isPresented: $showingInfo) {
                VStack(alignment: .leading, spacing: 11) {
                    Text("Native binding").font(.headline)
                    bindingLine("Provider", session.provider.capitalized)
                    bindingLine(session.provider == "codex" ? "Current acct" : "Account", session.accountLabel)
                    bindingLine("Profile", session.profileHomeRef)
                    bindingLine("Session", session.nativeID)
                    bindingLine("Workspace", session.cwd.map(shortPath) ?? "Unavailable")
                    bindingLine("Model", session.model ?? "Provider default")
                    bindingLine(
                        "Permissions",
                        session.permissionMode ?? session.sandboxMode ?? "Provider default"
                    )
                    Divider()
                    Text(bindingExplanation)
                        .font(.caption)
                        .foregroundStyle(.secondary)
                        .fixedSize(horizontal: false, vertical: true)
                }
                .padding(16)
                .frame(width: 360)
            }
        }
        .padding(.horizontal, 20)
        .padding(.vertical, 13)
        .background(OpsPalette.raised.opacity(0.52))
    }

    private var bindingExplanation: String {
        if session.provider == "codex" {
            if let blocker = session.continuationBlocker { return blocker }
            return "Subfleet resumes this exact Codex UUID inside its recorded CODEX_HOME and working directory, using the account currently signed into that home. Historical tasks do not prove their original account."
        }
        if session.connected {
            return "Subfleet first delivers to the current live Claude inbox. If that exact turn returns an attested model-limit banner, Subfleet stops the exhausted writer and resumes this UUID on another enrolled account without changing the model tier."
        }
        return "Claude transcripts are account-agnostic. Subfleet selects the best available enrolled subscription, then resumes this exact UUID with its recorded permission mode."
    }

    private func bindingLine(_ label: String, _ value: String) -> some View {
        HStack(alignment: .firstTextBaseline) {
            Text(label.uppercased())
                .font(.system(size: 9, weight: .semibold, design: .rounded))
                .tracking(0.7)
                .foregroundStyle(.tertiary)
                .frame(width: 78, alignment: .leading)
            Text(value)
                .font(.system(.caption, design: .monospaced))
                .textSelection(.enabled)
            Spacer(minLength: 0)
        }
    }
}

private struct TranscriptTurn: View {
    let message: SessionMessage
    let provider: String

    private var isCommentary: Bool {
        message.role == "assistant" && message.phase == "commentary"
    }

    var body: some View {
        HStack(alignment: .top, spacing: 12) {
            Rectangle()
                .fill(message.role == "user" ? OpsPalette.accent.opacity(0.55) : Color.clear)
                .frame(width: 3)
                .accessibilityHidden(true)
            VStack(alignment: .leading, spacing: 8) {
                HStack(spacing: 5) {
                    Text(message.role == "user" ? "YOU" : provider.uppercased())
                    if isCommentary { Text("· COMMENTARY") }
                    if let createdAt = message.createdAt { Text("· \(messageClock(createdAt))") }
                }
                .font(.system(size: 9, weight: .semibold, design: .monospaced))
                .tracking(0.55)
                .foregroundStyle(.tertiary)
                .accessibilityElement(children: .combine)
                MarkdownMessageView(source: message.text)
                    .foregroundStyle(isCommentary ? OpsPalette.quiet : Color.primary.opacity(0.90))
            }
            .frame(maxWidth: .infinity, alignment: .leading)
        }
        .padding(.horizontal, 22)
        .padding(.vertical, 15)
        .accessibilityElement(children: .contain)
    }
}

private struct MarkdownMessageView: View {
    private let blocks: [MarkdownBlock]

    init(source: String) {
        blocks = MarkdownRenderCache.blocks(for: source)
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 10) {
            ForEach(blocks) { block in
                switch block.kind {
                case let .text(style, content, list, quoteDepth):
                    MarkdownRichBlockView(
                        style: style,
                        content: content,
                        list: list,
                        quoteDepth: quoteDepth
                    )
                case let .table(headers, rows):
                    MarkdownTableView(headers: headers, rows: rows)
                case let .simplified(label, content):
                    MarkdownSimplifiedBlockView(label: label, content: content)
                }
            }
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .textSelection(.enabled)
        .environment(\.openURL, OpenURLAction { url in
            guard let scheme = url.scheme?.lowercased(),
                  ["http", "https"].contains(scheme)
            else { return .discarded }
            return .systemAction
        })
    }
}

private final class MarkdownBlockCacheEntry: NSObject {
    let blocks: [MarkdownBlock]

    init(blocks: [MarkdownBlock]) {
        self.blocks = blocks
    }
}

private enum MarkdownRenderCache {
    private static let cache: NSCache<NSString, MarkdownBlockCacheEntry> = {
        let cache = NSCache<NSString, MarkdownBlockCacheEntry>()
        cache.countLimit = 800
        cache.totalCostLimit = 24 * 1_024 * 1_024
        return cache
    }()

    static func blocks(for source: String) -> [MarkdownBlock] {
        let key = source as NSString
        if let cached = cache.object(forKey: key) { return cached.blocks }
        let blocks = MarkdownIntentParser.parse(source)
        cache.setObject(
            MarkdownBlockCacheEntry(blocks: blocks),
            forKey: key,
            cost: max(1, source.utf8.count)
        )
        return blocks
    }
}

private enum MarkdownTextStyle {
    case paragraph
    case heading(Int)
    case code(String?)
    case divider
}

private enum MarkdownRenderLimits {
    static let blocks = 320
    static let listDepth = 8
    static let quoteDepth = 4
    static let tableColumns = 8
    static let tableRows = 40
    static let tableCells = 240
    static let totalTableCells = 480
    static let richParseBytes = 48_000
    static let structuralPipes = 512
}

private struct MarkdownListPresentation {
    let ordered: Bool
    let number: Int
    let depth: Int
    let showsMarker: Bool
    var checked: Bool?
}

private struct MarkdownBlock: Identifiable {
    enum Kind {
        case text(
            style: MarkdownTextStyle,
            content: AttributedString,
            list: MarkdownListPresentation?,
            quoteDepth: Int
        )
        case table(headers: [AttributedString], rows: [[AttributedString]])
        case simplified(label: String, content: AttributedString)
    }

    let id: Int
    let kind: Kind
}

private struct MarkdownRichBlockView: View {
    let style: MarkdownTextStyle
    let content: AttributedString
    let list: MarkdownListPresentation?
    let quoteDepth: Int

    var body: some View {
        HStack(alignment: .top, spacing: 8) {
            if quoteDepth > 0 {
                HStack(spacing: 3) {
                    ForEach(0..<quoteDepth, id: \.self) { _ in
                        RoundedRectangle(cornerRadius: 1)
                            .fill(OpsPalette.accent.opacity(0.42))
                            .frame(width: 2)
                    }
                }
                .padding(.vertical, 2)
            }
            if let list {
                Text(listMarker(list))
                    .font(.system(size: 11.5, weight: .medium, design: .monospaced))
                    .foregroundStyle(OpsPalette.quiet)
                    .frame(minWidth: list.ordered ? 24 : 15, alignment: .trailing)
            }
            styledContent
                .frame(maxWidth: .infinity, alignment: .leading)
        }
        .padding(.leading, CGFloat(max(0, (list?.depth ?? 1) - 1)) * 16)
        .opacity(quoteDepth > 0 ? 0.82 : 1)
    }

    @ViewBuilder
    private var styledContent: some View {
        switch style {
        case .paragraph:
            Text(content)
                .font(.system(size: 13.5))
                .lineSpacing(3)
                .fixedSize(horizontal: false, vertical: true)
        case let .heading(level):
            Text(content)
                .font(.system(
                    size: headingSize(level),
                    weight: level <= 2 ? .semibold : .medium,
                    design: .rounded
                ))
                .fixedSize(horizontal: false, vertical: true)
                .padding(.top, level <= 2 ? 3 : 1)
        case let .code(language):
            MarkdownCodeBlock(language: language, code: String(content.characters))
        case .divider:
            Divider()
                .overlay(OpsPalette.hairline)
                .padding(.vertical, 3)
        }
    }

    private func headingSize(_ level: Int) -> CGFloat {
        switch level {
        case 1: return 19
        case 2: return 17
        case 3: return 15.5
        default: return 14
        }
    }

    private func listMarker(_ list: MarkdownListPresentation) -> String {
        guard list.showsMarker else { return "" }
        if let checked = list.checked { return checked ? "☑︎" : "☐" }
        return list.ordered ? "\(list.number)." : "•"
    }
}

private struct MarkdownCodeBlock: View {
    let language: String?
    let code: String
    @State private var copied = false

    var body: some View {
        VStack(spacing: 0) {
            HStack(spacing: 8) {
                Text(String((language ?? "CODE").prefix(24)).uppercased())
                    .font(.system(size: 9, weight: .semibold, design: .monospaced))
                    .tracking(0.65)
                    .foregroundStyle(.tertiary)
                    .lineLimit(1)
                Spacer()
                Button {
                    copyToPasteboard(code)
                    copied = true
                    Task {
                        try? await Task.sleep(for: .seconds(1.2))
                        copied = false
                    }
                } label: {
                    Label(copied ? "Copied" : "Copy", systemImage: copied ? "checkmark" : "doc.on.doc")
                        .font(.caption2)
                }
                .buttonStyle(.plain)
                .foregroundStyle(copied ? OpsPalette.accent : .secondary)
            }
            .padding(.horizontal, 11)
            .frame(height: 30)

            Divider().overlay(OpsPalette.hairline)

            ScrollView(.horizontal, showsIndicators: true) {
                Text(code)
                    .font(.system(size: 12.5, design: .monospaced))
                    .fixedSize(horizontal: true, vertical: false)
                    .padding(12)
            }
        }
        .background(OpsPalette.raised.opacity(0.78))
        .clipShape(RoundedRectangle(cornerRadius: 7))
        .overlay {
            RoundedRectangle(cornerRadius: 7)
                .stroke(OpsPalette.hairline, lineWidth: 1)
        }
    }
}

private struct MarkdownSimplifiedBlockView: View {
    let label: String
    let content: AttributedString

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            Label(label, systemImage: "text.alignleft")
                .font(.caption2)
                .foregroundStyle(.secondary)
            Text(content)
                .font(.system(size: 12.5, design: .monospaced))
                .lineSpacing(2)
                .fixedSize(horizontal: false, vertical: true)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(11)
        .background(OpsPalette.raised.opacity(0.58))
        .clipShape(RoundedRectangle(cornerRadius: 7))
        .overlay {
            RoundedRectangle(cornerRadius: 7)
                .stroke(OpsPalette.hairline, lineWidth: 1)
        }
    }
}

private struct MarkdownTableView: View {
    let headers: [AttributedString]
    let rows: [[AttributedString]]

    var body: some View {
        ScrollView(.horizontal, showsIndicators: true) {
            Grid(alignment: .leading, horizontalSpacing: 0, verticalSpacing: 0) {
                GridRow {
                    ForEach(headers.indices, id: \.self) { column in
                        Text(headers[column])
                            .font(.system(size: 12, weight: .semibold))
                            .frame(minWidth: 90, maxWidth: 260, alignment: .leading)
                            .padding(.horizontal, 10)
                            .padding(.vertical, 8)
                            .background(OpsPalette.raised)
                    }
                }
                Divider()
                    .overlay(OpsPalette.hairline)
                    .gridCellColumns(max(1, headers.count))
                ForEach(Array(rows.enumerated()), id: \.offset) { rowIndex, row in
                    GridRow {
                        ForEach(headers.indices, id: \.self) { column in
                            Text(column < row.count ? row[column] : AttributedString(""))
                                .font(.system(size: 12.5))
                                .frame(minWidth: 90, maxWidth: 260, alignment: .leading)
                                .padding(.horizontal, 10)
                                .padding(.vertical, 7)
                                .background(
                                    rowIndex.isMultiple(of: 2)
                                        ? Color.clear
                                        : OpsPalette.raised.opacity(0.30)
                                )
                        }
                    }
                    if rowIndex < rows.count - 1 {
                        Divider()
                            .overlay(OpsPalette.hairline.opacity(0.65))
                            .gridCellColumns(max(1, headers.count))
                    }
                }
            }
            .clipShape(RoundedRectangle(cornerRadius: 7))
            .overlay {
                RoundedRectangle(cornerRadius: 7)
                    .stroke(OpsPalette.hairline, lineWidth: 1)
            }
        }
    }
}

private struct RawMarkdownBlock {
    let id: Int
    let components: [PresentationIntent.IntentType]
    var content: AttributedString
}

private struct MarkdownTableCellContext {
    let tableID: Int
    let rowID: Int
    let column: Int
    let columnCount: Int
    let isHeader: Bool
}

private struct MarkdownTableExtent {
    let nextIndex: Int
    let columnCount: Int
    let rowCount: Int
    let cellCount: Int

    var renderedCellCount: Int { columnCount * (rowCount + 1) }

    var requiresSimplifiedRendering: Bool {
        columnCount > MarkdownRenderLimits.tableColumns
            || rowCount > MarkdownRenderLimits.tableRows
            || cellCount > MarkdownRenderLimits.tableCells
            || renderedCellCount > MarkdownRenderLimits.tableCells
    }
}

private enum MarkdownIntentParser {
    static func parse(_ source: String) -> [MarkdownBlock] {
        if shouldSimplifyBeforeParsing(source) {
            return [
                MarkdownBlock(
                    id: -1,
                    kind: .simplified(
                        label: "Large Markdown message shown as text for performance",
                        content: AttributedString(source)
                    )
                )
            ]
        }

        let options = AttributedString.MarkdownParsingOptions(
            interpretedSyntax: .full,
            failurePolicy: .returnPartiallyParsedIfPossible
        )
        guard let parsed = try? AttributedString(markdown: source, options: options) else {
            return [
                MarkdownBlock(
                    id: -1,
                    kind: .text(
                        style: .paragraph,
                        content: AttributedString(source),
                        list: nil,
                        quoteDepth: 0
                    )
                )
            ]
        }

        let rawBlocks = groupedBlocks(parsed)
        guard !rawBlocks.isEmpty else {
            return [
                MarkdownBlock(
                    id: -1,
                    kind: .text(
                        style: .paragraph,
                        content: AttributedString(source),
                        list: nil,
                        quoteDepth: 0
                    )
                )
            ]
        }

        var result: [MarkdownBlock] = []
        var seenListItems: Set<Int> = []
        var renderedTableCells = 0
        var index = 0
        while index < rawBlocks.count {
            if result.count >= MarkdownRenderLimits.blocks {
                result.append(MarkdownBlock(
                    id: rawBlocks[index].id,
                    kind: .simplified(
                        label: "Additional Markdown shown as text",
                        content: simplifiedContent(rawBlocks[index...])
                    )
                ))
                break
            }

            if let table = tableContext(rawBlocks[index].components) {
                let extent = tableExtent(rawBlocks, from: index, tableID: table.tableID)
                let exceedsMessageTableBudget =
                    renderedTableCells + extent.renderedCellCount
                    > MarkdownRenderLimits.totalTableCells
                if extent.requiresSimplifiedRendering || exceedsMessageTableBudget {
                    result.append(MarkdownBlock(
                        id: rawBlocks[index].id,
                        kind: .simplified(
                            label: extent.requiresSimplifiedRendering
                                ? "Large table (\(extent.columnCount) columns × \(extent.rowCount) rows) shown as text"
                                : "Additional table shown as text for performance",
                            content: simplifiedTableContent(
                                rawBlocks[index..<extent.nextIndex]
                            )
                        )
                    ))
                    index = extent.nextIndex
                    continue
                }
                let built = buildTable(rawBlocks, from: index, tableID: table.tableID)
                renderedTableCells += extent.renderedCellCount
                result.append(MarkdownBlock(
                    id: rawBlocks[index].id,
                    kind: .table(headers: built.headers, rows: built.rows)
                ))
                index = built.nextIndex
                continue
            }

            var content = rawBlocks[index].content
            var list = listPresentation(
                rawBlocks[index].components,
                seenListItems: &seenListItems
            )
            if list?.showsMarker == true, let checked = stripTaskMarker(from: &content) {
                list?.checked = checked
            }
            result.append(MarkdownBlock(
                id: rawBlocks[index].id,
                kind: .text(
                    style: textStyle(rawBlocks[index].components),
                    content: content,
                    list: list,
                    quoteDepth: quoteDepth(rawBlocks[index].components)
                )
            ))
            index += 1
        }
        return result
    }

    private static func shouldSimplifyBeforeParsing(_ source: String) -> Bool {
        if source.utf8.count > MarkdownRenderLimits.richParseBytes { return true }
        var openFence: (character: Character, length: Int)?
        var previousPipeCount = 0

        for line in source.split(separator: "\n", omittingEmptySubsequences: false) {
            if let marker = fenceMarker(in: line) {
                if let currentFence = openFence {
                    if marker.character == currentFence.character,
                       marker.length >= currentFence.length
                    {
                        openFence = nil
                    }
                } else {
                    openFence = marker
                }
                previousPipeCount = 0
                continue
            }
            if openFence != nil || isIndentedCode(line) {
                previousPipeCount = 0
                continue
            }

            let pipeCount = line.utf8.reduce(into: 0) { count, byte in
                if byte == 0x7C { count += 1 }
            }
            if pipeCount > MarkdownRenderLimits.structuralPipes,
               previousPipeCount > 0,
               abs(pipeCount - previousPipeCount) <= 2,
               isTableDelimiter(line)
            {
                return true
            }
            previousPipeCount = line.trimmingCharacters(in: .whitespaces).isEmpty
                ? 0
                : pipeCount
        }
        return false
    }

    private static func fenceMarker(
        in line: Substring
    ) -> (character: Character, length: Int)? {
        let leadingSpaces = line.prefix { $0 == " " }.count
        guard leadingSpaces <= 3 else { return nil }
        let content = line.dropFirst(leadingSpaces)
        guard let character = content.first, character == "`" || character == "~" else {
            return nil
        }
        let length = content.prefix { $0 == character }.count
        return length >= 3 ? (character, length) : nil
    }

    private static func isIndentedCode(_ line: Substring) -> Bool {
        line.first == "\t" || line.prefix { $0 == " " }.count >= 4
    }

    private static func isTableDelimiter(_ line: Substring) -> Bool {
        var cells = line.split(separator: "|", omittingEmptySubsequences: false)
        if cells.first?.trimmingCharacters(in: .whitespaces).isEmpty == true {
            cells.removeFirst()
        }
        if cells.last?.trimmingCharacters(in: .whitespaces).isEmpty == true {
            cells.removeLast()
        }
        guard !cells.isEmpty else { return false }
        return cells.allSatisfy { cell in
            var token = cell.trimmingCharacters(in: .whitespaces)
            if token.hasPrefix(":") { token.removeFirst() }
            if token.hasSuffix(":") { token.removeLast() }
            return !token.isEmpty && token.allSatisfy { $0 == "-" }
        }
    }

    private static func groupedBlocks(_ parsed: AttributedString) -> [RawMarkdownBlock] {
        var blocks: [RawMarkdownBlock] = []
        var nextSyntheticID = -1
        var priorWasUnscoped = false

        for run in parsed.runs {
            let components = run.presentationIntent?.components ?? []
            let id: Int
            if let leaf = components.first {
                id = leaf.identity
                priorWasUnscoped = false
            } else if priorWasUnscoped, let last = blocks.last {
                id = last.id
            } else {
                id = nextSyntheticID
                nextSyntheticID -= 1
                priorWasUnscoped = true
            }

            var fragment = AttributedString(parsed[run.range])
            fragment.presentationIntent = nil
            fragment.imageURL = nil
            let unsafeLinks = fragment.runs.compactMap { fragmentRun -> Range<AttributedString.Index>? in
                guard let link = fragmentRun.link else { return nil }
                let scheme = link.scheme?.lowercased()
                return ["http", "https"].contains(scheme) ? nil : fragmentRun.range
            }
            for range in unsafeLinks { fragment[range].link = nil }

            if blocks.last?.id == id {
                blocks[blocks.count - 1].content.append(fragment)
            } else {
                blocks.append(RawMarkdownBlock(
                    id: id,
                    components: components,
                    content: fragment
                ))
            }
        }
        return blocks
    }

    private static func textStyle(
        _ components: [PresentationIntent.IntentType]
    ) -> MarkdownTextStyle {
        guard let leaf = components.first else { return .paragraph }
        switch leaf.kind {
        case let .header(level): return .heading(level)
        case let .codeBlock(language): return .code(language)
        case .thematicBreak: return .divider
        default: return .paragraph
        }
    }

    private static func listPresentation(
        _ components: [PresentationIntent.IntentType],
        seenListItems: inout Set<Int>
    ) -> MarkdownListPresentation? {
        var itemID: Int?
        var ordinal = 1
        var ordered: Bool?
        var depth = 0

        for component in components {
            switch component.kind {
            case let .listItem(value):
                if itemID == nil {
                    itemID = component.identity
                    ordinal = value
                }
            case .orderedList:
                depth += 1
                if itemID != nil, ordered == nil { ordered = true }
            case .unorderedList:
                depth += 1
                if itemID != nil, ordered == nil { ordered = false }
            default:
                continue
            }
        }
        guard let itemID else { return nil }
        return MarkdownListPresentation(
            ordered: ordered ?? false,
            number: ordinal,
            depth: min(max(1, depth), MarkdownRenderLimits.listDepth),
            showsMarker: seenListItems.insert(itemID).inserted,
            checked: nil
        )
    }

    private static func quoteDepth(_ components: [PresentationIntent.IntentType]) -> Int {
        min(MarkdownRenderLimits.quoteDepth, components.reduce(into: 0) { count, component in
            if case .blockQuote = component.kind { count += 1 }
        })
    }

    private static func tableContext(
        _ components: [PresentationIntent.IntentType]
    ) -> MarkdownTableCellContext? {
        var tableID: Int?
        var rowID: Int?
        var column: Int?
        var columnCount = 0
        var isHeader = false

        for component in components {
            switch component.kind {
            case let .tableCell(value):
                column = value
            case .tableHeaderRow:
                rowID = component.identity
                isHeader = true
            case .tableRow:
                rowID = component.identity
            case let .table(columns):
                tableID = component.identity
                columnCount = columns.count
            default:
                continue
            }
        }
        guard let tableID, let rowID, let column else { return nil }
        return MarkdownTableCellContext(
            tableID: tableID,
            rowID: rowID,
            column: column,
            columnCount: max(1, columnCount),
            isHeader: isHeader
        )
    }

    private static func tableExtent(
        _ blocks: [RawMarkdownBlock],
        from start: Int,
        tableID: Int
    ) -> MarkdownTableExtent {
        var index = start
        var columnCount = 1
        var rowIDs: Set<Int> = []
        var cellCount = 0
        while index < blocks.count,
              let context = tableContext(blocks[index].components),
              context.tableID == tableID
        {
            columnCount = max(columnCount, context.columnCount)
            if !context.isHeader { rowIDs.insert(context.rowID) }
            cellCount += 1
            index += 1
        }
        return MarkdownTableExtent(
            nextIndex: index,
            columnCount: columnCount,
            rowCount: rowIDs.count,
            cellCount: cellCount
        )
    }

    private static func simplifiedTableContent(
        _ blocks: ArraySlice<RawMarkdownBlock>
    ) -> AttributedString {
        var lines: [String] = []
        var cells: [String] = []
        var currentRowID: Int?
        var currentIsHeader = false

        for block in blocks {
            guard let context = tableContext(block.components) else { continue }
            if let currentRowID,
               currentRowID != context.rowID || currentIsHeader != context.isHeader
            {
                lines.append(cells.joined(separator: " | "))
                cells.removeAll(keepingCapacity: true)
            }
            currentRowID = context.rowID
            currentIsHeader = context.isHeader
            cells.append(
                String(block.content.characters)
                    .replacingOccurrences(of: "\n", with: " ↵ ")
            )
        }
        if !cells.isEmpty { lines.append(cells.joined(separator: " | ")) }
        return AttributedString(lines.joined(separator: "\n"))
    }

    private static func simplifiedContent(
        _ blocks: ArraySlice<RawMarkdownBlock>
    ) -> AttributedString {
        AttributedString(
            blocks.map { String($0.content.characters) }
                .joined(separator: "\n\n")
        )
    }

    private static func buildTable(
        _ blocks: [RawMarkdownBlock],
        from start: Int,
        tableID: Int
    ) -> (headers: [AttributedString], rows: [[AttributedString]], nextIndex: Int) {
        let initial = tableContext(blocks[start].components)
        let columnCount = initial?.columnCount ?? 1
        var headers = Array(repeating: AttributedString(""), count: columnCount)
        var rows: [[AttributedString]] = []
        var lastRowID: Int?
        var index = start

        while index < blocks.count,
              let context = tableContext(blocks[index].components),
              context.tableID == tableID
        {
            if context.isHeader {
                if context.column < headers.count {
                    headers[context.column] = blocks[index].content
                }
            } else {
                if context.rowID != lastRowID {
                    rows.append(Array(repeating: AttributedString(""), count: columnCount))
                    lastRowID = context.rowID
                }
                if context.column < columnCount {
                    rows[rows.count - 1][context.column] = blocks[index].content
                }
            }
            index += 1
        }
        return (headers, rows, index)
    }

    private static func stripTaskMarker(from content: inout AttributedString) -> Bool? {
        let plain = String(content.characters)
        let lowercased = plain.lowercased()
        guard lowercased.hasPrefix("[x] ") || lowercased.hasPrefix("[ ] ") else {
            return nil
        }
        let checked = lowercased.hasPrefix("[x] ")
        let end = content.characters.index(content.startIndex, offsetBy: 4)
        content.removeSubrange(content.startIndex..<end)
        return checked
    }
}
private struct ConversationComposer: View {
    @ObservedObject var store: CockpitStore
    @Environment(\.accessibilityReduceMotion) private var reduceMotion
    let session: SessionRecord
    @Binding var draft: String
    @Binding var attachments: [ComposerAttachment]
    @Binding var serviceTier: CodexServiceTierOverride
    let onOpenRun: () -> Void
    @State private var attachmentError: String?
    @State private var submittingSessionIDs: Set<String> = []
    @State private var confirmStop = false
    @State private var stopRunID: String?
    @State private var showingActivityTrail = false

    private var submitting: Bool {
        submittingSessionIDs.contains(session.id) || store.sendingSessionIDs.contains(session.id)
    }

    private var continuationBusy: Bool {
        submitting
    }

    private var attachmentMutationDisabled: Bool {
        !session.resumeCapable && !session.connected
    }

    private var canSend: Bool {
        (session.resumeCapable || session.connected)
            && !continuationBusy
            && (
                !draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
                || !attachments.isEmpty
            )
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            if store.uncertainSessionIDs.contains(session.id) {
                HStack(alignment: .top, spacing: 10) {
                    Label("Acknowledgement unconfirmed. The original message ID is saved; your draft is still editable.", systemImage: "exclamationmark.triangle")
                    Spacer()
                    Button("Retry saved message") {
                        let sessionID = session.id
                        Task { await store.retryPendingMessage(sessionID: sessionID) }
                    }
                    .disabled(submitting)
                }
                .font(.caption)
                .foregroundStyle(.orange)
                .padding(.horizontal, 18)
                .padding(.vertical, 9)
            }
            if let receipt = store.sessionContinuation, receipt.sessionID == session.id {
                HStack(alignment: .top, spacing: 8) {
                    if receipt.isActive && receipt.status != "queued" {
                        ProgressView()
                            .controlSize(.small)
                            .tint(receiptColor(receipt))
                            .padding(.top, 1)
                            .accessibilityLabel("Provider is working")
                    } else {
                        Image(systemName: receiptSymbol(receipt))
                            .foregroundStyle(receiptColor(receipt))
                            .padding(.top, 1)
                    }
                    VStack(alignment: .leading, spacing: 2) {
                        Text(receiptMessage(receipt))
                            .font(.caption.weight(.medium))
                            .contentTransition(.opacity)
                            .animation(
                                reduceMotion ? nil : .easeInOut(duration: 0.18),
                                value: receipt.activity?.revision
                            )
                        if receipt.isActive && receipt.status != "queued" {
                            TimelineView(.periodic(from: .now, by: 1)) { context in
                                Text(receiptLiveDetail(receipt, at: context.date))
                                    .font(.system(.caption2, design: .monospaced))
                                    .foregroundStyle(.secondary)
                            }
                        } else {
                            Text(receiptDetail(receipt))
                                .font(.caption2)
                                .foregroundStyle(.secondary)
                        }
                    }
                    Spacer()
                    HStack(spacing: 10) {
                        if let activity = receipt.activity, !activity.events.isEmpty {
                            Button {
                                showingActivityTrail.toggle()
                            } label: {
                                Label("Activity", systemImage: "list.bullet")
                            }
                            .buttonStyle(.plain)
                            .font(.caption.weight(.semibold))
                            .help("Show provider activity")
                            .accessibilityLabel("Show provider activity trail")
                            .popover(isPresented: $showingActivityTrail, arrowEdge: .top) {
                                ActivityTrailPopover(activity: activity)
                            }
                        }
                        if let run = store.selectedContinuationRun, run.isRunning {
                            Button(role: .destructive) {
                                stopRunID = run.id
                                confirmStop = true
                            } label: {
                                if store.killingRun {
                                    ProgressView().controlSize(.small)
                                } else {
                                    Text("Stop")
                                }
                            }
                            .buttonStyle(.plain)
                            .font(.caption.weight(.semibold))
                            .disabled(store.killingRun)
                            .accessibilityLabel("Stop this continuation")
                        }
                        if receipt.runID != nil {
                            Button("View run") {
                                store.selectedRunID = receipt.runID
                                onOpenRun()
                            }
                                .buttonStyle(.plain)
                                .font(.caption.weight(.semibold))
                        }
                    }
                }
                .padding(.horizontal, 18)
                .padding(.vertical, 8)
                .background(receiptColor(receipt).opacity(0.08))
                .accessibilityElement(children: .contain)
                Divider().overlay(OpsPalette.hairline)
            }
            ComposerTextEditor(
                text: $draft,
                isEditable: !attachmentMutationDisabled,
                canSubmit: canSend,
                accessibilityLabel: "Message",
                accessibilityHelp: "Press Return to send. Press Shift-Return or Option-Return for a new line. Paste an image to attach it.",
                onSubmit: send,
                onPasteImages: importPastedImages
            )
                .frame(minHeight: 74, idealHeight: 92, maxHeight: 150)
                .overlay(alignment: .topLeading) {
                    if draft.isEmpty {
                        Text("Continue this conversation…")
                            .font(.system(size: 13.5))
                            .foregroundStyle(.tertiary)
                            .padding(.leading, 18)
                            .padding(.top, 18)
                            .allowsHitTesting(false)
                    }
                }
            if !attachments.isEmpty {
                ScrollView(.horizontal, showsIndicators: false) {
                    HStack(spacing: 9) {
                        ForEach(attachments) { attachment in
                            attachmentChip(attachment)
                        }
                    }
                    .padding(.horizontal, 16)
                    .padding(.vertical, 7)
                }
                .background(OpsPalette.raised.opacity(0.45))
                .accessibilityElement(children: .contain)
                .accessibilityLabel(
                    "\(attachments.count) image attachment\(attachments.count == 1 ? "" : "s")"
                )
                Divider().overlay(OpsPalette.hairline)
            }
            HStack(spacing: 10) {
                VStack(alignment: .leading, spacing: 2) {
                    Text(attachmentError ?? safetyCaption)
                        .font(.caption)
                        .foregroundStyle(
                            attachmentError == nil && (session.resumeCapable || session.connected)
                                ? OpsPalette.quiet
                                : Color.orange
                        )
                        .accessibilityLabel(
                            attachmentError.map { "Attachment error: \($0)" } ?? safetyCaption
                        )
                    Text(composerShortcutCaption)
                        .font(.caption2)
                        .foregroundStyle(.tertiary)
                }
                Spacer()
                Button(action: chooseImages) {
                    Image(systemName: "paperclip")
                }
                .buttonStyle(.plain)
                .help("Attach images")
                .accessibilityLabel("Attach images")
                .disabled(attachments.count >= 8 || attachmentMutationDisabled)
                if session.provider == "codex" {
                    Picker("Service", selection: $serviceTier) {
                        ForEach(CodexServiceTierOverride.allCases) { value in
                            Text(value.displayName).tag(value)
                        }
                    }
                    .pickerStyle(.menu)
                    .controlSize(.small)
                    .frame(width: 145)
                    .help(continuationServiceTierHelp)
                    .accessibilityLabel("Codex continuation service tier")
                    .disabled(attachmentMutationDisabled)
                }
                Button(action: send) {
                    HStack(spacing: 7) {
                        if continuationBusy {
                            ProgressView().controlSize(.small)
                        }
                        Image(systemName: "arrow.up")
                        Text(
                            submitting ? "Saving"
                            : store.sessionContinuationInFlight ? "Queue"
                            : "Send"
                        )
                    }
                }
                .buttonStyle(.borderedProminent)
                .disabled(!canSend)
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 10)
            .background(OpsPalette.raised)
        }
        .background(OpsPalette.background)
        .onChange(of: session.id) { _, _ in
            setAttachmentError(nil)
            showingActivityTrail = false
        }
        .confirmationDialog(
            "Stop this continuation?",
            isPresented: $confirmStop,
            titleVisibility: .visible
        ) {
            Button("Stop continuation", role: .destructive) {
                stopContinuation()
            }
        } message: {
            Text("Subfleet will stop the provider process and preserve any output already written.")
        }
    }

    @ViewBuilder
    private func attachmentChip(_ attachment: ComposerAttachment) -> some View {
        HStack(spacing: 7) {
            if let preview = attachment.preview {
                Image(nsImage: preview)
                    .resizable()
                    .scaledToFill()
                    .frame(width: 42, height: 42)
                    .clipShape(RoundedRectangle(cornerRadius: 6))
                    .accessibilityHidden(true)
            }
            Text(attachment.displayName)
                .font(.caption2)
                .lineLimit(1)
                .frame(maxWidth: 130)
                .accessibilityLabel("\(attachment.displayName), image attachment")
            Button {
                ComposerAttachmentStore.remove(attachment)
                attachments.removeAll { $0.id == attachment.id }
                setAttachmentError(nil)
            } label: {
                Image(systemName: "xmark.circle.fill")
                    .foregroundStyle(.secondary)
            }
            .buttonStyle(.plain)
            .accessibilityLabel("Remove \(attachment.displayName)")
            .disabled(attachmentMutationDisabled)
        }
        .padding(5)
        .background(OpsPalette.background, in: RoundedRectangle(cornerRadius: 8))
        .help(attachment.displayName)
        .accessibilityElement(children: .contain)
    }

    private func send() {
        guard canSend else { return }
        let message = draft
        let sendingSession = session
        let sendingDraftBinding = $draft
        let sendingAttachmentsBinding = $attachments
        let sendingAttachments = attachments
        let sendingServiceTier = serviceTier
        ComposerAttachmentStore.beginUsing(sendingAttachments)
        submittingSessionIDs.insert(sendingSession.id)
        Task {
            var removeSendingFiles = false
            defer {
                ComposerAttachmentStore.finishUsing(
                    sendingAttachments,
                    removingFiles: removeSendingFiles
                )
                submittingSessionIDs.remove(sendingSession.id)
            }
            if await store.continueSelectedSession(
                session: sendingSession,
                prompt: message,
                imageURLs: sendingAttachments.map(\.url),
                serviceTier: sendingServiceTier
            ) {
                removeSendingFiles = true
                // Do not erase a newly typed draft or the draft belonging to
                // a conversation selected during the short acknowledgement.
                if sendingDraftBinding.wrappedValue == message {
                    sendingDraftBinding.wrappedValue = ""
                }
                let sentIDs = Set(sendingAttachments.map(\.id))
                sendingAttachmentsBinding.wrappedValue.removeAll { sentIDs.contains($0.id) }
                if session.id == sendingSession.id { setAttachmentError(nil) }
            }
        }
    }

    private func importPastedImages(_ pasteboard: NSPasteboard) -> Bool {
        if attachmentMutationDisabled {
            return ComposerAttachmentStore.containsImage(pasteboard)
        }
        do {
            let imported = try ComposerAttachmentStore.importFromPasteboard(pasteboard)
            guard !imported.isEmpty else { return false }
            let available = max(0, 8 - attachments.count)
            let accepted = Array(imported.prefix(available))
            ComposerAttachmentStore.remove(Array(imported.dropFirst(available)))
            attachments.append(contentsOf: accepted)
            setAttachmentError(
                accepted.count == imported.count
                    ? nil
                    : "A message can include at most 8 images."
            )
            return true
        } catch {
            setAttachmentError("Could not attach that image: \(error.localizedDescription)")
            // Import can throw only after recognizing image content. Consume
            // that paste so AppKit does not insert an image URL or alt text.
            return true
        }
    }

    private func chooseImages() {
        guard !attachmentMutationDisabled else { return }
        let panel = NSOpenPanel()
        panel.title = "Attach images"
        panel.allowsMultipleSelection = true
        panel.canChooseDirectories = false
        panel.canChooseFiles = true
        panel.allowedContentTypes = [.png, .jpeg, .gif, .webP]
        guard panel.runModal() == .OK else { return }
        guard !attachmentMutationDisabled else { return }
        do {
            let available = max(0, 8 - attachments.count)
            let imported = try ComposerAttachmentStore.importURLs(Array(panel.urls.prefix(available)))
            attachments.append(contentsOf: imported)
            setAttachmentError(
                panel.urls.count <= available
                    ? nil
                    : "A message can include at most 8 images."
            )
        } catch {
            setAttachmentError("Could not attach that image: \(error.localizedDescription)")
        }
    }

    private func setAttachmentError(_ message: String?) {
        attachmentError = message
        guard let message else { return }
        NSAccessibility.post(
            element: NSApp as Any,
            notification: .announcementRequested,
            userInfo: [
                .announcement: message,
                .priority: NSAccessibilityPriorityLevel.high.rawValue,
            ]
        )
    }

    private var safetyCaption: String {
        if let blocker = session.continuationBlocker { return blocker }
        if !session.resumeCapable && !session.connected {
            return "This local session cannot be resumed."
        }
        if session.provider == "codex" {
            return "Resumes \(session.displayName) as \(session.accountLabel) · \(serviceTier.routeLabel) · \(session.sandboxMode ?? "provider sandbox")"
        }
        if session.connected {
            return "Uses the current live Claude account; confirmed limits auto-switch the same session · \(session.permissionMode ?? "recorded permissions")"
        }
        return "Resumes \(session.displayName) on the best available Claude subscription · \(session.permissionMode ?? "recorded permissions")"
    }

    private var continuationServiceTierHelp: String {
        switch serviceTier {
        case .inherit:
            return "Resume with this account's configured service tier. The recorded model and reasoning stay unchanged."
        case .fast:
            return "Resume with Codex Fast. GPT-5.6 uses 2.5× credits; the recorded model and reasoning stay unchanged."
        case .standard:
            return "Resume with Codex Standard, even if this account defaults to Fast. The recorded model and reasoning stay unchanged."
        }
    }

    private var composerShortcutCaption: String {
        if let run = store.selectedContinuationRun, run.isRunning {
            return "Queue the next message while \(modelDisplayName(run.model)) works · Shift/Option-Return for new line · paste images"
        }
        return "Return to send · Shift/Option-Return for new line · paste images"
    }

    private func stopContinuation() {
        guard let runID = stopRunID else { return }
        store.selectedRunID = runID
        Task { await store.killSelectedRun(expectedID: runID) }
    }

    private func receiptSymbol(_ receipt: SessionContinuationReceipt) -> String {
        switch receipt.status {
        case "queued": return "clock.fill"
        case "starting": return "bolt.horizontal.circle.fill"
        case "delivered-live": return "paperplane.circle.fill"
        case "finished": return "checkmark.circle.fill"
        case "cancelled": return "xmark.circle"
        case "error", "delivery-unknown": return "exclamationmark.triangle.fill"
        default: break
        }
        guard let run = store.selectedContinuationRun else { return "bolt.horizontal.circle.fill" }
        if run.isRunning { return "bolt.horizontal.circle.fill" }
        return run.completedSuccessfully
            ? "checkmark.circle.fill"
            : "exclamationmark.triangle.fill"
    }

    private func receiptColor(_ receipt: SessionContinuationReceipt) -> Color {
        if ["error", "delivery-unknown"].contains(receipt.status) { return .orange }
        if receipt.status == "finished" { return .green }
        if ["queued", "starting", "delivered-live"].contains(receipt.status) { return OpsPalette.accent }
        if receipt.status == "cancelled" { return .secondary }
        guard let run = store.selectedContinuationRun else { return OpsPalette.accent }
        if run.isRunning { return OpsPalette.accent }
        return run.completedSuccessfully ? .green : .orange
    }

    private func receiptMessage(_ receipt: SessionContinuationReceipt) -> String {
        if receipt.isActive, receipt.status != "queued", let current = receipt.activity?.current {
            return current.label
        }
        switch receipt.status {
        case "queued": return "Saved locally and queued for this conversation."
        case "starting": return "Starting \(receipt.provider.capitalized) on the selected subscription."
        case "finished": return "\(receipt.provider.capitalized) finished this message."
        case "error", "delivery-unknown", "cancelled": return receipt.message
        default: break
        }
        if receipt.status == "delivered-live" {
            return "Message handed to the live \(receipt.provider.capitalized) session."
        }
        guard let run = store.selectedContinuationRun else {
            return "Provider dispatch acknowledged; waiting for run activity."
        }
        let worker = receiptWorker(receipt, run: run)
        if run.isRunning {
            return "\(worker) accepted the message and is still working."
        }
        if run.isOrphaned {
            return "\(worker) stopped without recording a final result."
        }
        if run.completedSuccessfully {
            return "\(worker) finished successfully; the final response is in the transcript."
        }
        if run.status.uppercased() == "FINISHED", let resultCode = run.resultCode {
            return "\(worker) ended with exit code \(resultCode) before a successful final response."
        }
        return "\(worker) returned \(run.status.lowercased()) without a successful final response."
    }

    private func receiptLiveDetail(
        _ receipt: SessionContinuationReceipt,
        at date: Date
    ) -> String {
        let worker = store.selectedContinuationRun.map { receiptWorker(receipt, run: $0) }
            ?? receipt.provider.capitalized
        let start = parsedISODate(store.selectedContinuationRun?.startedAt)
            ?? parsedISODate(receipt.createdAt)
        var parts = [worker]
        if let start {
            parts.append("\(durationText(max(0, date.timeIntervalSince(start)))) elapsed")
        }
        let queued = (store.sessionOutbox[session.id] ?? []).filter { $0.status == "queued" }.count
        if queued > 0 { parts.append("\(queued) queued next") }
        return parts.joined(separator: " · ")
    }

    private func receiptDetail(_ receipt: SessionContinuationReceipt) -> String {
        if receipt.resolution == "handled" {
            return "You marked this uncertain delivery handled. Subfleet did not replay the message or undo any provider work."
        }
        switch receipt.status {
        case "queued": return "You can keep typing. This message starts after the preceding turn finishes."
        case "starting": return "Authentication and provider startup happen in the background; your composer stays available."
        case "delivery-unknown": return "Subfleet will not replay this message automatically. Check the transcript before sending it again."
        case "error": return "The saved message remains above. Inspect the error before copying it into a new send."
        case "cancelled": return "This queued message will not be sent. Its text is preserved above."
        case "finished": return "The provider recorded a final result; the transcript refreshes independently."
        default: break
        }
        if receipt.status == "delivered-live" {
            return "Latest transcript activity \(sessionAge(session.updatedAtMilliseconds)); watch the transcript for the final response."
        }
        guard let run = store.selectedContinuationRun else {
            return "The outbox is tracking this message. You can queue another draft while the provider works."
        }
        if run.isRunning {
            let elapsed = continuationElapsed(run).map { " · \($0) elapsed" } ?? ""
            return "Latest transcript activity \(sessionAge(session.updatedAtMilliseconds))\(elapsed) · waiting for the final response."
        }
        if run.isOrphaned {
            return "Transcript or saved output may be partial; inspect the run before retrying."
        }
        if run.completedSuccessfully {
            return run.duration.map { "Completed in \(durationText($0))." }
                ?? "The provider recorded a successful final response."
        }
        return "Inspect the saved output and error log before retrying."
    }

    private func receiptWorker(
        _ receipt: SessionContinuationReceipt,
        run: RunRecord
    ) -> String {
        let provider = receipt.provider.capitalized
        return run.model == "unknown"
            ? provider
            : "\(provider) · \(modelDisplayName(run.model))"
    }

    private func modelDisplayName(_ model: String) -> String {
        var parts = model.split(separator: "-").map(String.init)
        if parts.first?.lowercased() == "claude" { parts.removeFirst() }
        return parts.map { part in
            part.lowercased() == "gpt" ? "GPT" : part.capitalized
        }.joined(separator: " ")
    }

    private func continuationElapsed(_ run: RunRecord) -> String? {
        if let duration = run.duration { return durationText(duration) }
        guard let started = parsedISODate(run.startedAt) else { return nil }
        return durationText(max(0, Date().timeIntervalSince(started)))
    }
}

private struct ActivityTrailPopover: View {
    let activity: SessionActivity

    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            VStack(alignment: .leading, spacing: 3) {
                Text("Activity")
                    .font(.headline)
                Text("Provider commentary and safe action summaries—not hidden reasoning.")
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }
            Divider().overlay(OpsPalette.hairline)
            ScrollView {
                LazyVStack(alignment: .leading, spacing: 0) {
                    ForEach(Array(activity.events.suffix(12).reversed())) { event in
                        HStack(alignment: .top, spacing: 9) {
                            Image(systemName: activitySymbol(event.kind))
                                .frame(width: 14)
                                .foregroundStyle(
                                    event.sequence == activity.current.sequence
                                        ? OpsPalette.accent
                                        : Color.secondary
                                )
                            VStack(alignment: .leading, spacing: 2) {
                                Text(event.label)
                                    .font(.caption.weight(
                                        event.sequence == activity.current.sequence ? .semibold : .regular
                                    ))
                                    .fixedSize(horizontal: false, vertical: true)
                                Text(relativeTimestamp(event.occurredAt))
                                    .font(.system(.caption2, design: .monospaced))
                                    .foregroundStyle(.tertiary)
                            }
                            Spacer(minLength: 0)
                        }
                        .padding(.vertical, 7)
                        .accessibilityElement(children: .combine)
                        if event.id != activity.events.first?.id {
                            Divider().overlay(OpsPalette.hairline)
                        }
                    }
                }
            }
            .frame(maxHeight: 240)
        }
        .padding(16)
        .frame(width: 340)
    }

    private func activitySymbol(_ kind: String) -> String {
        switch kind {
        case "status": return "waveform.path.ecg"
        case "commentary", "response": return "text.bubble"
        case "thinking": return "brain"
        case "tool": return "wrench.and.screwdriver"
        case "search": return "magnifyingglass"
        case "read": return "doc.text.magnifyingglass"
        case "edit": return "pencil.line"
        case "command": return "terminal"
        case "plan": return "list.bullet.clipboard"
        case "attention": return "exclamationmark.triangle"
        case "error": return "xmark.octagon"
        case "completed": return "checkmark.circle"
        default: return "circle.fill"
        }
    }
}

private struct HistoryView: View {
    @ObservedObject var store: CockpitStore

    var body: some View {
        VStack(spacing: 0) {
            HStack {
                VStack(alignment: .leading, spacing: 3) {
                    Text("Task lineage")
                        .font(.system(size: 24, weight: .semibold, design: .rounded))
                    Text("Read-only groups of related Subfleet agent runs from Logpile")
                        .font(.callout)
                        .foregroundStyle(.secondary)
                }
                Spacer()
                Label("Read only", systemImage: "lock.open.display")
                    .font(.caption)
                    .foregroundStyle(.secondary)
                Button {
                    Task { await store.refreshHistory() }
                } label: {
                    if store.loadingHistory { ProgressView().controlSize(.small) }
                    else { Image(systemName: "arrow.clockwise") }
                }
                .buttonStyle(.plain)
                .help("Refresh Logpile history")
            }
            .padding(.horizontal, 24)
            .padding(.vertical, 19)
            Divider().overlay(OpsPalette.hairline)

            if store.historyTasks.isEmpty && !store.loadingHistory {
                ContentUnavailableView {
                    Label(
                        store.resolvedLogpilePath == nil ? "Logpile not connected" : "No unified tasks yet",
                        systemImage: "clock.arrow.trianglehead.counterclockwise.rotate.90"
                    )
                } description: {
                    Text(store.resolvedLogpilePath == nil
                         ? "Set a Logpile executable in Runtime to enable read-only history."
                         : "Logpile is connected. Its local Subfleet task catalog is currently empty.")
                }
            } else {
                ScrollView {
                    LazyVStack(spacing: 0) {
                        ForEach(store.historyTasks) { task in
                            HistoryRow(task: task)
                            Divider().overlay(OpsPalette.hairline).padding(.leading, 24)
                        }
                    }
                }
            }
        }
    }
}

private struct HistoryRow: View {
    let task: HistoryTask

    var body: some View {
        HStack(alignment: .top, spacing: 14) {
            providerMark
            VStack(alignment: .leading, spacing: 6) {
                Text(task.id)
                    .font(.system(size: 12, weight: .medium, design: .monospaced))
                    .textSelection(.enabled)
                    .lineLimit(1)
                HStack(spacing: 13) {
                    Label("\(task.runCount) runs", systemImage: "bolt.horizontal")
                    Label("\(task.attemptCount) attempts", systemImage: "arrow.triangle.2.circlepath")
                    if task.handoffCount > 0 {
                        Label("\(task.handoffCount) handoffs", systemImage: "arrow.left.arrow.right")
                    }
                }
                .font(.caption2)
                .foregroundStyle(.secondary)
            }
            Spacer()
            VStack(alignment: .trailing, spacing: 5) {
                if let outcome = task.outcome {
                    Text(outcome.uppercased())
                        .font(.system(size: 9, weight: .bold, design: .rounded))
                        .tracking(0.7)
                        .foregroundStyle(historyOutcomeColor(task))
                }
                Text(relativeTimestamp(task.lastAt))
                    .font(.caption2)
                    .foregroundStyle(.tertiary)
                Text(task.providers.isEmpty ? "unknown" : task.providers.joined(separator: " → "))
                    .font(.system(.caption2, design: .monospaced))
                    .foregroundStyle(OpsPalette.accent)
            }
        }
        .padding(.horizontal, 24)
        .padding(.vertical, 14)
    }

    private var providerMark: some View {
        ZStack {
            Circle().fill(OpsPalette.accent.opacity(0.13)).frame(width: 31, height: 31)
            Image(systemName: task.providers.count > 1 ? "arrow.left.arrow.right" : "clock.arrow.circlepath")
                .font(.system(size: 11, weight: .semibold))
                .foregroundStyle(OpsPalette.accent)
        }
    }
}

private func runStatusColor(_ run: RunRecord) -> Color {
    if run.isRunning { return OpsPalette.accent }
    if run.completedSuccessfully { return .green }
    if run.status.uppercased() == "ORPHANED" { return .orange }
    return .red
}

private func historyOutcomeColor(_ task: HistoryTask) -> Color {
    if task.exitCode == 0 || task.outcome?.lowercased() == "finished" { return .green }
    if task.outcome?.lowercased() == "running" { return OpsPalette.accent }
    return .orange
}

private func shortPath(_ path: String) -> String {
    path.replacingOccurrences(of: FileManager.default.homeDirectoryForCurrentUser.path, with: "~")
}

private func durationText(_ seconds: Double) -> String {
    if seconds < 60 { return String(format: "%.0fs", seconds) }
    if seconds < 3600 { return String(format: "%dm %02ds", Int(seconds) / 60, Int(seconds) % 60) }
    return String(format: "%dh %02dm", Int(seconds) / 3600, (Int(seconds) % 3600) / 60)
}

private func parsedISODate(_ iso: String?) -> Date? {
    guard let iso else { return nil }
    let precise = ISO8601DateFormatter()
    precise.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
    let standard = ISO8601DateFormatter()
    standard.formatOptions = [.withInternetDateTime]
    return precise.date(from: iso) ?? standard.date(from: iso)
}

private func capacityPercent(_ value: Double) -> String {
    if value > 0, value < 1 { return "<1%" }
    return String(format: "%.0f%%", value)
}

private func capacityDate(_ iso: String) -> Date? {
    let precise = ISO8601DateFormatter()
    precise.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
    let standard = ISO8601DateFormatter()
    standard.formatOptions = [.withInternetDateTime]
    return precise.date(from: iso) ?? standard.date(from: iso)
}

private func capacityResetLabel(_ iso: String) -> String {
    guard let date = capacityDate(iso) else { return iso }
    let formatter = DateFormatter()
    formatter.locale = .current
    if Calendar.current.isDateInToday(date) {
        formatter.dateFormat = "'Today' h:mm a"
    } else if Calendar.current.isDateInTomorrow(date) {
        formatter.dateFormat = "'Tomorrow' h:mm a"
    } else {
        formatter.dateFormat = "EEE MMM d, h:mm a"
    }
    return formatter.string(from: date)
}

private func capacityFullDate(_ iso: String) -> String {
    guard let date = capacityDate(iso) else { return iso }
    let formatter = DateFormatter()
    formatter.locale = .current
    formatter.dateStyle = .full
    formatter.timeStyle = .long
    return formatter.string(from: date)
}

private func capacityAccountHelp(
    _ account: CapacityAccount,
    resetAt: String?,
    stale: Bool
) -> String {
    func window(_ label: String, _ value: CapacityUsageWindow) -> String? {
        guard value.hasEvidence else { return nil }
        var details: [String] = []
        if let used = value.usedPercent { details.append("\(capacityPercent(used)) used") }
        if let reset = value.resetAt { details.append("resets \(capacityFullDate(reset))") }
        if let confidence = value.confidence { details.append(confidence) }
        return "\(label): " + (details.isEmpty ? "usage unknown" : details.joined(separator: " · "))
    }

    var lines = [account.email, account.family.capitalized]
    if let home = account.home { lines.append(shortPath(home)) }
    if let fiveHour = window("5-hour", account.fiveHour) { lines.append(fiveHour) }
    if let weekly = window("Overall weekly", account.weekly) { lines.append(weekly) }
    for (name, value) in account.modelWindows.sorted(by: { $0.key < $1.key }) {
        let label = name.replacingOccurrences(of: "_", with: " ").capitalized
        if let detail = window("\(label) weekly", value) { lines.append(detail) }
    }
    for limit in account.scopedLimits {
        guard let model = limit.scopeModel else { continue }
        var details: [String] = []
        if let percent = limit.percent { details.append("\(capacityPercent(percent)) used") }
        if let reset = limit.resetAt { details.append("resets \(capacityFullDate(reset))") }
        if let severity = limit.severity { details.append(severity) }
        if limit.isActive { details.append("active limit") }
        lines.append("\(model) weekly: " + details.joined(separator: " · "))
    }
    if let resetAt, !account.dispatchable {
        lines.append("Available: \(capacityFullDate(resetAt))")
    }
    if account.inFlight > 0 { lines.append("\(account.inFlight) active runs") }
    if account.family.lowercased() == "claude",
       account.dispatchable,
       account.headroom == nil
    {
        lines.append("Model capacity is unverified; Subfleet runs a live model probe before sending.")
    }
    if let confidence = account.confidence { lines.append("Account confidence: \(confidence)") }
    if let probe = account.probeStatus, probe != "ok" { lines.append("Probe: \(probe)") }
    if stale { lines.append("Stale capacity reading") }
    return lines.joined(separator: "\n")
}

private func relativeTimestamp(_ iso: String?) -> String {
    guard let iso else { return "—" }
    let formatters: [ISO8601DateFormatter] = {
        let precise = ISO8601DateFormatter()
        precise.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
        let standard = ISO8601DateFormatter()
        standard.formatOptions = [.withInternetDateTime]
        return [precise, standard]
    }()
    guard let date = formatters.lazy.compactMap({ $0.date(from: iso) }).first else { return iso }
    return RelativeDateTimeFormatter().localizedString(for: date, relativeTo: Date())
}

private func sessionAge(_ milliseconds: Double?) -> String {
    guard let milliseconds else { return "time unknown" }
    let date = Date(timeIntervalSince1970: milliseconds / 1000)
    return RelativeDateTimeFormatter().localizedString(for: date, relativeTo: Date())
}

private func messageClock(_ iso: String) -> String {
    let precise = ISO8601DateFormatter()
    precise.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
    let standard = ISO8601DateFormatter()
    standard.formatOptions = [.withInternetDateTime]
    guard let date = precise.date(from: iso) ?? standard.date(from: iso) else { return iso }
    return date.formatted(date: .omitted, time: .shortened)
}

private func copyToPasteboard(_ value: String) {
    NSPasteboard.general.clearContents()
    NSPasteboard.general.setString(value, forType: .string)
}
