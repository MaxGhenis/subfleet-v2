// Standalone contract tests: compile with ../SubfleetCLI.swift and ../CockpitStore.swift.
// Uses only a private fake Unix socket; it never launches a provider or real broker.
import Foundation
import Darwin

private final class FakeBroker: @unchecked Sendable {
    private let lock = NSLock()
    private var records: [String: [String: Any]] = [:]
    private var seenRequests: [[String: Any]] = []
    private var dropped: Set<String> = []
    private let descriptor: Int32

    init(path: String) throws {
        descriptor = Darwin.socket(AF_UNIX, SOCK_STREAM, 0)
        precondition(descriptor >= 0)
        var address = sockaddr_un()
        address.sun_family = sa_family_t(AF_UNIX)
        address.sun_len = UInt8(MemoryLayout.size(ofValue: address))
        let bytes = Array(path.utf8CString).map { UInt8(bitPattern: $0) }
        precondition(bytes.count <= MemoryLayout.size(ofValue: address.sun_path))
        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: bytes) }
        let result = withUnsafePointer(to: &address) { pointer in
            pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                Darwin.bind(descriptor, $0, socklen_t(MemoryLayout<sockaddr_un>.size))
            }
        }
        precondition(result == 0 && Darwin.listen(descriptor, 16) == 0)
        Thread.detachNewThread { [self] in serve() }
    }

    func stop() { Darwin.shutdown(descriptor, SHUT_RDWR); Darwin.close(descriptor) }

    func requests() -> [[String: Any]] {
        lock.lock(); defer { lock.unlock() }
        return seenRequests
    }

    private func serve() {
        while true {
            let client = Darwin.accept(descriptor, nil, nil)
            if client < 0 { return }
            var data = Data()
            var buffer = [UInt8](repeating: 0, count: 4096)
            while !data.contains(10) {
                let count = Darwin.recv(client, &buffer, buffer.count, 0)
                if count <= 0 { break }
                data.append(contentsOf: buffer.prefix(count))
            }
            guard let request = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                Darwin.close(client); continue
            }
            let response = handle(request)
            if let response, let output = try? JSONSerialization.data(withJSONObject: response) {
                let bytes = output + Data([10])
                bytes.withUnsafeBytes { pointer in
                    // Exercise client reads spanning multiple response chunks.
                    let first = pointer.count / 2
                    _ = Darwin.send(client, pointer.baseAddress!, first, 0)
                    _ = Darwin.send(client, pointer.baseAddress!.advanced(by: first), pointer.count - first, 0)
                }
            }
            Darwin.close(client)
        }
    }

    private func handle(_ request: [String: Any]) -> [String: Any]? {
        lock.lock(); defer { lock.unlock() }
        seenRequests.append(request)
        let op = request["op"] as? String ?? ""
        let id = request["message_id"] as? String ?? ""
        if op == "list" {
            let sessionID = request["session_id"] as? String
            return ["kind": "subfleet.outbox", "schema_version": 1, "ok": true,
                    "messages": records.values.filter { sessionID == nil || $0["session_id"] as? String == sessionID }]
        }
        if op == "get" {
            return records[id] ?? ["kind": "subfleet.session-continuation", "schema_version": 1,
                                   "ok": false, "accepted": false, "code": "message-not-found", "message": "Not admitted"]
        }
        if op == "cancel", var row = records[id] {
            row["status"] = "cancelled"
            row["message"] = "Cancelled before provider delivery"
            records[id] = row
            return row
        }
        if op == "enqueue" {
            let prompt = request["prompt"] as? String ?? ""
            if prompt == "reject" {
                return ["kind": "subfleet.session-continuation", "schema_version": 1,
                        "ok": false, "accepted": false, "code": "test-validation", "message": "Invalid test message"]
            }
            if let existing = records[id] { return existing }
            if prompt == "missing-ack", !dropped.contains(id) {
                dropped.insert(id)
                return nil
            }
            let sessionID = request["session_id"] as? String ?? ""
            let row: [String: Any] = [
                "kind": "subfleet.session-continuation", "schema_version": 1, "ok": true, "accepted": true,
                "message_id": id, "session_id": sessionID, "provider": sessionID.components(separatedBy: ":")[0],
                "status": "queued", "message": "Saved locally", "prompt": prompt,
                "attachment_count": (request["image_paths"] as? [String])?.count ?? 0,
                "created_at": "2026-08-31T14:00:00.000Z",
            ]
            records[id] = row
            if prompt == "drop-ack" { return nil }
            return row
        }
        return ["kind": "subfleet.broker", "schema_version": 1, "ok": true]
    }
}

@main
private struct BrokerClientTests {
    @MainActor
    static func main() async throws {
        let root = URL(fileURLWithPath: "/tmp/sf-swift-" + UUID().uuidString.lowercased(), isDirectory: true)
        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false,
                                                attributes: [.posixPermissions: 0o700])
        defer { try? FileManager.default.removeItem(at: root) }
        let socket = root.appendingPathComponent("broker.sock").path
        setenv("SUBFLEET_STATE_DIR", root.path, 1)
        setenv("SUBFLEET_BROKER_SOCKET", socket, 1)
        let server = try FakeBroker(path: socket)
        defer { server.stop() }

        func session(_ id: String) -> SessionRecord {
            SessionRecord.decode(["id": id, "native_id": id.components(separatedBy: ":")[1],
                                  "provider": id.components(separatedBy: ":")[0], "display_name": "Fixture",
                                  "profile": ["home_ref": "fixture"], "resume_capable": true])!
        }
        let first = session("codex:first")
        let second = session("claude:second")
        let store = CockpitStore()
        store.sessions = [first, second]
        store.selectedSessionID = second.id
        let started = Date()
        let accepted = await store.continueSelectedSession(session: first, prompt: "Hi\n世界", serviceTier: .fast)
        precondition(accepted && store.sessionOutbox[first.id]?.count == 1)
        precondition(store.selectedSessionID == second.id, "A send must not alter the current selection")
        precondition(server.requests().last?["service_tier"] as? String == "fast")
        precondition(server.requests().last?["model"] == nil, "Fast must not override model")
        print("Direct durable acknowledgement: \(Int(Date().timeIntervalSince(started) * 1000)) ms")
        let next = await store.continueSelectedSession(session: first, prompt: "Next queued turn")
        precondition(next && store.sessionOutbox[first.id]?.count == 2, "Running/queued work must not lock composing")

        let invalid = await store.continueSelectedSession(session: second, prompt: "reject")
        precondition(!invalid && !store.uncertainSessionIDs.contains(second.id))
        let dropped = await store.continueSelectedSession(session: second, prompt: "drop-ack")
        precondition(!dropped && store.uncertainSessionIDs.contains(second.id))
        let originalID = server.requests().last?["message_id"] as! String
        let journal = root.appendingPathComponent("cockpit-client/pending-messages.json")
        let mode = try FileManager.default.attributesOfItem(atPath: journal.path)[.posixPermissions] as! NSNumber
        precondition(mode.intValue == 0o600, "Pending prompts must be private")

        let reopened = CockpitStore()
        reopened.sessions = [first, second]
        reopened.selectedSessionID = second.id
        precondition(reopened.uncertainSessionIDs.contains(second.id), "Stable IDs survive an app restart")
        await reopened.refreshOutbox(allSessions: true)
        let resolved = await reopened.continueSelectedSession(session: second, prompt: "drop-ack")
        precondition(resolved && !reopened.uncertainSessionIDs.contains(second.id))
        precondition(server.requests().filter { $0["op"] as? String == "enqueue" && $0["message_id"] as? String == originalID }.count == 1,
                     "A lost acknowledgement must resolve by ID, never duplicate enqueue")

        let missing = await reopened.continueSelectedSession(session: second, prompt: "missing-ack")
        precondition(!missing)
        let retryID = server.requests().last?["message_id"] as! String
        await reopened.retryPendingMessage(sessionID: second.id)
        let retryRequests = server.requests().filter { $0["op"] as? String == "enqueue" && $0["message_id"] as? String == retryID }
        precondition(retryRequests.count == 2, "An explicit retry must preserve the exact message ID")
        let finallyAccepted = await reopened.continueSelectedSession(session: second, prompt: "missing-ack")
        precondition(finallyAccepted)
        precondition(server.requests().filter { $0["op"] as? String == "enqueue" && $0["message_id"] as? String == retryID }.count == 2)

        let imageSession = session("claude:images")
        let originalImage = root.appendingPathComponent("test-fixture.png")
        try Data([1, 2, 3]).write(to: originalImage)
        let imageSend = await reopened.continueSelectedSession(session: imageSession, prompt: "missing-ack", imageURLs: [originalImage])
        precondition(!imageSend)
        let snapshotPath = (server.requests().last?["image_paths"] as! [String])[0]
        precondition(snapshotPath != originalImage.path && FileManager.default.fileExists(atPath: snapshotPath))
        try FileManager.default.removeItem(at: originalImage)
        let afterImageRestart = CockpitStore()
        await afterImageRestart.retryPendingMessage(sessionID: imageSession.id)
        precondition(FileManager.default.fileExists(atPath: snapshotPath), "An unconsumed acknowledgement retains its immutable client image")
        let imageAck = await afterImageRestart.continueSelectedSession(session: imageSession, prompt: "missing-ack", imageURLs: [originalImage])
        precondition(imageAck && !FileManager.default.fileExists(atPath: snapshotPath),
                     "Lost image acknowledgements must recover even after the editable attachment is removed")

        let queued = reopened.sessionOutbox[second.id]!.last!
        await reopened.cancelQueuedMessage(queued)
        precondition(reopened.sessionOutbox[second.id]!.first { $0.id == queued.id }!.status == "cancelled")

        let receiptJSON: [String: Any] = [
            "kind": "subfleet.session-continuation", "schema_version": 1, "ok": true, "accepted": true,
            "message_id": "receipt", "native_message_id": "native", "session_id": first.id, "provider": "codex",
            "status": "dispatched", "message": "Running", "prompt": "same text",
            "created_at": "2026-08-31T14:00:00.000Z", "attachment_count": 1,
            "activity": [
                "schema_version": 1, "revision": 2,
                "current": ["sequence": 2, "kind": "command", "label": "Running a command",
                            "occurred_at": "2026-08-31T14:00:02.000Z"],
                "events": [
                    ["sequence": 1, "kind": "thinking", "label": "Thinking through your request",
                     "occurred_at": "2026-08-31T14:00:01.000Z"],
                    ["sequence": 2, "kind": "command", "label": "Running a command",
                     "occurred_at": "2026-08-31T14:00:02.000Z"],
                ],
            ],
        ]
        let receipt = try SessionContinuationReceipt.decode(receiptJSON)
        precondition(receipt.activity?.revision == 2)
        precondition(receipt.activity?.current.label == "Running a command")
        precondition(receipt.activity?.events.count == 2)
        reopened.sessionOutbox[first.id] = [receipt]
        let old = SessionMessage(id: "1-old", role: "user", text: "same text", phase: nil, createdAt: "2026-08-31T13:59:00Z")
        precondition(reopened.visibleOutboxMessages(sessionID: first.id, transcript: [old]).count == 1)
        let native = SessionMessage(id: "2-native", role: "user", text: "same text + image wrapper", phase: nil, createdAt: nil)
        precondition(reopened.visibleOutboxMessages(sessionID: first.id, transcript: [old, native]).isEmpty,
                     "Provider message IDs must reconcile image-wrapped prompts without duplicate bubbles")
        var failure = receiptJSON
        failure["status"] = "delivery-unknown"; failure["ok"] = false
        let unknown = try SessionContinuationReceipt.decode(failure)
        reopened.sessionOutbox[first.id] = [unknown]
        precondition(reopened.visibleOutboxMessages(sessionID: first.id, transcript: [native]).count == 1)
        precondition(reopened.outboxPromptIsInTranscript(unknown, transcript: [native]), "Keep error status, not duplicate prompt")

        var queuedJSON = receiptJSON
        queuedJSON["message_id"] = "queued-after-active"
        queuedJSON["native_message_id"] = NSNull()
        queuedJSON["status"] = "queued"
        queuedJSON["activity"] = NSNull()
        let queuedAfterActive = try SessionContinuationReceipt.decode(queuedJSON)
        let activeRun = RunRecord.decode([
            "id": "active-run", "family": "codex", "model": "gpt-test",
            "status": "RUNNING", "started_at": "2026-08-31T14:00:00.000Z",
        ])!
        var activeReceiptJSON = receiptJSON
        activeReceiptJSON["run_id"] = activeRun.id
        let activeReceipt = try SessionContinuationReceipt.decode(activeReceiptJSON)
        reopened.selectedSessionID = first.id
        reopened.runs = [activeRun]
        reopened.sessionOutbox[first.id] = [activeReceipt, queuedAfterActive]
        precondition(
            reopened.sessionContinuation?.messageID == activeReceipt.messageID,
            "A queued follow-up must not hide the provider turn that is actually running"
        )

        let fakeCLI = root.appendingPathComponent("fake-subfleet")
        let cliLog = root.appendingPathComponent("fake-subfleet.log")
        let script = """
        #!/bin/sh
        printf '%s\\n' "$1" >> '\(cliLog.path)'
        case "$1" in
          capacity)
            printf '%s\\n' '{"families":{},"accounts":[],"generated_at":"2026-08-31T20:00:00Z","cache":{"age_seconds":0,"ttl_seconds":120,"fresh":true}}'
            ;;
          route)
            printf '%s\\n' '{"schema_version":1,"kind":"subfleet.route-preview","ok":true,"allowed":true,"reason":"test route","selected":{"family":"codex","model":"gpt-test","lane":"test-lane"}}'
            ;;
          run)
            cat >/dev/null
            printf '%s\\n' '{"schema_version":1,"kind":"subfleet.run","ok":true,"status":"dispatched","detached":true,"run_id":"compose-test"}'
            ;;
          runs)
            printf '%s\\n' '{"runs":[]}'
            ;;
          *)
            exit 2
            ;;
        esac
        """
        try Data(script.utf8).write(to: fakeCLI, options: .atomic)
        try FileManager.default.setAttributes(
            [.posixPermissions: 0o700], ofItemAtPath: fakeCLI.path
        )
        UserDefaults.standard.set(fakeCLI.path, forKey: SubfleetCLI.overrideKey)
        defer { UserDefaults.standard.removeObject(forKey: SubfleetCLI.overrideKey) }

        let composeStore = CockpitStore()
        let composeAccepted = await composeStore.routeAndDispatch(
            task: "build",
            tier: "standard",
            workdir: root.path,
            prompt: "Build the fixture and verify it."
        )
        precondition(composeAccepted, "One Compose action must route and dispatch")
        let composeCalls = try String(contentsOf: cliLog, encoding: .utf8)
            .split(whereSeparator: \.isNewline).map(String.init)
        precondition(
            composeCalls == ["capacity", "route", "run", "runs"],
            "Compose must refresh, verify an exact route, and submit exactly once"
        )
        let beforeBlank = composeCalls.count
        let blankAccepted = await composeStore.routeAndDispatch(
            task: "build", tier: "standard", workdir: root.path, prompt: "  \n"
        )
        precondition(!blankAccepted)
        let afterBlank = try String(contentsOf: cliLog, encoding: .utf8)
            .split(whereSeparator: \.isNewline).count
        precondition(afterBlank == beforeBlank, "Whitespace must never launch a route or run")
        print("Broker client/store contract tests passed")
    }
}
