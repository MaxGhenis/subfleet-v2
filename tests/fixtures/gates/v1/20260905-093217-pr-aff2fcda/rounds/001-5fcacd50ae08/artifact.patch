diff --git a/scripts/report-pe-comparison-failure.ts b/scripts/report-pe-comparison-failure.ts
new file mode 100644
index 0000000..31a9757
--- /dev/null
+++ b/scripts/report-pe-comparison-failure.ts
@@ -0,0 +1,119 @@
+// One open monitor issue per failure category. Keep the latest run in an
+// owned body section, preserving any investigation notes outside that section.
+import { execFileSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { pathToFileURL } from "node:url";
+
+type FailureContext = {
+  compared: string;
+  archived: string;
+  failedStep: string;
+  runUrl: string;
+  report?: unknown;
+};
+
+export type FailureNotice = {
+  category: "drift" | "comparison-error" | "archive" | "downstream" | "setup";
+  title: string;
+  explanation: string;
+  runUrl: string;
+};
+
+export function comparisonFailure(context: FailureContext): FailureNotice {
+  const report = context.report as { rows?: Array<{ drift?: string }> } | undefined;
+  const drifted = Array.isArray(report?.rows)
+    ? report.rows.filter((row) => row?.drift === "diff").length
+    : 0;
+  const base = { runUrl: context.runUrl };
+  if (context.compared === "failure") {
+    return drifted > 0
+      ? {
+          ...base,
+          category: "drift",
+          title: "PE household comparison: pinned Axiom outputs drifted",
+          explanation: `The comparison ran and ${drifted} pinned expectation(s) did not hold.`
+        }
+      : {
+          ...base,
+          category: "comparison-error",
+          title: "PE household comparison: comparison could not conclude",
+          explanation: "The compare step failed without recorded drifted rows. This is a transport or harness failure; it does not establish whether the pinned expectations still hold."
+        };
+  }
+  if (context.compared === "success") {
+    return context.archived === "failure"
+      ? {
+          ...base,
+          category: "archive",
+          title: "PE household comparison: bundled snapshot archive failed",
+          explanation: "The comparison passed its pinned Axiom expectations, but committing the bundled dashboard snapshot failed. The archive failure does not indicate calculation drift; inspect the run's archive step."
+        }
+      : {
+          ...base,
+          category: "downstream",
+          title: "PE household comparison: downstream reporting failed",
+          explanation: "The comparison passed its pinned Axiom expectations, but a subsequent report or cleanup step failed. Inspect the failed steps in the run; calculation drift is not implicated."
+        };
+  }
+  return {
+    ...base,
+    category: "setup",
+    title: "PE household comparison: measurement could not start",
+    explanation: `The comparison did not run. Failure stage: ${context.failedStep}. Nothing is known about drift from this run.`
+  };
+}
+
+type Gh = (args: string[], input?: string) => string;
+const END_MARKER = "<!-- /axiom-pe-comparison-monitor -->";
+
+export function upsertComparisonFailure(notice: FailureNotice, repository: string, gh: Gh): number {
+  const marker = `<!-- axiom-pe-comparison-monitor:v1:${notice.category} -->`;
+  const section = `${marker}\n${notice.explanation}\n\nLatest run: ${notice.runUrl}\n${END_MARKER}`;
+  const pages = JSON.parse(gh([
+    "api", "--paginate", "--slurp",
+    `repos/${repository}/issues?state=open&labels=monitoring&per_page=100`
+  ])) as Array<Array<{ number: number; body: string | null; pull_request?: unknown }>>;
+  const existing = pages.flat().find((issue) => !issue.pull_request && issue.body?.includes(marker));
+  if (existing) {
+    const body = existing.body!;
+    const start = body.indexOf(marker);
+    const end = body.indexOf(END_MARKER, start);
+    // Refuse to overwrite an edited or damaged marker instead of swallowing
+    // investigation notes whose ownership is now ambiguous.
+    if (end < 0) throw new Error(`Monitor issue #${existing.number} has an incomplete owned section`);
+    const updated = body.slice(0, start) + section + body.slice(end + END_MARKER.length);
+    if (updated !== body) {
+      gh(["api", "--method", "PATCH", `repos/${repository}/issues/${existing.number}`, "--input", "-"],
+        JSON.stringify({ body: updated }));
+    }
+    return existing.number;
+  }
+  const created = JSON.parse(gh([
+    "api", "--method", "POST", `repos/${repository}/issues`, "--input", "-"
+  ], JSON.stringify({ title: notice.title, body: section, labels: ["monitoring"] }))) as { number: number };
+  return created.number;
+}
+
+function main(): void {
+  const repository = process.env.GH_REPO;
+  const runUrl = process.env.RUN_URL;
+  if (!repository || !runUrl) throw new Error("GH_REPO and RUN_URL are required");
+  let report: unknown;
+  try {
+    report = JSON.parse(readFileSync("pe-comparison-report.json", "utf8"));
+  } catch {
+    // Missing or malformed reports cannot support a claim of measured drift.
+  }
+  const notice = comparisonFailure({
+    compared: process.env.COMPARED ?? "",
+    archived: process.env.ARCHIVED ?? "",
+    failedStep: process.env.FAILED_STEP ?? "setup",
+    runUrl,
+    report
+  });
+  const number = upsertComparisonFailure(notice, repository, (args, input) =>
+    execFileSync("gh", args, { encoding: "utf8", ...(input === undefined ? {} : { input }) }));
+  console.log(`Monitor issue #${number}: ${notice.category}`);
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) main();
diff --git a/tests/pe-comparison-monitor.test.ts b/tests/pe-comparison-monitor.test.ts
new file mode 100644
index 0000000..aaf9111
--- /dev/null
+++ b/tests/pe-comparison-monitor.test.ts
@@ -0,0 +1,77 @@
+import { readFileSync } from "node:fs";
+import { load } from "js-yaml";
+import { describe, expect, it, vi } from "vitest";
+import { comparisonFailure, upsertComparisonFailure } from "../scripts/report-pe-comparison-failure.js";
+
+const runUrl = "https://github.com/TheAxiomFoundation/axiom-api/actions/runs/123";
+const context = { compared: "success", archived: "success", failedStep: "setup", runUrl };
+
+describe("PE comparison monitoring", () => {
+  it("distinguishes actual drift, incomplete measurements, archives and later reports", () => {
+    expect(comparisonFailure({ ...context, compared: "failure", report: { rows: [{ drift: "diff" }] } }))
+      .toMatchObject({ category: "drift", explanation: expect.stringContaining("1 pinned") });
+    for (const report of [undefined, null, {}, { rows: [] }, { rows: [null] }, { rows: "bad" }]) {
+      expect(comparisonFailure({ ...context, compared: "failure", report }).category)
+        .toBe("comparison-error");
+    }
+    expect(comparisonFailure({ ...context, archived: "failure" }).category).toBe("archive");
+    expect(comparisonFailure(context).category).toBe("downstream");
+    expect(comparisonFailure({ ...context, compared: "skipped" }).category).toBe("setup");
+  });
+
+  it("creates one marked issue, then updates it across pages without losing investigation notes", () => {
+    const notice = comparisonFailure({ ...context, archived: "failure" });
+    const createGh = vi.fn().mockReturnValueOnce("[[]]").mockReturnValueOnce('{"number":42}');
+    expect(upsertComparisonFailure(notice, "owner/repo", createGh)).toBe(42);
+    const created = JSON.parse(createGh.mock.calls[1]![1] as string) as { body: string; labels: string[] };
+    expect(created.labels).toEqual(["monitoring"]);
+    expect(created.body).toContain("axiom-pe-comparison-monitor:v1:archive");
+
+    const oldBody = `Investigation notes\n${created.body}\nKeep this conclusion`;
+    const updateGh = vi.fn().mockReturnValueOnce(JSON.stringify([
+      [{ number: 9, body: created.body, pull_request: {} }, { number: 10, body: "unrelated" }],
+      [{ number: 42, body: oldBody }]
+    ])).mockReturnValueOnce("{}");
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", updateGh)).toBe(42);
+    expect(updateGh.mock.calls[0]![0]).toContain("--paginate");
+    expect(updateGh.mock.calls[1]![0]).toContain("PATCH");
+    const updated = JSON.parse(updateGh.mock.calls[1]![1] as string).body as string;
+    expect(updated).toBe(`Investigation notes\n${created.body.replace(runUrl, `${runUrl}4`)}\nKeep this conclusion`);
+
+    const retryGh = vi.fn().mockReturnValue(JSON.stringify([[{ number: 42, body: updated }]]));
+    expect(upsertComparisonFailure({ ...notice, runUrl: `${runUrl}4` }, "owner/repo", retryGh)).toBe(42);
+    expect(retryGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps drift and archive failures in separate issues and refuses damaged owned sections", () => {
+    const archive = comparisonFailure({ ...context, archived: "failure" });
+    const otherCategory = "<!-- axiom-pe-comparison-monitor:v1:drift -->\nInvestigating";
+    const separateGh = vi.fn().mockReturnValueOnce(JSON.stringify([[{ number: 1, body: otherCategory }]]))
+      .mockReturnValueOnce('{"number":2}');
+    expect(upsertComparisonFailure(archive, "owner/repo", separateGh)).toBe(2);
+    expect(separateGh.mock.calls[1]![0]).toContain("POST");
+    const damagedGh = vi.fn().mockReturnValue(JSON.stringify([[{
+      number: 3, body: "<!-- axiom-pe-comparison-monitor:v1:archive -->\nInvestigation notes"
+    }]]));
+    expect(() => upsertComparisonFailure(archive, "owner/repo", damagedGh)).toThrow("incomplete owned section");
+    expect(damagedGh).toHaveBeenCalledTimes(1);
+  });
+
+  it("allows the intended archive write only after a successful main comparison and serializes updates", () => {
+    const workflow = load(readFileSync(".github/workflows/pe-household-comparison.yml", "utf8")) as {
+      concurrency: { group: string; "cancel-in-progress": boolean };
+      jobs: { compare: { permissions: Record<string, string>; steps: Array<{
+        id?: string; name?: string; if?: string; run?: string; env?: Record<string, string>;
+      }> } };
+    };
+    expect(workflow.concurrency).toEqual({ group: "pe-household-comparison", "cancel-in-progress": false });
+    expect(workflow.jobs.compare.permissions).toMatchObject({ contents: "write", issues: "write" });
+    const archive = workflow.jobs.compare.steps.find((step) => step.id === "archive")!;
+    expect(archive.if).toBe("steps.compare.outcome == 'success' && github.ref == 'refs/heads/main'");
+    expect(archive.run).toContain("git commit --only data/validation-runs/latest.json");
+    const alarm = workflow.jobs.compare.steps.find((step) => step.name === "Report drift failure")!;
+    expect(alarm.if).toBe("failure()");
+    expect(alarm.env?.ARCHIVED).toBe("${{ steps.archive.outcome }}");
+    expect(alarm.run).toBe("node scripts/report-pe-comparison-failure.ts");
+  });
+});
