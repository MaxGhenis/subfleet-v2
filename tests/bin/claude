#!/usr/bin/env python3
"""A fake `claude` for the tests (C-12.8).

It replays one fixture under `tests/fixtures/claude/<scenario>/`: the fixture's
`stdout` to stdout, its `stderr` to stderr, and its `rc` as the exit status. It
never reaches the network and never reads a credential.

Environment:

    SUBFLEET_FAKE_SCENARIO      the fixture directory name (required)
    SUBFLEET_FAKE_FIXTURES      fixture root (default: ../fixtures/claude beside this file)
    SUBFLEET_FAKE_DELAY_S       seconds to sleep before writing anything
    CLAUDE_FAKE_PROJECTS_DIR    when set, write the fixture's `transcript.jsonl`
                                to <dir>/<encoded cwd>/<--session-id>.jsonl, so
                                attestation and deliverable tests run offline
    SUBFLEET_FAKE_ENV_REPORT    when set, write a JSON report of which environment
                                variables were *present* (never their values) plus
                                argv and cwd, so an isolation test can prove no API
                                key reached the child (C-14.4)
    SUBFLEET_FAKE_STDIN_REPORT  when set, write the bytes read from stdin there, so
                                a test can prove which prompt was actually sent
    SUBFLEET_FAKE_PROFILE       which profile answer (C-10.6) a credential gets;
                                see tests/fake/profile.py. With `--print-profile`
                                this fake prints that answer for the token in
                                CLAUDE_CODE_OAUTH_TOKEN and exits with its status
                                class, so an operator can see by hand what a
                                scenario does. The adapter itself never shells
                                out for a profile: it calls the URL, and the
                                harnesses replace the opener behind it.
    SUBFLEET_FAKE_SETTINGS_REPORT
                                when set, write there the value of each name in
                                SUBFLEET_FAKE_SETTINGS_NAMES (comma-separated) as
                                the session would see it, then exit 0 having done
                                nothing else (D-WATCHDOG1). The settings are
                                layered as `settings_env` says: an assumption
                                about Claude Code, never evidence of it.

Unknown flags are accepted and ignored: the point is to replay a fixture for
whatever argv the adapter built, not to re-implement Claude Code. With
`--input-format stream-json` (a conversation turn) it hands over to
`tests/fake/interactive_claude.py` instead.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

# Kept in step with subfleet.adapters.claude.encode_project_dir; duplicated rather
# than imported so the fake stays a standalone executable on PATH.
ENCODED = ("/", ".", "_")

# Recorded by presence only. A value is never read, printed, or written.
WATCHED_ENV = (
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "CODEX_API_KEY",
    "OPENAI_API_KEY",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "CLAUDE_CONFIG_DIR",
    "SUBFLEET_ATTEMPT",
    "SUBFLEET_JOB",
)


def encode_project_dir(workdir: str) -> str:
    text = str(workdir)
    for char in ENCODED:
        text = text.replace(char, "-")
    return text


def flag_value(argv: list[str], name: str) -> str | None:
    for index, item in enumerate(argv):
        if item == name and index + 1 < len(argv):
            return argv[index + 1]
        if item.startswith(f"{name}="):
            return item.split("=", 1)[1]
    return None


def fixtures_root() -> Path:
    override = os.environ.get("SUBFLEET_FAKE_FIXTURES")
    if override:
        return Path(override)
    return Path(__file__).resolve().parent.parent / "fixtures" / "claude"


def read_bytes(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError:
        return b""


def print_profile(argv: list[str]) -> int:
    """Serve one profile answer on stdout, the way the endpoint would."""
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
    from tests.fake.profile import response_for

    token = flag_value(argv, "--token") or os.environ.get("CLAUDE_CODE_OAUTH_TOKEN", "")
    try:
        status, body = response_for(token, os.environ.get("SUBFLEET_FAKE_PROFILE"))
    except OSError as error:
        sys.stderr.write(f"fake claude: profile unavailable: {error}\n")
        return 1
    sys.stdout.buffer.write(body)
    sys.stdout.flush()
    return 0 if status == 200 else 2


def _settings_file(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def settings_env(argv: list[str]) -> tuple[dict[str, str], dict]:
    """The `env` a session would apply over its process environment, and how it got it.

    The layering is the one this repository records, not one any Claude run here
    has shown: the user's file (`$CLAUDE_CONFIG_DIR/settings.json`, else
    `$HOME/.claude/settings.json`), then the project's and the local file under
    the cwd, each only when `--setting-sources` names it (all three without the
    flag), and last every `--settings` in argv order, a JSON object or a path to
    one, which load whatever `--setting-sources` names (`claude-help.txt`'s
    `--restricted` entry: "--settings still apply"). That command-line settings
    outrank the files is C-26.11's premise for project and local settings and,
    for user settings, the 2026-10-22 live probe the hub reported (D-WATCHDOG1).
    `--safe-mode` is not modelled: its help names no settings source.
    """
    sources_flag = flag_value(argv, "--setting-sources")
    sources = ({"user", "project", "local"} if sources_flag is None
               else {part.strip() for part in sources_flag.split(",") if part.strip()})
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    files = {"user": Path(config) / "settings.json" if config else Path.home() / ".claude" / "settings.json",
             "project": Path.cwd() / ".claude" / "settings.json",
             "local": Path.cwd() / ".claude" / "settings.local.json"}
    layers, loaded = [], []
    for source in ("user", "project", "local"):
        if source in sources:
            layers.append(_settings_file(files[source]))
            loaded.append(source)
    flags = []
    for index, item in enumerate(argv):
        if item == "--settings" and index + 1 < len(argv):
            flags.append(argv[index + 1])
        elif item.startswith("--settings="):
            flags.append(item.split("=", 1)[1])
    for value in flags:
        try:
            parsed = json.loads(value) if value.lstrip().startswith("{") else _settings_file(Path(value))
        except ValueError:
            parsed = {}
        layers.append(parsed if isinstance(parsed, dict) else {})
    env: dict[str, str] = {}
    for layer in layers:
        if isinstance(layer.get("env"), dict):
            env.update({str(k): str(v) for k, v in layer["env"].items()})
    return env, {"sources": loaded, "settings_flags": len(flags)}


def settings_report(argv: list[str], path: str) -> int:
    env, how = settings_env(argv)
    names = [name for name in os.environ.get("SUBFLEET_FAKE_SETTINGS_NAMES", "").split(",") if name]
    seen = {name: env.get(name, os.environ.get(name)) for name in names}
    Path(path).write_text(json.dumps({"seen": seen, **how, "argv": argv}, indent=1), encoding="utf-8")
    return 0


def main(argv: list[str]) -> int:
    if "--print-profile" in argv:
        return print_profile(argv)
    if os.environ.get("SUBFLEET_FAKE_SETTINGS_REPORT"):
        return settings_report(argv, os.environ["SUBFLEET_FAKE_SETTINGS_REPORT"])
    if flag_value(argv, "--input-format") == "stream-json":
        # A conversation turn (C-26): the interactive fake in tests/fake.
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
        from tests.fake.interactive_claude import main as interactive
        return interactive(argv)
    scenario = os.environ.get("SUBFLEET_FAKE_SCENARIO")
    if os.environ.get("SUBFLEET_PROBE"):
        # C-11.4: a probe is a tiny read-only turn; answer it at once regardless of the scenario.
        scenario = "success-allowed"
        os.environ["SUBFLEET_FAKE_DELAY_S"] = "0"
    if not scenario:
        sys.stderr.write("fake claude: SUBFLEET_FAKE_SCENARIO is not set\n")
        return 2
    case = fixtures_root() / scenario
    if not case.is_dir():
        sys.stderr.write(f"fake claude: no fixture {scenario} under {fixtures_root()}\n")
        return 2

    report_path = os.environ.get("SUBFLEET_FAKE_ENV_REPORT")
    if report_path:
        Path(report_path).write_text(
            json.dumps(
                {
                    "argv": argv,
                    "cwd": os.getcwd(),
                    # Presence, never values.
                    "env_present": {
                        name: (name in os.environ) for name in WATCHED_ENV
                    },
                    "env_keys": sorted(os.environ),
                },
                indent=1,
            ),
            encoding="utf-8",
        )

    stdin_report = os.environ.get("SUBFLEET_FAKE_STDIN_REPORT")
    if stdin_report:
        try:
            data = sys.stdin.buffer.read()
        except (OSError, ValueError):
            data = b""
        Path(stdin_report).write_bytes(data)

    delay = os.environ.get("SUBFLEET_FAKE_DELAY_S")
    if delay:
        try:
            time.sleep(float(delay))
        except ValueError:
            pass

    session_id = flag_value(argv, "--session-id") or flag_value(argv, "--resume")
    projects = os.environ.get("CLAUDE_FAKE_PROJECTS_DIR")
    transcript_src = case / "transcript.jsonl"
    if projects and session_id and transcript_src.is_file():
        target_dir = Path(projects) / encode_project_dir(os.getcwd())
        target_dir.mkdir(parents=True, exist_ok=True)
        rows = []
        for line in transcript_src.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                row["sessionId"] = session_id
                row["cwd"] = os.getcwd()
            rows.append(row)
        with (target_dir / f"{session_id}.jsonl").open("a", encoding="utf-8") as handle:
            for row in rows:
                handle.write(json.dumps(row, separators=(",", ":")) + "\n")

    stdout = read_bytes(case / "stdout")
    if session_id:
        # The fixture's own session id is replaced so a caller-chosen --session-id
        # threads through the stream the way the real CLI's would.
        fixture_sid = None
        for line in stdout.decode("utf-8", "replace").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and isinstance(row.get("session_id"), str):
                fixture_sid = row["session_id"]
                break
        if fixture_sid:
            stdout = stdout.replace(fixture_sid.encode(), session_id.encode())

    sys.stdout.buffer.write(stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(read_bytes(case / "stderr"))
    sys.stderr.buffer.flush()

    try:
        return int((case / "rc").read_text(encoding="utf-8").strip() or 0)
    except (OSError, ValueError):
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
