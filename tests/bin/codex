#!/usr/bin/env python3
"""Replay redacted Codex fixtures without a provider connection (C-12.8)."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys
import time


ENV_KEYS = (
    "CODEX_HOME", "SUBFLEET_JOB", "SUBFLEET_ATTEMPT",
    "CODEX_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY",
)


def output_path(argv: list[str]) -> Path | None:
    for index, arg in enumerate(argv):
        if arg in ("--output-last-message", "-o") and index + 1 < len(argv):
            return Path(argv[index + 1])
        if arg.startswith("--output-last-message="):
            return Path(arg.split("=", 1)[1])
    return None


def last_message(fixture: Path, stdout: bytes) -> bytes | None:
    saved = fixture / "last.md"
    if saved.is_file():
        return saved.read_bytes()
    last = None
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except (ValueError, UnicodeError):
            continue
        if not isinstance(event, dict):
            continue
        item = event.get("item")
        if (
            event.get("type") == "item.completed"
            and isinstance(item, dict)
            and item.get("type") == "agent_message"
            and isinstance(item.get("text"), str)
        ):
            last = item["text"].encode()
    return last


def nested_grandchild() -> int:
    # The intermediate process makes the detached sleeper a grandchild of
    # the fake provider. It inherits SUBFLEET_ATTEMPT for containment scans.
    helper = (
        "import subprocess,sys; "
        "p=subprocess.Popen([sys.executable,'-c','import time; time.sleep(30)'],"
        "start_new_session=True,stdin=subprocess.DEVNULL,"
        "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); print(p.pid)"
    )
    result = subprocess.run(
        [sys.executable, "-c", helper],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, check=True,
    )
    return int(result.stdout)


def main() -> int:
    scenario = os.environ.get("SUBFLEET_FAKE_SCENARIO", "success")
    fixture_name = "success" if scenario == "nested-setsid" else scenario
    fixture_root = Path(__file__).resolve().parents[1] / "fixtures" / "codex"
    fixture = fixture_root / fixture_name
    if Path(fixture_name).name != fixture_name or not fixture.is_dir():
        print(f"Unknown fake Codex scenario: {scenario}", file=sys.stderr)
        return 2

    stdin = sys.stdin.buffer.read()
    diagnostics = {
        "argv": sys.argv[1:],
        "cwd": os.getcwd(),
        "stdin": stdin.decode("utf-8", "replace"),
        "env": {key: os.environ.get(key) for key in ENV_KEYS},
    }
    if scenario == "nested-setsid":
        diagnostics["nested_grandchild_pid"] = nested_grandchild()
    diagnostics_path = os.environ.get("SUBFLEET_FAKE_DIAGNOSTICS_PATH")
    if diagnostics_path:
        Path(diagnostics_path).write_text(json.dumps(diagnostics) + "\n")

    delay = max(0.0, float(os.environ.get("SUBFLEET_FAKE_DELAY_S", "0")))
    if scenario == "nested-setsid":
        delay = max(delay, 30.0)
    if delay:
        time.sleep(delay)

    stdout = (fixture / "stdout").read_bytes()
    stderr = (fixture / "stderr").read_bytes()
    destination = output_path(sys.argv[1:])
    final = last_message(fixture, stdout)
    if destination is not None and final is not None:
        destination.write_bytes(final)
    sys.stdout.buffer.write(stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(stderr)
    sys.stderr.buffer.flush()
    return int((fixture / "rc").read_text().strip())


if __name__ == "__main__":
    raise SystemExit(main())
