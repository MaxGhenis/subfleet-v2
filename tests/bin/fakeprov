#!/usr/bin/env python3
"""Deterministic provider process and escaped descendant fixture (C-12.8)."""

from __future__ import annotations

import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


# C-5.5 fixtures whose escaped writer is a CS_RESTRICT platform binary. The
# odd sleep length lets fixture cleanup recognise the writer it started.
PLATFORM_ESCAPES = {"nested-setsid-platform", "platform-escape-exit", "platform-escape-on-term",
                    "platform-handoff-exit"}
ESCAPE_SLEEP = "31.4159"
# The writer's parent: it leaves the provider's group before the writer exists,
# so no census can catch the writer itself in that group between its fork and
# its setsid (which would make it a group member a kill may signal, C-5.6). It
# stays, keeping the writer attributable through the walk, until the test
# creates <marker>.orphan, then exits and leaves the writer with ppid 1.
INTERMEDIATE = """
import os, subprocess, sys, time
from pathlib import Path
marker = os.environ["SUBFLEET_FAKE_MARKER"]
Path(marker + ".intermediate").write_text(str(os.getpid()))
subprocess.Popen(["/bin/sh", "-c", 'printf %s "$$" > "' + marker + '"; exec /bin/sleep ' + sys.argv[1]],
                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
deadline = time.monotonic() + 30
while not Path(marker + ".orphan").exists() and time.monotonic() < deadline:
    time.sleep(.02)
"""


def main() -> int:
    if "--escaped-child" in sys.argv:
        marker = os.environ.get("SUBFLEET_FAKE_MARKER")
        if marker:
            Path(marker).write_text(str(os.getpid()), encoding="ascii")
        time.sleep(30)
        return 0

    scenario = os.environ.get("SUBFLEET_FAKE_SCENARIO", "ok")
    if os.environ.get("SUBFLEET_PROBE"):
        scenario = "ok"  # C-11.4: probes answer at once
        os.environ["SUBFLEET_FAKE_DELAY_S"] = "0"
    delay = float(os.environ.get("SUBFLEET_FAKE_DELAY_S", "0"))
    # Reading stdin also exercises guardian prompt redirection.
    prompt = sys.stdin.read()
    if scenario == "ignore-sigterm":
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    if scenario == "nested-setsid":
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "--escaped-child"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
        )
    def platform_writer(*_):
        # C-5.5: the escaped writer is an Apple binary. /bin/sh and /bin/sleep
        # run with CS_RESTRICT, so ps -E shows neither one's environment and the
        # marker never matches it; once its parent has exited it is in no
        # recorded group and under no walk root either. The sh execs the
        # sleep, so the pid it records is the writer's.
        subprocess.Popen(
            [sys.executable, "-c", INTERMEDIATE, ESCAPE_SLEEP], start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if scenario == "platform-escape-on-term":
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
    if scenario in {"nested-setsid-platform", "platform-escape-exit"}:
        platform_writer()
    elif scenario == "platform-escape-on-term":
        # Like a tool shell that keeps working through the kill's grace: the
        # writer starts only once the attempt's group has been sent SIGTERM.
        signal.signal(signal.SIGTERM, platform_writer)
    elif scenario == "platform-handoff-exit":
        # A setsid'd shell that, once told (after this provider has exited),
        # starts a background writer and exits at once: the writer stays in the
        # shell's process group, and no census need ever see it with a parent.
        subprocess.Popen(
            ["/bin/sh", "-c",
             'printf %s "$$" > "$SUBFLEET_FAKE_MARKER.shell"; i=0; '
             'while [ ! -e "$SUBFLEET_FAKE_MARKER.go" ] && [ "$i" -lt 600 ]; do /bin/sleep 0.05; i=$((i+1)); done; '
             f'/bin/sleep {ESCAPE_SLEEP} & printf %s "$!" > "$SUBFLEET_FAKE_MARKER"; exit 0'],
            start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    print(f"fake provider ready: {scenario}", flush=True)
    if scenario in {"ignore-sigterm", "nested-setsid", "nested-setsid-platform", "platform-escape-on-term"}:
        time.sleep(delay or 30)
    elif scenario in {"platform-escape-exit", "platform-handoff-exit"}:
        # Exit only when the test says so: after the daemon has seen the writer.
        release = Path(os.environ["SUBFLEET_FAKE_MARKER"] + ".release")
        deadline = time.monotonic() + 30
        while not release.exists() and time.monotonic() < deadline:
            time.sleep(.02)
    elif scenario == "slow":
        time.sleep(delay or 1)
    elif delay:
        time.sleep(delay)

    if scenario == "rc4-limit-with-clock":
        print(json.dumps({"event": "rate_limit", "scope": "account",
                          "resets_at": int(time.time()) + 3600}), file=sys.stderr, flush=True)
        return 4
    if scenario == "rc1-crash-after-output":
        print("partial result before provider crash", flush=True)
        return 1
    if scenario == "spawn-fail":
        # The adapter maps this scenario to a missing executable before launch.
        raise RuntimeError("spawn-fail must be selected by FakeAdapter")
    print("fake deliverable: " + prompt.strip(), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
