#!/usr/bin/env python3
"""Deterministic provider process and escaped descendant fixture (C-12.8)."""

from __future__ import annotations

import ctypes
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def priorities(pid: int) -> list[int]:
    """pid's threads' scheduling priorities (`ps -M`'s PRI column; no environment is read)."""
    rows = subprocess.run(["/bin/ps", "-M", "-p", str(pid)], capture_output=True, text=True).stdout.splitlines()
    if not rows:
        return []
    column = rows[0].split().index("PRI")
    found = []
    for n, row in enumerate(rows[1:]):
        fields = row.split()
        index = column if n == 0 else column - 2     # a thread's row starts at its PID
        if index < len(fields):
            found.append(int(fields[index].rstrip("TRSUIZ")))
    return found


def qos_report() -> dict:
    """C-5.1: the priorities this provider, a child it starts and its guardian run at, and
    whether it can raise its own thread above the QoS it was started under."""
    child = subprocess.Popen(["/bin/sleep", "3"], stdin=subprocess.DEVNULL)
    time.sleep(0.2)
    report = {"provider": priorities(os.getpid()), "child": priorities(child.pid),
              "guardian": priorities(os.getppid()), "pid": os.getpid(), "pgid": os.getpgrp(),
              "ppid": os.getppid(), "attempt": os.environ.get("SUBFLEET_ATTEMPT")}
    libc = ctypes.CDLL(None)
    libc.pthread_set_qos_class_self_np.argtypes = [ctypes.c_uint, ctypes.c_int]
    report["raise_rc"] = libc.pthread_set_qos_class_self_np(0x19, 0)       # QOS_CLASS_USER_INITIATED
    report["after_raise"] = priorities(os.getpid())
    child.kill()
    child.wait()
    return report


#: D-CEN1 (incident 2026-10-13): processes no census source saw. Each is
#: born outside the attempt's group (its parent called setsid and exits at
#: once), so its ppid is 1, and each then hides from `ps -E`: node's
#: `process.title` and the stand-in fill the argv area with the title and
#: NULs, which ends `ps`'s environment list; perl, a platform binary, shows
#: `ps` no environment at all, and `$0` renames it. The pid is published
#: (by rename) only after the title is set, and each exits within a minute
#: whatever happens to the test that started it.
ESCAPE_S = 60
NODE_ESCAPER = ("const fs = require('fs'); process.title = 'node (vitest)';"
                "const marker = process.env.SUBFLEET_FAKE_MARKER;"
                "fs.writeFileSync(marker + '.tmp', String(process.pid)); fs.renameSync(marker + '.tmp', marker);"
                f"setTimeout(() => {{}}, {ESCAPE_S * 1000});")
NUL_ESCAPER = f"""
import ctypes, os, time
libc = ctypes.CDLL(None)
libc._NSGetArgv.restype = ctypes.POINTER(ctypes.POINTER(ctypes.c_void_p))
libc._NSGetArgc.restype = ctypes.POINTER(ctypes.c_int)
argc, argv = libc._NSGetArgc().contents.value, libc._NSGetArgv().contents
start, last = argv[0], argv[argc - 1]
end = last + len(ctypes.string_at(last)) + 1
title = b"node (vitest 1)"
ctypes.memset(start, 0, end - start)
ctypes.memmove(start, title, min(len(title), end - start - 1))
marker = os.environ["SUBFLEET_FAKE_MARKER"]
with open(marker + ".tmp", "w") as stream:
    stream.write(str(os.getpid()))
os.rename(marker + ".tmp", marker)
time.sleep({ESCAPE_S})
"""
PERL_ESCAPER = ('$0 = "renamed-escaper"; my $marker = $ENV{SUBFLEET_FAKE_MARKER};'
                'open(my $out, ">", "$marker.tmp") or die; print $out $$; close($out);'
                f'rename("$marker.tmp", $marker) or die; sleep {ESCAPE_S};')
ESCAPERS = {"retitled-node": "node", "retitled-nul": "nul", "perl-escape": "perl",
            "lockf-escape": "lockf"}
#: D-KILL2 (incidents 2026-10-16 and 2026-10-18): a provider's command ran
#: `/usr/bin/lockf -k <suite lock> ...` as the leader of a session of its own,
#: and the lockf outlived the cancelled attempt waiting for its lock, ppid 1
#: once the provider was gone. lockf is an Apple platform binary that runs with
#: the hardened runtime, and on macOS 26 the argument buffer of such a process
#: holds its argv and no environment (observed 2026-10-18), so the markers it
#: inherits show neither in `ps -E` nor in the raw buffer. This escaper is
#: that lockf, markers inherited unchanged. Its lock is `<marker>.lock`, which
#: the test holds (never the suite lock), and it waits at most LOCKF_WAIT_S.
LOCKF_WAIT_S = 120


def lockf_escaper() -> int:
    """Publish this pid, then become lockf in place: the session leader that the
    provider's Popen made, as the incident's lockf led its own session."""
    marker = os.environ["SUBFLEET_FAKE_MARKER"]
    with open(marker + ".tmp", "w") as stream:
        stream.write(str(os.getpid()))
    os.rename(marker + ".tmp", marker)
    os.execv("/usr/bin/lockf", ["/usr/bin/lockf", "-k", "-t", str(LOCKF_WAIT_S), marker + ".lock",
                                "/bin/sleep", str(ESCAPE_S)])
    return 1


def escaper(kind: str) -> int:
    """The escaper's parent: started in a new session, it forks and exits.
    `lockf` is the exception: it stays the session's leader (`lockf_escaper`)."""
    if kind == "lockf":
        return lockf_escaper()
    if os.fork():
        return 0
    if kind == "node":
        node = os.environ["SUBFLEET_FAKE_NODE"]
        os.execv(node, [node, "-e", NODE_ESCAPER])
    if kind == "nul":
        os.execv(sys.executable, [sys.executable, "-c", NUL_ESCAPER])
    # macOS versions differ in how much of a platform binary's argument area
    # remains readable after $0 changes. Erase the markers explicitly so this
    # fixture proves responsibility discovery on either kernel.
    env = {k: v for k, v in os.environ.items()
           if k not in {"SUBFLEET_ATTEMPT", "SUBFLEET_ROOT", "SUBFLEET_JOB"}}
    os.execve("/usr/bin/perl", ["/usr/bin/perl", "-e", PERL_ESCAPER], env)
    return 1


def main() -> int:
    if "--escaper" in sys.argv:
        if "--new-session" in sys.argv:
            os.setsid()
        return escaper(sys.argv[sys.argv.index("--escaper") + 1])
    if "--escaped-child" in sys.argv:
        # Popen gave this process its own session, but it belonged to the
        # attempt's group between fork() and setsid(), and a census landing
        # there rightly records it as owned; the kill path then signals it and
        # nothing escapes (a quarter of runs on a busy machine). Its child is
        # born outside the group, so no census could ever have owned it: the
        # escape the test means, marker environment and all.
        if os.fork():
            return 0
        marker = os.environ.get("SUBFLEET_FAKE_MARKER")
        if marker:
            Path(marker).write_text(str(os.getpid()), encoding="ascii")
        time.sleep(30)
        return 0

    scenario = os.environ.get("SUBFLEET_FAKE_SCENARIO", "ok")
    if os.environ.get("SUBFLEET_PROBE"):
        scenario = "ok"  # C-11.4: probes answer at once
        os.environ["SUBFLEET_FAKE_DELAY_S"] = "0"
    delay = float(os.environ.get("SUBFLEET_FAKE_DELAY_S", "0"))
    # Reading stdin also exercises guardian prompt redirection.
    prompt = sys.stdin.read()
    if scenario == "ignore-sigterm":
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    if scenario == "nested-setsid":
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "--escaped-child"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
        )
    if scenario in ESCAPERS:
        # The provider ends as soon as its escaper is ready, so the exit receipt
        # is written with the escaper still running in the attempt's workspace.
        marker = Path(os.environ["SUBFLEET_FAKE_MARKER"])
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--escaper", ESCAPERS[scenario]],
                         start_new_session=True, stdin=subprocess.DEVNULL)
        until = time.monotonic() + 30
        while not marker.exists() and time.monotonic() < until:
            time.sleep(.02)
        print(f"fake provider ready: {scenario}", flush=True)
        if delay:
            time.sleep(delay)              # still running, for a test that kills the attempt
        return 0 if marker.exists() else 1
    if scenario == "qos":
        print(json.dumps(qos_report()), flush=True)
        completed()
        return 0
    if scenario == "ca-environment":
        keys = ("SSL_CERT_FILE", "SSL_CERT_DIR")
        child = subprocess.run(
            [sys.executable, "-c", "import json, os; print(json.dumps({k: os.environ[k] "
             "for k in ('SSL_CERT_FILE', 'SSL_CERT_DIR') if k in os.environ}))"],
            text=True, capture_output=True, check=True)
        print(json.dumps({"provider": {k: os.environ[k] for k in keys if k in os.environ},
                          "tool": json.loads(child.stdout)}), flush=True)
        completed()
        return 0
    print(f"fake provider ready: {scenario}", flush=True)
    if scenario in {"ignore-sigterm", "nested-setsid"}:
        time.sleep(delay or 30)
    elif scenario == "slow":
        time.sleep(delay or 1)
    elif delay:
        time.sleep(delay)

    if scenario == "rc4-limit-with-clock":
        print(json.dumps({"event": "rate_limit", "scope": "account",
                          "resets_at": int(time.time()) + 3600}), file=sys.stderr, flush=True)
        return 4
    if scenario == "rc3-content-filter":
        print("This content was flagged for possible cybersecurity risk.", file=sys.stderr, flush=True)
        return 3
    if scenario == "rc1-crash-after-output":
        print("partial result before provider crash", flush=True)
        return 1
    if scenario == "spawn-fail":
        # The adapter maps this scenario to a missing executable before launch.
        raise RuntimeError("spawn-fail must be selected by FakeAdapter")
    print("fake deliverable: " + prompt.strip(), flush=True)
    completed()
    return 0


def completed() -> None:
    """The generic fake's success also satisfies the Codex acceptance rule."""
    if stream := os.environ.get("SUBFLEET_FAKE_STREAM"):
        Path(stream).write_text('{"type":"turn.completed"}\n')


if __name__ == "__main__":
    raise SystemExit(main())
